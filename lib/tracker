#!/usr/bin/env bash
# tracker — the tracker adapter on the command line (design section 7), for the workflow skills.
#
#   mroom tracker get <id>                  the issue: title, state, labels, branch, whether it is assigned to
#                                           the token's user, description, every comment
#   mroom tracker list [--mine] [--open] [--label <name>] [--limit 50]
#                                           issues in issues.team: assigned to the token's user, not done or
#                                           canceled, with a label; needs --mine or --label; the --limit most
#                                           recently updated, then by priority
#   mroom tracker find <alert key>          the issues whose description holds the persona's marker for an
#                                           alert key, such as sentry:1001; every state,
#                                           archived too, the oldest first
#   mroom tracker comment <id> < body       adds the comment on stdin
#   mroom tracker state <id> <state name>   moves the issue to the team's state of that name (any case)
#   mroom tracker create --allow-create --title <title> [--state <name>] [--priority 0-4]
#                        [--label <name>]... < body
#                                           files a new issue in issues.team; refuses without --allow-create
#   mroom tracker backend                   the tracker mroom.toml names: linear or none
#
# The tracker is issues.tracker in mroom.toml (linear | none), and its token the environment variable
# issues.token_env names (LINEAR_API_KEY by default). Answers are JSON on stdout. Exit 0 done, 1 the tracker
# or the config failed, 2 a usage error, 3 there is no tracker (issues.tracker = "none").
set -euo pipefail
# Tokens pass through this command: no trace, even under bash -x or SHELLOPTS=xtrace.
set +x
umask 077

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=lib/core/api.sh
. "$MROOM_ROOT/lib/core/api.sh"
# shellcheck source=lib/core/tracker.sh
. "$MROOM_ROOT/lib/core/tracker.sh"

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; }

for tool in curl jq python3; do
  command -v "$tool" >/dev/null 2>&1 || { echo "mroom tracker: needs $tool, which this host does not have" >&2; exit 1; }
done

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift
# The private folder is made here, outside every $(...), so the EXIT trap removes it.
trap api_cleanup EXIT
api_tmp
rc=0
case "$cmd" in
  get) issue_get "$@" || rc=$? ;;
  list) issue_list "$@" || rc=$? ;;
  find) issue_find_by_marker "$@" || rc=$? ;;
  comment) issue_comment "$@" || rc=$? ;;
  state) issue_set_state "$@" || rc=$? ;;
  create) issue_create "$@" || rc=$? ;;
  backend) [ "$#" = 0 ] || { echo "mroom tracker: backend takes no arguments" >&2; exit 2; }; tracker_backend || rc=$? ;;
  help | -h | --help) usage ;;
  *) echo "mroom tracker: unknown command '$cmd' (get, list, find, comment, state, create, backend)" >&2; rc=2 ;;
esac
exit "$rc"
