#!/usr/bin/env bash
# baseline — sets up the QA services a box runs beside Forge's own (design 3, 8.9). Phase 2a's first part:
#
#   mroom baseline mailpit   the QA mail catcher (D19): Mailpit at the build lib/core/pins.txt names, checked
#                            against its SHA-256, mroom's mail relay, their folders and logins, and the
#                            script that installs, as root, the three systemd units that run them
#
# It runs as the box user and changes nothing outside the box user's home. It can run again: a binary that
# matches its pin and logins that exist are kept. Services live in ~/.local/share/mroom-services, which an
# uninstall of mroom leaves alone, and their logins in ~/.config/mroom/secrets, files mode 600 and folders
# 700, where no site user can read them. Installing the systemd units takes root (D20), so a person runs the
# script this prints, in which each unit's text stands: root never reads a file the box user can write.
set -euo pipefail
shopt -s inherit_errexit
umask 077

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=lib/core/util.sh
. "$MROOM_ROOT/lib/core/util.sh"

PINS="${MROOM_PINS:-$MROOM_ROOT/lib/core/pins.txt}"
SERVICES="$HOME/.local/share/mroom-services"
SECRETS="$HOME/.config/mroom/secrets"
WORK="" SECRET_TMP="" CHANGED=""
trap '[ -z "$WORK" ] || rm -rf "$WORK"; [ -z "$SECRET_TMP" ] || rm -f "$SECRET_TMP"' EXIT

die() { echo "mroom baseline: $*" >&2; exit 1; }

platform() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo linux-amd64 ;;
    Linux-aarch64 | Linux-arm64) echo linux-arm64 ;;
    *) die "no service builds are pinned for $(uname -s) $(uname -m)" ;;
  esac
}

# new_password: 48 hex characters from the kernel's random source.
new_password() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }

# crypt: the SHA-512 crypt hash of stdin, a format Mailpit reads in its login files. Fails unless openssl
# gave one: an empty hash would be a login with no password.
crypt() {
  local hash
  hash="$(openssl passwd -6 -stdin)" || return 1
  [[ "$hash" =~ ^\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$ ]] || return 1
  printf '%s\n' "$hash"
}

# hash_of <password> <hash>: whether the SHA-512 crypt hash is of the password.
hash_of() {
  [[ "$2" =~ ^\$6\$([A-Za-z0-9./]+)\$[A-Za-z0-9./]+$ ]] || return 1
  [ "$(printf '%s' "$1" | openssl passwd -6 -salt "${BASH_REMATCH[1]}" -stdin)" = "$2" ]
}

# put_secret <file> <content>: the file holding the content, mode 600, replaced in one step.
put_secret() {
  SECRET_TMP="$(mktemp "$SECRETS/.baseline.XXXXXX")"
  printf '%s\n' "$2" >"$SECRET_TMP"
  mv -f "$SECRET_TMP" "$1"
  SECRET_TMP=""
}

# install_pinned <name>: the pinned build of <name> for this platform in $SERVICES/<name>/<version>, and
# $SERVICES/<name>/current pointing at it. The archive and the binary must both match their SHA-256 pins,
# or nothing is installed. Sets CHANGED when it installed a build.
install_pinned() {
  local name="$1" platform line version archive_sha binary_sha url dir got
  platform="$(platform)"
  line="$(awk -v n="$name" -v p="$platform" '$1 == n && $3 == p { print $2, $4, $5, $6; exit }' "$PINS")"
  read -r version archive_sha binary_sha url <<<"$line"
  [ -n "${url:-}" ] || die "$(home_short "$PINS") pins no $name build for $platform"
  [[ "$version" =~ ^v[0-9]+(\.[0-9]+)*$ && "$archive_sha" =~ ^[0-9a-f]{64}$ && "$binary_sha" =~ ^[0-9a-f]{64}$ ]] \
    || die "the $name pin in $(home_short "$PINS") is malformed"
  [[ "$url" =~ ^https://[A-Za-z0-9._/-]+$ ]] || die "the $name pin's URL is not a plain https URL"
  dir="$SERVICES/$name/$version"
  if [ -f "$dir/$name" ] && [ "$(sha256sum "$dir/$name" | cut -d' ' -f1)" = "$binary_sha" ]; then
    echo "$name $version: installed, and matches its pin"
  else
    CHANGED=1
    WORK="$(mktemp -d)"
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --max-time 300 \
      --max-filesize 200000000 --output "$WORK/archive" "$url" || die "could not download $url"
    got="$(sha256sum "$WORK/archive" | cut -d' ' -f1)"
    [ "$got" = "$archive_sha" ] || die "$name $version: the download's SHA-256 is $got, not the pinned $archive_sha; nothing installed"
    mkdir "$WORK/unpacked"
    tar -xzf "$WORK/archive" -C "$WORK/unpacked" || die "$name $version: the archive does not unpack"
    if [ ! -f "$WORK/unpacked/$name" ] || [ -L "$WORK/unpacked/$name" ]; then
      die "$name $version: the archive holds no $name binary"
    fi
    got="$(sha256sum "$WORK/unpacked/$name" | cut -d' ' -f1)"
    [ "$got" = "$binary_sha" ] || die "$name $version: the binary's SHA-256 is $got, not the pinned $binary_sha; nothing installed"
    mkdir -p "$dir"
    install -m 700 "$WORK/unpacked/$name" "$dir/.$name.new"
    mv -f "$dir/.$name.new" "$dir/$name"
    echo "$name $version: installed, SHA-256 $binary_sha"
  fi
  chmod 700 "$SERVICES" "$SERVICES/$name" "$dir"
  ln -sfn "$version" "$SERVICES/$name/current"
}

# install_relay: mroom's mail relay beside the services, so it keeps running however mroom is updated or
# removed. Sets CHANGED when it installed or replaced it.
install_relay() {
  local dir="$SERVICES/mail-relay" had=""
  mkdir -p "$dir"
  chmod 700 "$SERVICES" "$dir"
  if [ -f "$dir/mail-relay" ]; then
    if cmp -s "$MROOM_ROOT/lib/mail-relay" "$dir/mail-relay"; then
      echo "mail relay: installed, and matches this mroom"
      return 0
    fi
    had=1
  fi
  CHANGED=1
  install -m 700 "$MROOM_ROOT/lib/mail-relay" "$dir/.mail-relay.new"
  mv -f "$dir/.mail-relay.new" "$dir/mail-relay"
  if [ -n "$had" ]; then echo "mail relay: updated"; else echo "mail relay: installed"; fi
}

# port_status <port>: who listens on 127.0.0.1:<port>: "systemd" (mroom-mail-relay.socket, active), "none",
# or "user <uid>" for anything else.
port_status() {
  local port listener show
  port="$(printf '%04X' "$1")"
  listener="$(awk -v at="0100007F:$port" -v any="00000000:$port" '$4 == "0A" && ($2 == at || $2 == any) { print $8; exit }' \
    /proc/net/tcp 2>/dev/null)" || true
  if [ -z "$listener" ]; then echo none; return 0; fi
  if [ "$listener" = 0 ]; then
    show="$(systemctl show --property=ActiveState,SubState,Listen mroom-mail-relay.socket 2>/dev/null)" || true
    if [[ "$show" =~ (^|$'\n')ActiveState=active($'\n'|$) && "$show" =~ (^|$'\n')SubState=(listening|running)($'\n'|$) \
      && "$show" == *"127.0.0.1:$1 (Stream)"* ]]; then
      echo systemd
      return 0
    fi
  fi
  echo "user $listener"
}

# restart_unit <unit> <path>: stops this box user's process that systemd runs as <unit> from <path> (its
# binary, or the script it runs), which systemd starts again at once (Restart=always). Only what runs from
# this home's services is touched. Returns 1 when no such process runs; otherwise returns once it has
# stopped, within 10 seconds.
restart_unit() {
  local proc exe arg pids=()
  for proc in /proc/[0-9]*; do
    if ! [ -O "$proc" ] || ! grep -q "/$1\$" "$proc/cgroup" 2>/dev/null; then continue; fi
    exe="$(readlink "$proc/exe" 2>/dev/null)" || continue
    if [[ "$exe" == "$2"* ]]; then pids+=("${proc#/proc/}"); continue; fi
    while IFS= read -r -d '' arg; do
      if [[ "$arg" == "$2"* ]]; then pids+=("${proc#/proc/}"); break; fi
    done 2>/dev/null <"$proc/cmdline" || true
  done
  [ "${#pids[@]}" -gt 0 ] || return 1
  kill -TERM "${pids[@]}" 2>/dev/null || true
  # Until those processes are gone, so what follows meets the one systemd starts next.
  for _ in $(seq 1 40); do
    kill -0 "${pids[@]}" 2>/dev/null || return 0
    sleep 0.25
  done
}

# unit_text <port> <python> <unit>: one of the three systemd units, as this mroom writes it. The socket holds
# the SMTP port from boot, as root, and hands it to the relay; Mailpit and the relay run as the box user,
# confined to what they use, and systemd starts them again however often they stop.
unit_text() {
  local port="$1" python="$2" base="$SERVICES/mailpit" user group
  user="$(id -un)" group="$(id -gn)"
  case "$3" in
    mroom-mail-relay.socket) cat <<EOF
# Written by mroom baseline mailpit. QA apps send mail to this port, and systemd holds it from boot, as
# root, so no one else on the box can take it, not even while the relay restarts (design D19).
[Unit]
Description=mroom: the QA SMTP port, held for mroom's mail relay

[Socket]
ListenStream=127.0.0.1:$port
Accept=no

[Install]
WantedBy=sockets.target
EOF
      ;;
    mroom-mail-relay.service) cat <<EOF
# Written by mroom baseline mailpit. Pipes QA apps' mail from the socket systemd holds to Mailpit. While it
# is down, connections wait in the socket; RestartSec keeps its restarts well under the socket's trigger
# limit, which would close the socket.
[Unit]
Description=mroom's mail relay: QA apps' mail to Mailpit
Requires=mroom-mail-relay.socket
After=mroom-mail-relay.socket
StartLimitIntervalSec=0

[Service]
User=$user
Group=$group
ExecStart=$python -I $SERVICES/mail-relay/mail-relay 127.0.0.1 $port $base/run/smtp.sock
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=$SERVICES/mail-relay $base/run
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
EOF
      ;;
    mroom-mailpit.service) cat <<EOF
# Written by mroom baseline mailpit. Mailpit listens only on Unix sockets in a folder only $user can open,
# and sees only its own files: its build, its data, its sockets and the two login files. The gate stops it
# to add or remove a login, which Mailpit reads only when it starts, and systemd starts it again however
# often that happens.
[Unit]
Description=Mailpit, mroom's QA mail catcher
After=network.target
StartLimitIntervalSec=0

[Service]
User=$user
Group=$group
WorkingDirectory=$base/data
ExecStart=$base/current/mailpit --listen unix:$base/run/http.sock:0600 --smtp unix:$base/run/smtp.sock:0600 --database $base/data/mailpit.db --smtp-auth-file $SECRETS/mailpit-smtp.passwd --smtp-auth-allow-insecure --tags-username --tags-disable x-tags,plus-addresses --ui-auth-file $SECRETS/mailpit-ui.passwd --max 0 --max-age 7d
Restart=always
RestartSec=100ms
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=$base $SECRETS/mailpit-smtp.passwd $SECRETS/mailpit-ui.passwd
BindPaths=$base/data $base/run
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
EOF
      ;;
  esac
}

# root_script <port> <python> <systemd dir> <unit...>: the commands a person runs as root to install the named
# units and start them. Every unit's text is in the script itself: root reads no file the box user can write.
root_script() {
  local port="$1" python="$2" dir="$3" unit
  shift 3
  echo "set -eu"
  for unit in "$@"; do
    printf "cat >%s <<'MROOM_UNIT'\n%s\nMROOM_UNIT\n" "$dir/$unit" "$(unit_text "$port" "$python" "$unit")"
  done
  echo "chmod 644 $dir/mroom-mail-relay.socket $dir/mroom-mail-relay.service $dir/mroom-mailpit.service"
  echo "systemctl daemon-reload"
  echo "systemctl enable --now mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service"
}

setup_mailpit() {
  local base="$SERVICES/mailpit" logins="$SECRETS/mailpit-smtp.passwd" ui="$SECRETS/mailpit-ui.passwd"
  local env_file="$SECRETS/mailpit.env" port python hash rest content password relay_changed="" mailpit_changed="" tries=1
  local systemd="${MROOM_SYSTEMD_DIR:-/etc/systemd/system}" unit stale=() restarts=() states=() status
  need curl tar sha256sum openssl python3 flock
  load_box || die "box.env could not be read"
  port="${BOX[MROOM_QA_SMTP_PORT]:-1025}"
  python="$(command -v python3)"
  # What the systemd units name, written plainly into them.
  [[ "$HOME" =~ ^/[A-Za-z0-9._/-]+$ && "$python" =~ ^/[A-Za-z0-9._/-]+$ && "$systemd" =~ ^/[A-Za-z0-9._/-]+$ ]] \
    || die "systemd units need plain paths; $(printf '%q' "$HOME"), $(printf '%q' "$python") or $(printf '%q' "$systemd") is not"
  [[ "$(id -un)" =~ ^[a-z_][a-z0-9_-]*$ && "$(id -gn)" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "the box user's name is not plain"
  CHANGED=""
  install_pinned mailpit
  mailpit_changed="$CHANGED" CHANGED=""
  install_relay
  relay_changed="$CHANGED"
  mkdir -p "$base/data" "$base/run" "$SECRETS"
  chmod 700 "$base/data" "$base/run" "$SECRETS"
  # The logins file is the gate's too: no login is changed while a request changes one.
  exec 9>"$(mroom_state_dir)/gate-mailpit.lock"
  flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || die "the gate is still changing Mailpit's logins; run this again in a moment"

  # The SMTP logins, one per environment, which the gate adds and removes. A login no one knows keeps the
  # file from ever being empty, which Mailpit would take as "no login needed".
  if [ -e "$logins" ] && ! [ -r "$logins" ]; then die "cannot read $(home_short "$logins"); give it back to $(id -un), mode 600; nothing changed"; fi
  # shellcheck disable=SC2016  # the $ signs are the hash's own
  if ! grep -qE '^mroom-none:\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$' "$logins" 2>/dev/null; then
    hash="$(new_password | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    rest=""
    if [ -e "$logins" ]; then rest="$(grep -v '^mroom-none:' "$logins" || true)"; fi
    content="mroom-none:$hash"
    if [ -n "$rest" ]; then content+=$'\n'"$rest"; fi
    put_secret "$logins" "$content"
    if [ -n "$rest" ]; then echo "SMTP logins: the placeholder login restored"; else echo "SMTP logins: $(home_short "$logins") made"; fi
  fi

  # The API login, which only the gate holds: environments read their mail through it (mail-read). Mailpit
  # reads its hash only when it starts, so the password is kept, and its hash rewritten only when it is not
  # the password's.
  password=""
  if [ -f "$env_file" ]; then password="$(sed -n 's/^MAILPIT_API_PASSWORD=//p' "$env_file" | head -n1)"; fi
  if [ -z "$password" ]; then
    password="$(new_password)"
    [ "${#password}" = 48 ] || die "could not read random bytes for a password"
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    put_secret "$env_file" "MAILPIT_API_USER=mroom-gate"$'\n'"MAILPIT_API_PASSWORD=$password"
    echo "API login: $(home_short "$env_file") made"
    mailpit_changed=1
  elif ! hash_of "$password" "$(sed -n 's/^mroom-gate://p' "$ui" 2>/dev/null | head -n1)"; then
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    echo "API login: its hash for Mailpit rewritten from $(home_short "$env_file")"
    mailpit_changed=1
  fi
  chmod 600 "$logins" "$ui" "$env_file"

  # A new build, relay or API login runs from the process's next start: systemd starts it again at once,
  # and holds the port meanwhile.
  if [ -n "$relay_changed" ]; then
    if restart_unit mroom-mail-relay.service "$SERVICES/mail-relay/"; then echo "mail relay: restarted to run this one; systemd held the port meanwhile"
    else echo "mail relay: runs the new one from its next start (mroom-mail-relay.service)"; fi
  fi
  if [ -n "$mailpit_changed" ]; then
    if restart_unit mroom-mailpit.service "$base/"; then echo "Mailpit: restarted to run its build and read its API login"; tries=40
    else echo "Mailpit: runs its build and reads its API login from its next start (mroom-mailpit.service)"; fi
  fi

  # The units, compared with the installed ones. Root reads no file the box user can write: a person runs
  # the printed script, in which every unit's text stands, as root.
  for unit in mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service; do
    if ! [ -f "$systemd/$unit" ] || [ "$(cat "$systemd/$unit")" != "$(unit_text "$port" "$python" "$unit")" ]; then
      stale+=("$unit")
      [ "$unit" = mroom-mail-relay.socket ] || ! [ -f "$systemd/$unit" ] || restarts+=("$unit")
    fi
  done
  echo
  if [ "${#stale[@]}" = 0 ]; then
    for unit in mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service; do
      states+=("$unit $(systemctl is-active "$unit" 2>/dev/null || true)")
    done
    echo "systemd units: installed as this mroom writes them ($(printf '%s, ' "${states[@]}" | sed 's/, $//'))."
  else
    cat <<EOF
Three systemd units run these: the socket holds the SMTP port apps send to, 127.0.0.1:$port, from boot, as
root, and the relay and Mailpit run as $(id -un). To be installed or updated: ${stale[*]}.

Run the script below as root, from a session the box user's programs cannot change, such as a Forge recipe
run as root (Server > Recipes); never by typing sudo in a shell of $(id -un)'s, whose PATH, aliases and
functions those programs can change. Root reads nothing the box user can write: each unit's text is in the
script. Check it first: every Exec line runs a file under $HOME, each service has User=$(id -un), no line
starts with ExecStartPre, ExecStartPost, ExecStop or ExecReload, no Exec value starts with +, ! or @, and
the socket listens on 127.0.0.1:$port only.

----- run as root -----
$(root_script "$port" "$python" "$systemd" "${stale[@]}")
EOF
    if [ "${#restarts[@]}" -gt 0 ]; then echo "systemctl restart ${restarts[*]}"; fi
    if [[ " ${stale[*]} " == *" mroom-mail-relay.socket "* ]] && [ -f "$systemd/mroom-mail-relay.socket" ] \
      && ! grep -qx "ListenStream=127.0.0.1:$port" "$systemd/mroom-mail-relay.socket"; then
      echo "systemctl restart mroom-mail-relay.socket mroom-mail-relay.service"
      echo "echo 'the SMTP port changed, and was free for a moment: give each QA environment new mail logins (mail-user-add)'"
    fi
    echo "----- end -----"
  fi
  # A Mailpit just restarted gets 10 seconds to answer.
  for _ in $(seq 1 "$tries"); do
    if curl -q --silent --fail --max-time 2 --unix-socket "$base/run/http.sock" --output /dev/null \
      http://localhost/livez 2>/dev/null; then
      tries=0
      break
    fi
    if [ "$tries" -gt 1 ]; then sleep 0.25; fi
  done
  if [ "$tries" = 0 ]; then echo "Mailpit answers."; else echo "Mailpit does not answer yet."; fi
  status="$(port_status "$port")"
  case "$status" in
    none) echo "Nothing listens on 127.0.0.1:$port yet." ;;
    systemd) echo "systemd holds 127.0.0.1:$port (mroom-mail-relay.socket)." ;;
    *) echo "Something else listens on 127.0.0.1:$port ($status): stop it before installing the units, or the socket cannot hold the port." ;;
  esac
}

case "${1:-}" in
  mailpit) [ "$#" = 1 ] || die "usage: mroom baseline mailpit"; setup_mailpit ;;
  -h | --help | "") awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" ;;
  *) die "unknown part '${1:0:40}'; mroom baseline --help lists them" ;;
esac
