#!/usr/bin/env bash
# baseline — sets up the QA services a box runs beside Forge's own (design 3, 8.9). Phase 2a's first part:
#
#   mroom baseline mailpit   the QA mail catcher (D19): Mailpit at the build lib/core/pins.txt names, checked
#                            against its SHA-256, mroom's mail relay, their folders and logins, and whether
#                            the three systemd units that run them are this release's
#   mroom baseline garage    the QA file store (D14): Garage at its pinned build, its config and secrets,
#                            whether its systemd unit is this release's, its one-node layout, and the nginx
#                            configs of its two hosts
#   mroom baseline reverb    WebSockets for every QA environment (D16): mroom's Reverb host, this release's
#                            reverb-host with the packages its composer.lock pins, its folders and an apps
#                            file the gate fills, whether its systemd unit is this release's, and the nginx
#                            config of its host
#
# It runs as the box user and changes only what the box user owns. It can run again: a binary that matches
# its pin and logins that exist are kept. Services live in /var/lib/mroom/services, in folders of the box
# user's own, mode 700, inside folders root owns, which mroom's root recipe makes with the units: systemd, as
# root, resolves the units' binds, so no part of their paths but the last may be the box user's (D21). The
# gate's own logins stay in ~/.config/mroom/secrets, files mode 600 and folders 700, where no site user can
# read them. Root runs nothing this prints: a person runs mroom's root recipe in Forge, from a release (D21).
# A box whose services lived in ~/.local/share/mroom-services moves their data on the first run after the
# recipe installed this release's units.
set -euo pipefail
shopt -s inherit_errexit
umask 077

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=lib/core/util.sh
. "$MROOM_ROOT/lib/core/util.sh"
# The units' text, which root-setup installs as root.
# shellcheck source=lib/root-setup
. "$MROOM_ROOT/lib/root-setup"

PINS="${MROOM_PINS:-$MROOM_ROOT/lib/core/pins.txt}"
# SERVICES_DIR and each part's folders (MAILPIT_TREE and the others) come from lib/root-setup.
SERVICES="${MROOM_SERVICES_DIR:-$SERVICES_DIR}"
SECRETS="$HOME/.config/mroom/secrets"
# Where the services lived before their folders moved under one root owns.
OLD_SERVICES="$HOME/.local/share/mroom-services"
WORK="" SECRET_TMP="" CHANGED="" MOVED=""
trap '[ -z "$WORK" ] || rm -rf "$WORK"; [ -z "$SECRET_TMP" ] || rm -f "$SECRET_TMP"' EXIT

die() { echo "mroom baseline: $*" >&2; exit 1; }

platform() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo linux-amd64 ;;
    Linux-aarch64 | Linux-arm64) echo linux-arm64 ;;
    *) die "no service builds are pinned for $(uname -s) $(uname -m)" ;;
  esac
}

# new_password: 48 hex characters from the kernel's random source.
new_password() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }

# crypt: the SHA-512 crypt hash of stdin, a format Mailpit reads in its login files. Fails unless openssl
# gave one: an empty hash would be a login with no password.
crypt() {
  local hash
  hash="$(openssl passwd -6 -stdin)" || return 1
  [[ "$hash" =~ ^\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$ ]] || return 1
  printf '%s\n' "$hash"
}

# hash_of <password> <hash>: whether the SHA-512 crypt hash is of the password.
hash_of() {
  [[ "$2" =~ ^\$6\$([A-Za-z0-9./]+)\$[A-Za-z0-9./]+$ ]] || return 1
  [ "$(printf '%s' "$1" | openssl passwd -6 -salt "${BASH_REMATCH[1]}" -stdin)" = "$2" ]
}

# put_secret <file> <content>: the file holding the content, mode 600, replaced in one step, from a file
# beside it.
put_secret() {
  SECRET_TMP="$(mktemp "$(dirname "$1")/.baseline.XXXXXX")"
  printf '%s\n' "$2" >"$SECRET_TMP"
  mv -f "$SECRET_TMP" "$1"
  SECRET_TMP=""
}

# install_pinned <name>: the pinned build of <name> for this platform in $SERVICES/<name>/builds/<version>,
# and $SERVICES/<name>/builds/current pointing at it. The archive and the binary must both match their
# SHA-256 pins, or nothing is installed. Sets CHANGED when it installed a build.
install_pinned() {
  local name="$1" platform line version archive_sha binary_sha url dir got
  platform="$(platform)"
  line="$(awk -v n="$name" -v p="$platform" '$1 == n && $3 == p { print $2, $4, $5, $6; exit }' "$PINS")"
  read -r version archive_sha binary_sha url <<<"$line"
  [ -n "${url:-}" ] || die "$(home_short "$PINS") pins no $name build for $platform"
  [[ "$version" =~ ^v[0-9]+(\.[0-9]+)*$ && "$archive_sha" =~ ^[0-9a-f]{64}$ && "$binary_sha" =~ ^[0-9a-f]{64}$ ]] \
    || die "the $name pin in $(home_short "$PINS") is malformed"
  [[ "$url" =~ ^https://[A-Za-z0-9._/-]+$ ]] || die "the $name pin's URL is not a plain https URL"
  dir="$SERVICES/$name/builds/$version"
  if [ -f "$dir/$name" ] && [ "$(sha256sum "$dir/$name" | cut -d' ' -f1)" = "$binary_sha" ]; then
    echo "$name $version: installed, and matches its pin"
  else
    CHANGED=1
    WORK="$(mktemp -d)"
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --max-time 600 \
      --max-filesize 200000000 --output "$WORK/archive" "$url" || die "could not download $url"
    got="$(sha256sum "$WORK/archive" | cut -d' ' -f1)"
    [ "$got" = "$archive_sha" ] || die "$name $version: the download's SHA-256 is $got, not the pinned $archive_sha; nothing installed"
    mkdir "$WORK/unpacked"
    if [ "${url##*/}" = "$name" ]; then
      # A bare binary, whose two pins are one: the download is the binary.
      cp "$WORK/archive" "$WORK/unpacked/$name"
    else
      tar -xzf "$WORK/archive" -C "$WORK/unpacked" || die "$name $version: the archive does not unpack"
    fi
    if [ ! -f "$WORK/unpacked/$name" ] || [ -L "$WORK/unpacked/$name" ]; then
      die "$name $version: the archive holds no $name binary"
    fi
    got="$(sha256sum "$WORK/unpacked/$name" | cut -d' ' -f1)"
    [ "$got" = "$binary_sha" ] || die "$name $version: the binary's SHA-256 is $got, not the pinned $binary_sha; nothing installed"
    mkdir -p "$dir"
    install -m 700 "$WORK/unpacked/$name" "$dir/.$name.new"
    mv -f "$dir/.$name.new" "$dir/$name"
    echo "$name $version: installed, SHA-256 $binary_sha"
  fi
  chmod 700 "$SERVICES/$name/builds" "$dir"
  ln -sfn "$version" "$SERVICES/$name/builds/current"
}

# install_relay: mroom's mail relay beside the services, so it keeps running however mroom is updated or
# removed. Sets CHANGED when it installed or replaced it.
install_relay() {
  local dir="$SERVICES/mail-relay/bin" had=""
  chmod 700 "$dir"
  if [ -f "$dir/mail-relay" ]; then
    if cmp -s "$MROOM_ROOT/lib/mail-relay" "$dir/mail-relay"; then
      echo "mail relay: installed, and matches this mroom"
      return 0
    fi
    had=1
  fi
  CHANGED=1
  install -m 700 "$MROOM_ROOT/lib/mail-relay" "$dir/.mail-relay.new"
  mv -f "$dir/.mail-relay.new" "$dir/mail-relay"
  if [ -n "$had" ]; then echo "mail relay: updated"; else echo "mail relay: installed"; fi
}

# port_status <port>: who listens on 127.0.0.1:<port>: "systemd" (mroom-mail-relay.socket, active), "none",
# or "user <uid>" for anything else.
port_status() {
  local port listener show
  port="$(printf '%04X' "$1")"
  listener="$(awk -v at="0100007F:$port" -v any="00000000:$port" '$4 == "0A" && ($2 == at || $2 == any) { print $8; exit }' \
    /proc/net/tcp 2>/dev/null)" || true
  if [ -z "$listener" ]; then echo none; return 0; fi
  if [ "$listener" = 0 ]; then
    show="$(systemctl show --property=ActiveState,SubState,Listen mroom-mail-relay.socket 2>/dev/null)" || true
    if [[ "$show" =~ (^|$'\n')ActiveState=active($'\n'|$) && "$show" =~ (^|$'\n')SubState=(listening|running)($'\n'|$) \
      && "$show" == *"127.0.0.1:$1 (Stream)"* ]]; then
      echo systemd
      return 0
    fi
  fi
  echo "user $listener"
}

# restart_unit <unit> <path>: stops this box user's process that systemd runs as <unit> from <path> (its
# binary, or the script it runs), which systemd starts again at once (Restart=always). Only what runs from
# this home's services is touched. Returns 1 when no such process runs; otherwise returns once it has
# stopped, within 10 seconds.
restart_unit() {
  local proc exe arg pids=()
  for proc in /proc/[0-9]*; do
    if ! [ -O "$proc" ] || ! grep -q "/$1\$" "$proc/cgroup" 2>/dev/null; then continue; fi
    exe="$(readlink "$proc/exe" 2>/dev/null)" || continue
    if [[ "$exe" == "$2"* ]]; then pids+=("${proc#/proc/}"); continue; fi
    while IFS= read -r -d '' arg; do
      if [[ "$arg" == "$2"* ]]; then pids+=("${proc#/proc/}"); break; fi
    done 2>/dev/null <"$proc/cmdline" || true
  done
  [ "${#pids[@]}" -gt 0 ] || return 1
  kill -TERM "${pids[@]}" 2>/dev/null || true
  # Until those processes are gone, so what follows meets the one systemd starts next.
  for _ in $(seq 1 40); do
    kill -0 "${pids[@]}" 2>/dev/null || return 0
    sleep 0.25
  done
}

# units_stale <port> <unit...>: prints each unit that is not installed as this release writes it (lib/root-setup
# holds their text).
units_stale() {
  local port="$1" systemd="${MROOM_SYSTEMD_DIR:-/etc/systemd/system}" unit
  shift
  for unit in "$@"; do
    if ! [ -f "$systemd/$unit" ] \
      || [ "$(cat "$systemd/$unit")" != "$(unit_text "$unit" "$(id -un)" "$(id -gn)" "${port:-1025}" "$SERVICES")" ]; then
      echo "$unit"
    fi
  done
}

# recipe_hint <part> <port>: how a person runs mroom's root recipe in Forge, which runs a release's
# lib/root-setup as root (README, "The root recipe"). Nothing this prints is to be run as root: the box
# user's programs could have changed it.
recipe_hint() {
  local version source
  version="$(cat "$MROOM_ROOT/VERSION" 2>/dev/null || echo unknown)"
  source="$(cat "$MROOM_ROOT/SOURCE" 2>/dev/null || true)"
  cat <<EOF
Root installs them with mroom's root recipe (README, "The root recipe"): $1 in its parts${2:+, smtp_port=$2}.
Take its v and sum from the README of the latest release on GitHub, never from this box, which the box user's
programs could change. This box runs mroom v$version: upgrade it to that release first. Then run mroom
baseline $1 again.
EOF
  if [[ "$source" != release* ]]; then
    echo "This mroom was installed from a checkout, not a release, and the recipe installs a release's units:"
    echo "install a release first (install.sh --version)."
  fi
}

# units_section <part> <port> <intro> <unit...>: whether the installed units are as this release writes them,
# and when they are not, how a person installs them.
units_section() {
  local part="$1" port="$2" intro="$3" systemd="${MROOM_SYSTEMD_DIR:-/etc/systemd/system}" unit stale=() states=()
  shift 3
  mapfile -t stale < <(units_stale "$port" "$@")
  echo
  if [ "$systemd" != /etc/systemd/system ]; then
    echo "WARNING: MROOM_SYSTEMD_DIR is set, so this compares the units in $systemd, not /etc/systemd/system: a"
    echo "setting for tests."
  fi
  if [ "${#stale[@]}" = 0 ]; then
    for unit in "$@"; do
      states+=("$unit $(systemctl is-active "$unit" 2>/dev/null || true)")
    done
    echo "systemd units: installed as this mroom writes them ($(printf '%s, ' "${states[@]}" | sed 's/, $//'))."
    return 0
  fi
  echo "$intro To be installed or updated: ${stale[*]}."
  echo
  recipe_hint "$part" "$port"
}

# services_ready <part> <port> <service/folder>...: dies unless each folder the part's units bind is in place,
# as the root recipe makes it: a folder of the box user's own, not a link, in a folder the box user cannot
# change. Before the recipe has run, it says how to run it.
services_ready() {
  local part="$1" port="$2" leaf dir parent
  shift 2
  [[ "$SERVICES" =~ ^/[A-Za-z0-9._/-]+$ && "/$SERVICES/" != */../* ]] \
    || die "systemd units need plain paths; $(printf '%q' "$SERVICES") is not"
  if [ "$SERVICES" != "$SERVICES_DIR" ]; then
    echo "WARNING: MROOM_SERVICES_DIR is set, so the services live in $SERVICES, not $SERVICES_DIR: a setting for tests."
  fi
  for leaf in "$@"; do
    dir="$SERVICES/$leaf" parent="$SERVICES/${leaf%%/*}"
    if ! [ -e "$dir" ] && ! [ -L "$dir" ]; then
      echo "The folders of $part are not in place yet: root makes them in $SERVICES, with its systemd units."
      echo
      recipe_hint "$part" "$port"
      exit 1
    fi
    if [ -L "$dir" ] || ! [ -d "$dir" ] || ! [ -O "$dir" ] || [ -L "$parent" ] || [ -w "$parent" ] || [ -w "$SERVICES" ]; then
      die "$dir is not as mroom's root recipe makes it: a folder of $(id -un)'s own, in a folder only root can change; nothing changed"
    fi
  done
}

# runs_from <dir>: whether a process of this user runs a program from <dir>, or names a file in it.
runs_from() {
  local dir proc exe arg
  dir="$(readlink -f "$1" 2>/dev/null)" || dir="$1"
  for proc in /proc/[0-9]*; do
    [ -O "$proc" ] || continue
    exe="$(readlink "$proc/exe" 2>/dev/null)" || exe=""
    if [[ "$exe" == "$dir"/* ]]; then return 0; fi
    while IFS= read -r -d '' arg; do
      if [[ "$arg" == "$dir"/* || "$arg" == "$1"/* ]]; then return 0; fi
    done 2>/dev/null <"$proc/cmdline" || true
  done
  return 1
}

# move_entry <path> <dir>: <path>, a file or a folder, moved into <dir> under its own name. A copy already
# there that is the same file is taken as an earlier move's, which stopped before removing the old one; any
# other stops the run. It moves under a hidden name first, and renames that once it is whole, since a move
# to another filesystem copies, then removes the old one. A hidden one an earlier run left is finished when
# the old one is gone, which mv removes only once the copy is whole; while both are there, a person decides.
# With MOVE_DRY set, it only checks, and changes nothing.
move_entry() {
  local name="${1##*/}" moving="$2/.${1##*/}.moving"
  [[ "$name" != .*.moving ]] || die "$(home_short "$1") has the name mroom gives a move under way; rename it, then run this again; nothing changed"
  if [ -e "$moving" ] || [ -L "$moving" ]; then
    if [ -e "$1" ] || [ -L "$1" ] || [ -e "$2/$name" ] || [ -L "$2/$name" ]; then
      die "$moving is what an earlier move left halfway, and $(home_short "$1") or $2/$name is still there: keep the complete one (if it is $moving, rename it to $name), remove the others, then run this again; nothing changed"
    fi
    [ -z "${MOVE_DRY:-}" ] || return 0
    mv -T -- "$moving" "$2/$name"
    MOVED=1
    return 0
  fi
  if ! [ -e "$1" ] && ! [ -L "$1" ]; then return 0; fi
  if [ -e "$2/$name" ] || [ -L "$2/$name" ]; then
    if [ -f "$1" ] && ! [ -L "$1" ] && [ -f "$2/$name" ] && ! [ -L "$2/$name" ] && cmp -s "$1" "$2/$name"; then
      [ -n "${MOVE_DRY:-}" ] || rm -f -- "$1"
      return 0
    fi
    die "both $(home_short "$1") and $2/$name exist: keep the one that holds the service's data, remove the other, then run this again; nothing changed"
  fi
  [ -z "${MOVE_DRY:-}" ] || return 0
  mv -- "$1" "$2/.$name.moving"
  mv -T -- "$2/.$name.moving" "$2/$name"
  MOVED=1
}

# move_contents <old dir> <dir>: each entry of <old dir> moved into <dir>, and <old dir> removed once empty;
# and each move into <dir> an earlier run left halfway, finished or refused.
move_contents() {
  local entry name
  while IFS= read -r -d '' entry; do
    name="${entry##*/.}"
    move_entry "$1/${name%.moving}" "$2"
  done < <(find "$2" -mindepth 1 -maxdepth 1 -name '.*.moving' -print0)
  [ -d "$1" ] || return 0
  while IFS= read -r -d '' entry; do move_entry "$entry" "$2"; done < <(find "$1" -mindepth 1 -maxdepth 1 -print0)
  [ -n "${MOVE_DRY:-}" ] || rmdir -- "$1" 2>/dev/null || true
}

# halfway <dir>...: whether a move into any of them was left halfway.
halfway() { [ -n "$(find "$@" -mindepth 1 -maxdepth 1 -name '.*.moving' -print -quit 2>/dev/null)" ]; }

# move_all <function>: the moves the function makes, all checked first, so a part either moves whole or not
# at all.
move_all() {
  MOVE_DRY=1 "$1"
  MOVE_DRY="" "$1"
}

# to_move <path>...: whether any of them is left to move: a file, or a folder with anything in it.
to_move() {
  local path
  for path in "$@"; do
    if [ -L "$path" ] || [ -f "$path" ]; then return 0; fi
    if [ -d "$path" ] && [ -n "$(find "$path" -mindepth 1 -maxdepth 1 -print -quit)" ]; then return 0; fi
  done
  return 1
}

# old_ready <part> <port> <old dir> <unit...>: before a part's data moves from the home, its units must be this
# release's, and nothing may run from its old folder any more: the root recipe restarts each service when
# it installs its new unit, so none writes the data while it moves.
old_ready() {
  local part="$1" port="$2" old="$3"
  shift 3
  [ -z "$(units_stale "$port" "$@")" ] \
    || die "$(home_short "$old") holds $part's data, which moves to $SERVICES once root has installed this release's units; run the root recipe ($part in its parts), then this again; nothing changed"
  if runs_from "$old"; then
    die "a process still runs from $(home_short "$old"), so $part's data cannot move yet; run the root recipe again ($part in its parts), which restarts its units, then this; nothing changed"
  fi
}

# moved_note <name> <old dir>: once a part's data moved, says so, and that what is left of its old folder is
# not used any more.
moved_note() {
  [ -n "$MOVED" ] || return 0
  echo "$1: its data moved from $(home_short "$2") to $SERVICES"
  if [ -e "$2" ]; then echo "$1: what is left in $(home_short "$2") (old builds, sockets) is not used any more: remove it"; fi
}

# mailpit_moves, garage_moves, reverb_moves: what each part moves from where it lived before.
mailpit_moves() {
  move_contents "$OLD_SERVICES/mailpit/data" "$SERVICES/mailpit/data"
  move_entry "$SECRETS/mailpit-smtp.passwd" "$SERVICES/mailpit/etc"
  move_entry "$SECRETS/mailpit-ui.passwd" "$SERVICES/mailpit/etc"
}
garage_moves() {
  local secret
  move_contents "$OLD_SERVICES/garage/meta" "$SERVICES/garage/meta"
  move_contents "$OLD_SERVICES/garage/data" "$SERVICES/garage/data"
  for secret in garage-rpc-secret garage-admin-token garage-metrics-token; do move_entry "$SECRETS/$secret" "$SERVICES/garage/etc"; done
}
reverb_moves() { move_entry "$OLD_SERVICES/reverb/apps/apps.json" "$SERVICES/reverb/apps"; }

setup_mailpit() {
  local base="$SERVICES/mailpit" logins="$SERVICES/mailpit/etc/mailpit-smtp.passwd" ui="$SERVICES/mailpit/etc/mailpit-ui.passwd"
  local env_file="$SECRETS/mailpit.env" port hash rest content password relay_changed="" mailpit_changed="" tries=1
  local status old="$OLD_SERVICES/mailpit"
  need curl tar sha256sum openssl python3 flock
  load_box || die "box.env could not be read"
  port="${BOX[MROOM_QA_SMTP_PORT]:-1025}"
  [ -x "$PYTHON" ] || die "$PYTHON is missing; the mail relay runs on it (apt-get install -y python3)"
  [[ "$(id -un)" =~ ^[a-z_][a-z0-9_-]*$ && "$(id -gn)" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "the box user's name is not plain"
  services_ready mailpit "$port" "${MAILPIT_TREE[@]}"
  chmod 700 "$base/builds" "$base/data" "$base/etc" "$base/run"
  mkdir -p "$SECRETS"
  chmod 700 "$SECRETS"
  # The logins file is the gate's too: no login is changed while a request changes one.
  exec 9>"$(mroom_state_dir)/gate-mailpit.lock"
  flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || die "the gate is still changing Mailpit's logins; run this again in a moment"
  # From the home, where it lived before: its mail and its logins, before its build, without which its new
  # unit cannot start, so nothing writes them while they move.
  if to_move "$old/data" "$SECRETS/mailpit-smtp.passwd" "$SECRETS/mailpit-ui.passwd" || halfway "$base/data" "$base/etc"; then
    old_ready mailpit "$port" "$old" "${MAILPIT_UNITS[@]}"
    move_all mailpit_moves
    moved_note Mailpit "$old"
  fi
  CHANGED=""
  install_pinned mailpit
  mailpit_changed="$CHANGED" CHANGED=""
  install_relay
  relay_changed="$CHANGED"

  # The SMTP logins, one per environment, which the gate adds and removes. A login no one knows keeps the
  # file from ever being empty, which Mailpit would take as "no login needed".
  if [ -e "$logins" ] && ! [ -r "$logins" ]; then die "cannot read $(home_short "$logins"); give it back to $(id -un), mode 600; nothing changed"; fi
  # shellcheck disable=SC2016  # the $ signs are the hash's own
  if ! grep -qE '^mroom-none:\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$' "$logins" 2>/dev/null; then
    hash="$(new_password | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    rest=""
    if [ -e "$logins" ]; then rest="$(grep -v '^mroom-none:' "$logins" || true)"; fi
    content="mroom-none:$hash"
    if [ -n "$rest" ]; then content+=$'\n'"$rest"; fi
    put_secret "$logins" "$content"
    if [ -n "$rest" ]; then echo "SMTP logins: the placeholder login restored"; else echo "SMTP logins: $(home_short "$logins") made"; fi
  fi

  # The API login, which only the gate holds: environments read their mail through it (mail-read). Mailpit
  # reads its hash only when it starts, so the password is kept, and its hash rewritten only when it is not
  # the password's.
  password=""
  if [ -f "$env_file" ]; then password="$(sed -n 's/^MAILPIT_API_PASSWORD=//p' "$env_file" | head -n1)"; fi
  if [ -z "$password" ]; then
    password="$(new_password)"
    [ "${#password}" = 48 ] || die "could not read random bytes for a password"
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    put_secret "$env_file" "MAILPIT_API_USER=mroom-gate"$'\n'"MAILPIT_API_PASSWORD=$password"
    echo "API login: $(home_short "$env_file") made"
    mailpit_changed=1
  elif ! hash_of "$password" "$(sed -n 's/^mroom-gate://p' "$ui" 2>/dev/null | head -n1)"; then
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    echo "API login: its hash for Mailpit rewritten from $(home_short "$env_file")"
    mailpit_changed=1
  fi
  chmod 600 "$logins" "$ui" "$env_file"

  # A new build, relay or API login runs from the process's next start: systemd starts it again at once,
  # and holds the port meanwhile.
  if [ -n "$relay_changed" ]; then
    if restart_unit mroom-mail-relay.service "$SERVICES/mail-relay/bin/"; then echo "mail relay: restarted to run this one; systemd held the port meanwhile"
    else echo "mail relay: runs the new one from its next start (mroom-mail-relay.service)"; fi
  fi
  if [ -n "$mailpit_changed" ]; then
    if restart_unit mroom-mailpit.service "$base/"; then echo "Mailpit: restarted to run its build and read its API login"; tries=40
    else echo "Mailpit: runs its build and reads its API login from its next start (mroom-mailpit.service)"; fi
  fi

  units_section mailpit "$port" "Three systemd units run these: the socket holds the SMTP port apps send to, 127.0.0.1:$port, from boot, as
root, and the relay and Mailpit run as $(id -un)." "${MAILPIT_UNITS[@]}"
  # A Mailpit just restarted gets 10 seconds to answer.
  for _ in $(seq 1 "$tries"); do
    if curl -q --silent --fail --max-time 2 --unix-socket "$base/run/http.sock" --output /dev/null \
      http://localhost/livez 2>/dev/null; then
      tries=0
      break
    fi
    if [ "$tries" -gt 1 ]; then sleep 0.25; fi
  done
  if [ "$tries" = 0 ]; then echo "Mailpit answers."; else echo "Mailpit does not answer yet."; fi
  status="$(port_status "$port")"
  case "$status" in
    none) echo "Nothing listens on 127.0.0.1:$port yet." ;;
    systemd) echo "systemd holds 127.0.0.1:$port (mroom-mail-relay.socket)." ;;
    *) echo "Something else listens on 127.0.0.1:$port ($status): stop it before installing the units, or the socket cannot hold the port." ;;
  esac
}

# garage_admin <method> <path> [<json>]: one call to Garage's admin API on its Unix socket, with the admin
# token, which reaches curl on stdin, never a command line.
garage_admin() {
  local args=(-q --silent --show-error --fail --max-time 30 --unix-socket "$SERVICES/garage/run/admin.sock" --request "$1" --header @-)
  if [ -n "${3-}" ]; then args+=(--header "Content-Type: application/json" --data-binary "$3"); fi
  printf 'Authorization: Bearer %s\n' "$(cat "$SERVICES/garage/etc/garage-admin-token")" | curl "${args[@]}" "http://localhost$2"
}

# garage_toml: Garage's config. Paths and settings only: its secrets stay in their files, mode 600, which
# Garage refuses to read when anyone else may. No root_domain for the S3 API, so apps use path-style
# addressing under one host and its certificate (section 3); the web endpoint names a bucket by its host,
# which nginx gives it from the path (`files.<zone>/<bucket>/…`).
garage_toml() {
  local base="$SERVICES/garage" etc="$SERVICES/garage/etc"
  cat <<EOF
# Written by mroom baseline garage; it is written again on every run.
metadata_dir = "$base/meta"
data_dir = "$base/data"
db_engine = "sqlite"
# One node, so no other copy to rebuild its metadata from after a crash: written through to the disk.
metadata_fsync = true
replication_factor = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret_file = "$etc/garage-rpc-secret"

[s3_api]
s3_region = "garage"
api_bind_addr = "$base/run/s3.sock"

[s3_web]
bind_addr = "$base/run/web.sock"
root_domain = ".web.mroom.invalid"

[admin]
api_bind_addr = "$base/run/admin.sock"
admin_token_file = "$etc/garage-admin-token"
metrics_token_file = "$etc/garage-metrics-token"
EOF
}

setup_garage() {
  local base="$SERVICES/garage" etc="$SERVICES/garage/etc" old="$OLD_SERVICES/garage" zone token layout node version user
  need curl tar sha256sum openssl jq flock
  load_box || die "box.env could not be read"
  zone="${BOX[MROOM_QA_ZONE]:-}" user="$(id -un)"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ && "$(id -gn)" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "the box user's name is not plain"
  services_ready garage "" "${GARAGE_TREE[@]}"
  chmod 700 "$base/builds" "$base/data" "$etc" "$base/meta" "$base/run"
  # From the home, where it lived before: its metadata, its data and its secrets, before its build, without
  # which its new unit cannot start, so nothing writes them while they move. Not while the gate changes a bucket.
  if to_move "$old/meta" "$old/data" "$SECRETS"/garage-{rpc-secret,admin-token,metrics-token} \
    || halfway "$base/meta" "$base/data" "$etc"; then
    exec 9>"$(mroom_state_dir)/gate-garage.lock"
    flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || die "the gate is still changing Garage's buckets; run this again in a moment"
    old_ready garage "" "$old" "${GARAGE_UNITS[@]}"
    move_all garage_moves
    moved_note Garage "$old"
    exec 9>&-
  fi
  CHANGED=""
  # Its secrets, each made once, and its config, before its build, which its unit starts.
  if ! [ -s "$etc/garage-rpc-secret" ]; then
    put_secret "$etc/garage-rpc-secret" "$(openssl rand -hex 32)"
    echo "Garage RPC secret: made"
  fi
  for token in admin metrics; do
    if ! [ -s "$etc/garage-$token-token" ]; then
      put_secret "$etc/garage-$token-token" "$(new_password)"
      echo "Garage $token token: made"
      CHANGED=1
    fi
  done
  chmod 600 "$etc/garage-rpc-secret" "$etc/garage-admin-token" "$etc/garage-metrics-token"
  if ! [ -f "$etc/garage.toml" ] || [ "$(cat "$etc/garage.toml")" != "$(garage_toml)" ]; then
    put_secret "$etc/garage.toml" "$(garage_toml)"
    echo "Garage config: $(home_short "$etc/garage.toml") written"
    CHANGED=1
  fi
  install_pinned garage
  if [ -n "$CHANGED" ]; then
    if restart_unit mroom-garage.service "$base/"; then echo "Garage: restarted to run its build and read its config"
    else echo "Garage: runs its build and reads its config from its next start (mroom-garage.service)"; fi
  fi

  units_section garage "" "One systemd unit runs Garage, as $user: its S3, web and admin endpoints listen only on Unix
sockets in $(home_short "$base/run"), and its own RPC stays in a network of its own." "${GARAGE_UNITS[@]}"

  # One node holds every bucket: its layout is set once, when Garage first answers.
  for _ in $(seq 1 40); do
    if layout="$(garage_admin GET /v2/GetClusterLayout 2>/dev/null)"; then break; fi
    layout=""
    [ -n "$CHANGED" ] || break
    sleep 0.25
  done
  if [ -z "$layout" ]; then
    echo "Garage does not answer yet: install its unit (the root recipe), then run mroom baseline garage again for its layout."
  elif [ "$(jq '.roles | length' <<<"$layout")" -gt 0 ]; then
    echo "Garage answers; its layout holds one node."
  else
    node="$(garage_admin GET /v2/GetClusterStatus | jq -r '.nodes[0].id // empty')"
    [[ "$node" =~ ^[0-9a-f]{16,128}$ ]] || die "Garage named no node to give the layout"
    garage_admin POST /v2/UpdateClusterLayout \
      "$(jq -nc --arg id "$node" '{roles: [{id: $id, zone: "box", capacity: 1099511627776, tags: ["mroom"]}]}')" >/dev/null
    version="$(garage_admin GET /v2/GetClusterLayout | jq '.version')"
    garage_admin POST /v2/ApplyClusterLayout "$(jq -nc --argjson v "$((version + 1))" '{version: $v}')" >/dev/null
    echo "Garage answers; its layout now holds this node."
  fi

  # Browsers reach Garage through nginx, on two hosts of the QA zone, with TLS.
  if [ -z "$zone" ]; then
    echo "Set MROOM_QA_ZONE in box.env, and run this again for the nginx configs of Garage's two hosts."
    return 0
  fi
  cat <<EOF

Browsers and apps reach Garage through nginx, on two hosts of the QA zone. Create each as a site in Forge,
with its certificate, and put this in place of the site's location blocks (Forge's nginx runs as $user, who
alone can open the sockets). Its ^~ keeps any of Forge's "location ~" blocks left in place from taking a
path that ends in .php or holds a dot folder.

s3.$zone, the S3 API: path-style, so every bucket is under this host and its certificate. Bodies stream
to Garage, which refuses an unsigned request before reading one, and nginx keeps no copy of any.

    location ^~ / {
        client_max_body_size 5g;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_set_header Host \$http_host;
        proxy_pass http://unix:$base/run/s3.sock;
    }

files.$zone, public files: /<bucket>/<path> reads <path> from a bucket whose website access is on.

    location ^~ / {
        client_max_body_size 1k;
        location ~ "^/([a-z0-9][a-z0-9-]{1,61}[a-z0-9])(/.*)\$" {
            set \$bucket \$1;
            rewrite ^/[^/]+(/.*)\$ \$1 break;
            proxy_max_temp_file_size 0;
            proxy_redirect ~^/(.*)\$ /\$bucket/\$1;
            absolute_redirect off;
            proxy_set_header Host \$bucket.web.mroom.invalid;
            proxy_pass http://unix:$base/run/web.sock;
        }
        return 404;
    }
EOF
}

# reverb_build_id: the id of this release's reverb-host, from its files (its composer.lock pins every package),
# so a build is made again only when they change.
reverb_build_id() {
  (cd "$MROOM_ROOT/reverb-host" && find . -type f ! -path './vendor/*' ! -path './bootstrap/cache/*' -print0 \
    | LC_ALL=C sort -z | xargs -0 sha256sum) | sha256sum | cut -c1-16
}

setup_reverb() {
  local base="$SERVICES/reverb" zone user id build old apps answers count previous php="$PHP" home_old="$OLD_SERVICES/reverb"
  need composer jq sha256sum curl flock
  load_box || die "box.env could not be read"
  zone="${BOX[MROOM_QA_ZONE]:-}" user="$(id -un)"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ && "$(id -gn)" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "the box user's name is not plain"
  [ -d "$MROOM_ROOT/reverb-host" ] || die "this mroom has no reverb-host folder; install a release that has one"
  # The unit runs this php, so it is the one that must be new enough.
  [ -x "$php" ] || die "$php is missing; mroom's Reverb host needs PHP 8.3 or later"
  "$php" -r 'exit(PHP_VERSION_ID >= 80300 ? 0 : 1);' \
    || die "mroom's Reverb host needs PHP 8.3 or later; $php is $("$php" -r 'echo PHP_VERSION;')"
  services_ready reverb "" "${REVERB_TREE[@]}"
  CHANGED=""
  chmod 700 "$base/builds" "$base/run" "$base/apps"
  # From the home, where it lived before: its apps, before its build, without which its new unit cannot
  # start. Not while the gate changes an app.
  if to_move "$home_old/apps/apps.json" || halfway "$base/apps"; then
    exec 9>"$(mroom_state_dir)/gate-reverb.lock"
    flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || die "the gate is still changing the Reverb host's apps; run this again in a moment"
    old_ready reverb "" "$home_old" "${REVERB_UNITS[@]}"
    move_all reverb_moves
    moved_note "Reverb host" "$home_old"
    exec 9>&-
  fi
  # Its apps: none until the gate adds one. The gate replaces this file whole, and the unit binds its folder,
  # not the file, so the host sees each new one.
  apps="$base/apps/apps.json"
  if ! [ -f "$apps" ]; then
    printf '{"apps": []}\n' >"$base/apps/.apps.json.new"
    chmod 600 "$base/apps/.apps.json.new"
    mv -f "$base/apps/.apps.json.new" "$apps"
    echo "Reverb apps: $(home_short "$apps") made, with none yet"
  fi
  chmod 600 "$apps"

  # This release's build, made once: its packages from reverb-host/composer.lock, and its provider manifest
  # written now, since the unit runs it read-only.
  id="$(reverb_build_id)"
  build="$base/builds/$id"
  if [ -f "$build/.ready" ]; then
    echo "Reverb host: build $id installed, and matches this mroom"
  else
    rm -rf "$build" "$build.tmp"
    mkdir -p "$build.tmp"
    tar -C "$MROOM_ROOT/reverb-host" --exclude=./vendor -cf - . | tar -C "$build.tmp" -xf -
    (cd "$build.tmp" && COMPOSER_NO_INTERACTION=1 composer install --no-dev --no-progress --prefer-dist \
      --classmap-authoritative --quiet) || die "composer could not install the Reverb host's packages (reverb-host/composer.lock)"
    (cd "$build.tmp" && CACHE_STORE=array QUEUE_CONNECTION=sync LOG_CHANNEL=stderr "$php" artisan list >/dev/null) \
      || die "the Reverb host's build does not run: $php artisan list failed in $(home_short "$build.tmp")"
    : >"$build.tmp/.ready"
    mv "$build.tmp" "$build"
    CHANGED=1
    echo "Reverb host: build $id installed (Reverb $(jq -r '.packages[] | select(.name == "laravel/reverb") | .version' "$build/composer.lock"))"
  fi
  # builds/current names the build, switched in one rename. A running host keeps the build it started from,
  # since PHP resolves the link once, at start.
  previous="$(readlink "$base/builds/current" 2>/dev/null || true)"
  if [ "$previous" != "$id" ]; then
    ln -sfn "$id" "$base/builds/.current.new"
    mv -Tf "$base/builds/.current.new" "$base/builds/current"
    CHANGED=1
  fi
  if [ -n "$CHANGED" ]; then
    if restart_unit mroom-reverb.service "$base/"; then echo "Reverb host: restarted to run its build"
    else echo "Reverb host: runs its build from its next start (mroom-reverb.service)"; fi
  fi
  # Older builds go. The one current named before this run stays until the next, since a host started earlier,
  # or one systemd did not restart in time, may still run from it.
  for old in "$base"/builds/*; do
    if [ "$old" != "$build" ] && [ "${old##*/}" != current ] && [ "${old##*/}" != "$previous" ]; then rm -rf "$old"; fi
  done

  units_section reverb "" "One systemd unit runs mroom's Reverb host, as $user: it listens only on a Unix socket in
$(home_short "$base/run"), and reads its apps from $(home_short "$apps")." "${REVERB_UNITS[@]}"
  # A host just restarted gets a few seconds to answer.
  answers=""
  for _ in $(seq 1 20); do
    if [ "$(curl -q -s --max-time 2 --unix-socket "$base/run/reverb.sock" -o /dev/null -w '%{http_code}' http://localhost/up 2>/dev/null)" = 200 ]; then
      answers=1
      break
    fi
    [ -n "$CHANGED" ] || break
    sleep 0.25
  done
  count="$(jq '.apps | length' "$apps" 2>/dev/null)" || count=""
  if [ -z "$answers" ]; then
    echo "Reverb host does not answer yet: install its unit (the root recipe), then run mroom baseline reverb again."
  elif [ -z "$count" ]; then
    echo "Reverb host answers, but $(home_short "$apps") is not {\"apps\": [...]} in JSON, so it serves no apps."
  else
    echo "Reverb host answers; its apps file holds $count."
  fi

  # Browsers and the QA apps reach it through nginx, on one host of the QA zone, with TLS.
  if [ -z "$zone" ]; then
    echo "Set MROOM_QA_ZONE in box.env, and run this again for the nginx config of its host."
    return 0
  fi
  cat <<EOF

Browsers and QA apps reach the Reverb host through nginx, on ws.$zone: each environment's frontend opens its
sockets there, and its backend sends its events there. Create it as a site in Forge, with its certificate,
and put this in place of the site's location blocks (Forge's nginx runs as $user, who alone can open the
socket). Its ^~ keeps any of Forge's "location ~" blocks left in place from taking a path. A socket stays
open while either side speaks within its timeout: Reverb pings a quiet one every minute. Cookies stay out:
Reverb reads none, and one set for the whole zone, as environments' were before mroom 0.5.0, would count toward
its limit on a request's size.

ws.$zone, WebSockets and Reverb's HTTP API for every QA environment:

    location ^~ / {
        client_max_body_size 64k;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header Cookie "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
        proxy_pass http://unix:$base/run/reverb.sock;
    }
EOF
}

case "${1:-}" in
  mailpit) [ "$#" = 1 ] || die "usage: mroom baseline mailpit"; setup_mailpit ;;
  garage) [ "$#" = 1 ] || die "usage: mroom baseline garage"; setup_garage ;;
  reverb) [ "$#" = 1 ] || die "usage: mroom baseline reverb"; setup_reverb ;;
  -h | --help | "") awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" ;;
  *) die "unknown part '${1:0:40}'; mroom baseline --help lists them" ;;
esac
