#!/usr/bin/env bash
# baseline — sets up the QA services a box runs beside Forge's own (design 3, 8.9). Phase 2a's first part:
#
#   mroom baseline mailpit   the QA mail catcher (D19): Mailpit at the build lib/core/pins.txt names, checked
#                            against its SHA-256, mroom's mail relay, their folders and logins, and the three
#                            systemd units that run them
#
# It runs as the box user and changes nothing outside the box user's home. It can run again: a binary that
# matches its pin and logins that exist are kept. Services live in ~/.local/share/mroom-services, which an
# uninstall of mroom leaves alone, and their logins in ~/.config/mroom/secrets, files mode 600 and folders
# 700, where no site user can read them. Installing the systemd units takes root (D20), so a person runs the
# one command this prints.
set -euo pipefail
umask 077

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=lib/core/util.sh
. "$MROOM_ROOT/lib/core/util.sh"

PINS="${MROOM_PINS:-$MROOM_ROOT/lib/core/pins.txt}"
SERVICES="$HOME/.local/share/mroom-services"
SECRETS="$HOME/.config/mroom/secrets"
WORK="" SECRET_TMP=""
trap '[ -z "$WORK" ] || rm -rf "$WORK"; [ -z "$SECRET_TMP" ] || rm -f "$SECRET_TMP"' EXIT

die() { echo "mroom baseline: $*" >&2; exit 1; }

platform() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo linux-amd64 ;;
    Linux-aarch64 | Linux-arm64) echo linux-arm64 ;;
    *) die "no service builds are pinned for $(uname -s) $(uname -m)" ;;
  esac
}

# new_password: 48 hex characters from the kernel's random source.
new_password() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }

# crypt: the SHA-512 crypt hash of stdin, a format Mailpit reads in its login files. Fails unless openssl
# gave one: an empty hash would be a login with no password.
crypt() {
  local hash
  hash="$(openssl passwd -6 -stdin)" || return 1
  [[ "$hash" =~ ^\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$ ]] || return 1
  printf '%s\n' "$hash"
}

# hash_of <password> <hash>: whether the SHA-512 crypt hash is of the password.
hash_of() {
  [[ "$2" =~ ^\$6\$([A-Za-z0-9./]+)\$[A-Za-z0-9./]+$ ]] || return 1
  [ "$(printf '%s' "$1" | openssl passwd -6 -salt "${BASH_REMATCH[1]}" -stdin)" = "$2" ]
}

# put_secret <file> <content>: the file holding the content, mode 600, replaced in one step.
put_secret() {
  SECRET_TMP="$(mktemp "$SECRETS/.baseline.XXXXXX")"
  printf '%s\n' "$2" >"$SECRET_TMP"
  mv -f "$SECRET_TMP" "$1"
  SECRET_TMP=""
}

# install_pinned <name>: the pinned build of <name> for this platform in $SERVICES/<name>/<version>, and
# $SERVICES/<name>/current pointing at it. The archive and the binary must both match their SHA-256 pins,
# or nothing is installed.
install_pinned() {
  local name="$1" platform line version archive_sha binary_sha url dir got
  platform="$(platform)"
  line="$(awk -v n="$name" -v p="$platform" '$1 == n && $3 == p { print $2, $4, $5, $6; exit }' "$PINS")"
  read -r version archive_sha binary_sha url <<<"$line"
  [ -n "${url:-}" ] || die "$(home_short "$PINS") pins no $name build for $platform"
  [[ "$version" =~ ^v[0-9]+(\.[0-9]+)*$ && "$archive_sha" =~ ^[0-9a-f]{64}$ && "$binary_sha" =~ ^[0-9a-f]{64}$ ]] \
    || die "the $name pin in $(home_short "$PINS") is malformed"
  [[ "$url" =~ ^https://[A-Za-z0-9._/-]+$ ]] || die "the $name pin's URL is not a plain https URL"
  dir="$SERVICES/$name/$version"
  if [ -f "$dir/$name" ] && [ "$(sha256sum "$dir/$name" | cut -d' ' -f1)" = "$binary_sha" ]; then
    echo "$name $version: installed, and matches its pin"
  else
    WORK="$(mktemp -d)"
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --max-time 300 \
      --max-filesize 200000000 --output "$WORK/archive" "$url" || die "could not download $url"
    got="$(sha256sum "$WORK/archive" | cut -d' ' -f1)"
    [ "$got" = "$archive_sha" ] || die "$name $version: the download's SHA-256 is $got, not the pinned $archive_sha; nothing installed"
    mkdir "$WORK/unpacked"
    tar -xzf "$WORK/archive" -C "$WORK/unpacked" || die "$name $version: the archive does not unpack"
    if [ ! -f "$WORK/unpacked/$name" ] || [ -L "$WORK/unpacked/$name" ]; then
      die "$name $version: the archive holds no $name binary"
    fi
    got="$(sha256sum "$WORK/unpacked/$name" | cut -d' ' -f1)"
    [ "$got" = "$binary_sha" ] || die "$name $version: the binary's SHA-256 is $got, not the pinned $binary_sha; nothing installed"
    mkdir -p "$dir"
    install -m 700 "$WORK/unpacked/$name" "$dir/.$name.new"
    mv -f "$dir/.$name.new" "$dir/$name"
    echo "$name $version: installed, SHA-256 $binary_sha"
  fi
  chmod 700 "$SERVICES" "$SERVICES/$name" "$dir"
  ln -sfn "$version" "$SERVICES/$name/current"
}

# install_relay: mroom's mail relay beside the services, so it keeps running however mroom is updated or
# removed.
install_relay() {
  local dir="$SERVICES/mail-relay" had=""
  mkdir -p "$dir"
  chmod 700 "$SERVICES" "$dir"
  if [ -f "$dir/mail-relay" ]; then
    if cmp -s "$MROOM_ROOT/lib/mail-relay" "$dir/mail-relay"; then
      echo "mail relay: installed, and matches this mroom"
      return 0
    fi
    had=1
  fi
  install -m 700 "$MROOM_ROOT/lib/mail-relay" "$dir/.mail-relay.new"
  mv -f "$dir/.mail-relay.new" "$dir/mail-relay"
  if [ -n "$had" ]; then echo "mail relay: updated"; else echo "mail relay: installed"; fi
}

# port_holder <port>: the owner (uid) of what listens on 127.0.0.1:<port> or on every address, if anything.
port_holder() {
  local port
  port="$(printf '%04X' "$1")"
  cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | awk -v port="$port" '$4 == "0A" {
      split($2, addr, ":")
      if (addr[2] == port && (addr[1] == "0100007F" || addr[1] ~ /^0+$/)) { print $8; exit }
    }' || true
}

# restart_unit <unit>: stops the box user's process that systemd runs as <unit>, which systemd starts again at
# once (Restart=always). Returns 1 when no such process runs.
restart_unit() {
  local proc pids=()
  for proc in /proc/[0-9]*; do
    if [ -O "$proc" ] && grep -q "/$1\$" "$proc/cgroup" 2>/dev/null; then pids+=("${proc#/proc/}"); fi
  done
  [ "${#pids[@]}" -gt 0 ] || return 1
  kill -TERM "${pids[@]}" 2>/dev/null || true
}

# write_units <port> <python>: the three systemd units in $SERVICES/units, which a person installs (D20).
# The socket holds the SMTP port from boot, as root, and hands it to the relay; Mailpit and the relay run as
# the box user, and systemd starts them again however often they stop.
write_units() {
  local port="$1" python="$2" base="$SERVICES/mailpit" units="$SERVICES/units" user group
  user="$(id -un)" group="$(id -gn)"
  mkdir -p "$units"
  chmod 700 "$units"
  cat >"$units/mroom-mail-relay.socket" <<EOF
# Written by mroom baseline mailpit. QA apps send mail to this port, and systemd holds it from boot, as
# root, so no one else on the box can take it, not even while the relay restarts (design D19).
[Unit]
Description=mroom: the QA SMTP port, held for mroom's mail relay

[Socket]
ListenStream=127.0.0.1:$port
Accept=no

[Install]
WantedBy=sockets.target
EOF
  cat >"$units/mroom-mail-relay.service" <<EOF
# Written by mroom baseline mailpit. Pipes QA apps' mail from the socket systemd holds to Mailpit.
[Unit]
Description=mroom's mail relay: QA apps' mail to Mailpit
Requires=mroom-mail-relay.socket
After=mroom-mail-relay.socket
StartLimitIntervalSec=0

[Service]
User=$user
Group=$group
ExecStart=$python -I $SERVICES/mail-relay/mail-relay 127.0.0.1 $port $base/run/smtp.sock
Restart=always
RestartSec=1
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
  cat >"$units/mroom-mailpit.service" <<EOF
# Written by mroom baseline mailpit. Mailpit listens only on Unix sockets in a folder only $user can open.
# The gate stops it to add or remove a login, which Mailpit reads only when it starts, and systemd starts
# it again however often that happens.
[Unit]
Description=Mailpit, mroom's QA mail catcher
After=network.target
StartLimitIntervalSec=0

[Service]
User=$user
Group=$group
WorkingDirectory=$base/data
ExecStart=$base/current/mailpit --listen unix:$base/run/http.sock:0600 --smtp unix:$base/run/smtp.sock:0600 --database $base/data/mailpit.db --smtp-auth-file $SECRETS/mailpit-smtp.passwd --smtp-auth-allow-insecure --tags-username --tags-disable x-tags,plus-addresses --ui-auth-file $SECRETS/mailpit-ui.passwd --max 0 --max-age 7d
Restart=always
RestartSec=100ms
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
  chmod 600 "$units"/mroom-*
}

setup_mailpit() {
  local base="$SERVICES/mailpit" logins="$SECRETS/mailpit-smtp.passwd" ui="$SECRETS/mailpit-ui.passwd"
  local env_file="$SECRETS/mailpit.env" port python hash rest content password relay_line relay_changed="" api_changed=""
  local systemd="${MROOM_SYSTEMD_DIR:-/etc/systemd/system}" unit changed=() missing=() holder
  need curl tar sha256sum openssl python3 flock
  load_box || die "box.env could not be read"
  port="${BOX[MROOM_QA_SMTP_PORT]:-1025}"
  python="$(command -v python3)"
  # What the systemd units name, written plainly into them.
  [[ "$HOME" =~ ^/[A-Za-z0-9._/-]+$ && "$python" =~ ^/[A-Za-z0-9._/-]+$ ]] \
    || die "systemd units need plain paths; $(printf '%q' "$HOME") or $(printf '%q' "$python") is not"
  [[ "$(id -un)" =~ ^[a-z_][a-z0-9_-]*$ && "$(id -gn)" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "the box user's name is not plain"
  install_pinned mailpit
  relay_line="$(install_relay)"
  echo "$relay_line"
  [ "$relay_line" = "mail relay: installed, and matches this mroom" ] || relay_changed=1
  mkdir -p "$base/data" "$base/run" "$SECRETS"
  chmod 700 "$base/data" "$base/run" "$SECRETS"
  # The logins file is the gate's too: no login is changed while a request changes one.
  exec 9>"$(mroom_state_dir)/gate-mailpit.lock"
  flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || die "the gate is still changing Mailpit's logins; run this again in a moment"

  # The SMTP logins, one per environment, which the gate adds and removes. A login no one knows keeps the
  # file from ever being empty, which Mailpit would take as "no login needed".
  if [ -e "$logins" ] && ! [ -r "$logins" ]; then die "cannot read $(home_short "$logins"); give it back to $(id -un), mode 600; nothing changed"; fi
  # shellcheck disable=SC2016  # the $ signs are the hash's own
  if ! grep -qE '^mroom-none:\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$' "$logins" 2>/dev/null; then
    hash="$(new_password | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    rest=""
    if [ -e "$logins" ]; then rest="$(grep -v '^mroom-none:' "$logins" || true)"; fi
    content="mroom-none:$hash"
    if [ -n "$rest" ]; then content+=$'\n'"$rest"; fi
    put_secret "$logins" "$content"
    if [ -n "$rest" ]; then echo "SMTP logins: the placeholder login restored"; else echo "SMTP logins: $(home_short "$logins") made"; fi
  fi

  # The API login, which only the gate holds: environments read their mail through it (mail-read). Mailpit
  # reads its hash only when it starts, so the password is kept, and its hash rewritten only when it is not
  # the password's.
  password=""
  if [ -f "$env_file" ]; then password="$(sed -n 's/^MAILPIT_API_PASSWORD=//p' "$env_file" | head -n1)"; fi
  if [ -z "$password" ]; then
    password="$(new_password)"
    [ "${#password}" = 48 ] || die "could not read random bytes for a password"
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    put_secret "$env_file" "MAILPIT_API_USER=mroom-gate"$'\n'"MAILPIT_API_PASSWORD=$password"
    echo "API login: $(home_short "$env_file") made"
    api_changed=1
  elif ! hash_of "$password" "$(sed -n 's/^mroom-gate://p' "$ui" 2>/dev/null | head -n1)"; then
    hash="$(printf '%s' "$password" | crypt)" || die "openssl gave no SHA-512 crypt hash; nothing changed"
    put_secret "$ui" "mroom-gate:$hash"
    echo "API login: its hash for Mailpit rewritten from $(home_short "$env_file")"
    api_changed=1
  fi
  chmod 600 "$logins" "$ui" "$env_file"

  # A changed relay or API login needs its process started again; systemd does that, and holds the port
  # meanwhile.
  if [ -n "$relay_changed" ]; then
    if restart_unit mroom-mail-relay.service; then echo "mail relay: restarted to run this one; systemd held the port meanwhile"
    else echo "mail relay: runs the new one from its next start (mroom-mail-relay.service)"; fi
  fi
  if [ -n "$api_changed" ]; then
    if restart_unit mroom-mailpit.service; then echo "Mailpit: restarted to read its API login"
    else echo "Mailpit: reads its API login from its next start (mroom-mailpit.service)"; fi
  fi

  write_units "$port" "$python"
  for unit in mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service; do
    if ! [ -f "$systemd/$unit" ]; then missing+=("$unit")
    elif ! cmp -s "$SERVICES/units/$unit" "$systemd/$unit"; then changed+=("$unit"); fi
  done
  echo
  if [ "${#missing[@]}" = 0 ] && [ "${#changed[@]}" = 0 ]; then
    echo "systemd units: installed, and as this mroom writes them."
  else
    cat <<EOF
Three systemd units run these, and a person installs them (root, D20): the socket holds the SMTP port
apps send to, 127.0.0.1:$port, from boot, so no one else on the box can take it, and the relay and Mailpit
run as $(id -un). Install them with:

  cd $SERVICES/units && sudo install -o root -g root -m 644 mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service $systemd/ && sudo systemctl daemon-reload && sudo systemctl enable --now mroom-mail-relay.socket mroom-mail-relay.service mroom-mailpit.service
EOF
    if [ "${#changed[@]}" -gt 0 ]; then
      echo
      echo "Changed since they were installed: ${changed[*]}. After installing, restart the services that changed"
      echo "(sudo systemctl restart <unit>). A restart of the socket frees the port for a moment, so after one,"
      echo "give each QA environment new mail logins."
    fi
  fi
  if curl -q --silent --fail --max-time 2 --unix-socket "$base/run/http.sock" --output /dev/null \
    http://localhost/livez 2>/dev/null; then
    echo "Mailpit answers."
  else
    echo "Mailpit does not answer yet."
  fi
  holder="$(port_holder "$port")"
  case "$holder" in
    "") echo "Nothing listens on 127.0.0.1:$port yet." ;;
    0) echo "systemd holds 127.0.0.1:$port." ;;
    *) echo "Something else listens on 127.0.0.1:$port (user $holder): stop it before installing the units." ;;
  esac
}

case "${1:-}" in
  mailpit) [ "$#" = 1 ] || die "usage: mroom baseline mailpit"; setup_mailpit ;;
  -h | --help | "") awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" ;;
  *) die "unknown part '${1:0:40}'; mroom baseline --help lists them" ;;
esac
