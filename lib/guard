#!/usr/bin/env bash
# guard — mroom guard, the PreToolUse hook for Claude Code's Bash tool (design 8.3): it refuses the commands
# an agent must never run, however they are spelled. Agents never merge, approve, release, force-push or read
# secrets; a person does that.
#
#   mroom guard hook           read the hook's JSON on stdin (.tool_name, .tool_input.command); exit 0 lets
#                              the command run, exit 2 refuses it with the reason on stderr
#   mroom guard check <command>
#                              the same check on one command given as an argument; prints "allowed" or the
#                              reason, and exits 0 or 2
#   mroom guard help
#
# It is a speed bump, not a boundary. A command built from variables (`$CMD`) or from another command's output
# (`cat $(echo x)`), a script file, an alias already in a config file, `ssh host 'cmd'`, GraphQL split across
# quotes (`'merge''PullRequest'`), a payload built by jq, sed's `e`, `r` and `w` commands, a command run in a
# container (`docker compose exec app cat .env`), a relative path after `cd` to a folder above the secrets
# (`cd ~/.config && cat gh/hosts.yml`), a recursive search of the project
# (`grep -r KEY .` reads its .env too), the environment (`echo $TOKEN`), or re-running a deploy's workflow run
# (`gh run rerun`, which the `production` environment still gates) gets past it. GitHub is the gate: the ruleset on the default branch, people's reviews and the
# `production` environment (design D22). The settings fragments' prefix rules are a second layer.
#
# Why a parser: permission rules match on the command's prefix, so `gh api -X PUT .../pulls/N/merge`,
# `bash -c '...'` or `true && cat .env` walk around `Bash(gh pr merge:*)` and `Read(**/.env)` (which only
# guards the Read tool). lib/core/guard-tokenize.awk splits the whole command into simple commands (quotes,
# $'...', `;` `&&` `||` `|` `&`, newlines, $(...), backticks, subshells, process substitution, heredocs and
# here-strings), and this script checks every one, after stripping wrappers (sudo, env X=y, X=y, command,
# xargs with what it reads, timeout, setsid, flock, script -c, su -c, parallel, tmux, at, trap, export,
# direnv/mise/uv/op runners, npx, pnpm exec/dlx, yarn, bunx, ...). Text that reaches a shell (bash -c, eval, watch, a
# heredoc, a here-string, or a pipe from echo/printf/cat) is checked again as a command; shell input it cannot
# read is refused.
#
# Refused:
#   - merging: `gh pr merge`, `gh api` writes to .../pulls/N/merge or .../merges, GraphQL
#     mergePullRequest / enablePullRequestAutoMerge / enqueuePullRequest / mergeBranch, and any
#     curl/wget write to api.github.com;
#   - approving: `gh pr review --approve`, a review with event=APPROVE (REST or GraphQL);
#   - releasing and tagging: any non-GET `gh api` on .../releases (create and edit go through
#     `gh release create/edit`, which a settings fragment makes ask), `gh release delete`, GraphQL release
#     mutations, and pushing tags (`--tags`, `--follow-tags`, `refs/tags/...`, release-shaped names such as
#     `v1.2` or `release-v1.2.3`);
#   - force-pushing: `git push` with -f, --force, --force-with-lease, --force-if-includes, --mirror or
#     --prune (and their abbreviations), a `+` or pattern refspec, a push to main, master or release,
#     --receive-pack, `git send-pack`, `git config` that makes a later push force, mirror or match, an alias
#     that pushes, non-GET `gh api` on .../git/refs, GraphQL createRef/updateRef(s)/deleteRef,
#     `gh repo sync --force` and `gh pr update-branch --rebase`;
#   - passing or changing the gate: approving deployments (pending_deployments, approveDeployments,
#     rejectDeployments), approving fork runs, non-GET on rulesets, branch protection and
#     environments, running deploy-* workflows, `gh alias set/import` and shell git aliases (an
#     alias can hide any of the above);
#   - reading secrets: a reader (cat, grep, head, sed, cp, ln, base64, tar, curl -F @..., git
#     diff/show/add, find -exec, an interpreter's code, `< file`, ...) on .env* (but not *.example),
#     ~/.ssh (but not *.pub), ~/.config/gh*, ~/.config/mroom/secrets, any *.env under ~/.config,
#     ~/.git-credentials, ~/.netrc, ~/.npmrc, auth.json, ~/.docker/config.json (in any case: macOS ignores it),
#     ~/.forge-token, ~/.aws, ~/.laravel-forge, ~/.claude*/.credentials.json, a glob that matches one,
#     and a recursive copy, archive or search of a folder that holds them (~, ~/.config, ~/.claude); and
#     `gh auth token`, `gh auth status -t`, `gh config get ...token`.
#
# Refused on purpose, though they can be harmless: setting a git key that runs a command (`git config
# core.editor vim`; `git -c` checks the value instead, since it lasts one command), opening or editing a secret
# (`vim .env`, `sed -i ... .env`), loading one (`node --env-file=.env`), and httpie to api.github.com without
# an explicit GET or HEAD (it sends its stdin as the body).
#
# Allowed on purpose: reading code, every `gh api` GET (including GET .../pulls/N/merge, which only
# asks "is it merged?"), gh pr view/list/checks/create/edit/comment, `gh release create/edit` (an
# `ask` rule prompts the developer), `git push` of a branch (an `ask` rule in base.json), `cp .env.example .env`
# (.env is the destination), writes such as `echo X=y >> .env`, `git show HEAD:path` (committed content only),
# and `bash script.sh` (a script file is not read here).
#
# Contract (https://code.claude.com/docs/en/hooks): exit 2 blocks and its stderr is shown to the model, and
# a block applies before permission rules, so it also beats an allow rule. Any other exit lets the command
# through, so this script exits only 0 or 2.
#
# A broken guard must not brick every session: without jq or awk it allows and warns. A command it cannot
# check (over 256 KB, over 3000 simple commands, or one the tokeniser fails on) is refused instead.
#
# Bash 3.2 compatible (macOS). Tests: tests/guard-test.sh. No `set -u`: bash 3.2 treats an empty
# "${array[@]}" as unbound, and any exit other than 0 or 2 lets the command through.
export LC_ALL=C

SELF="${BASH_SOURCE[0]}"
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" | sed -n '/^  *mroom guard hook/,/^$/p'; }

mode=${1:-}
case "$mode" in
  hook) ;;
  check)
    [ "$#" = 2 ] || { echo "mroom guard: check takes one command, as one argument" >&2; exit 64; }
    ;;
  help | -h | --help) usage; exit 0 ;;
  *) echo "mroom guard: hook, check <command> or help" >&2; exit 64 ;;
esac

# Off, with a warning, rather than refusing every command: GitHub's rules still apply (see above).
warn_off() {
  local msg="mroom guard: $1 is not installed, so the Bash guard is off (GitHub's rules still apply)."
  echo "$msg" >&2
  [ "$mode" = hook ] && printf '{"systemMessage":"%s"}\n' "$msg"
  exit 0
}
# MROOM_GUARD_AWK picks the awk (the tests run the tokeniser under gawk, mawk and BWK awk). In hook mode it
# comes from Claude Code's environment, which a Bash command cannot change for its own hook.
AWK=${MROOM_GUARD_AWK:-awk}
command -v "$AWK" >/dev/null 2>&1 || warn_off "$AWK"

HERE=$(cd "$(dirname "$(readlink -f "$SELF" 2>/dev/null || echo "$SELF")")" && pwd)
TOKENIZER="$HERE/core/guard-tokenize.awk"
MAX_BYTES=262144
MAX_COMMANDS=3000

if [ "$mode" = hook ]; then
  command -v jq >/dev/null 2>&1 || warn_off jq
  input=$(cat)
  tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
  [ "$tool" = "Bash" ] || exit 0
  command=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
else
  command=$2
fi
[ -n "$command" ] || { [ "$mode" = check ] && echo allowed; exit 0; }

US=$'\037'
MK=$'\034'
DY=$'\033'
BLOCKED=""
COMMANDS=0
RAW=$(printf '%s' "$command" | tr '[:upper:]' '[:lower:]')

block() { [ -n "$BLOCKED" ] || BLOCKED=$1; }
# Lower case, with the tokeniser's encoded newlines decoded. Long strings never go through bash's
# ${x//...} or ${x##*...}: in bash 3.2 those are quadratic or worse, and a slow hook is a bypass.
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr '\035' '\n'; }
# NAME = basename of a command word (no fork: this runs per command); a word too long to be a path is left alone.
# A leading `=` is zsh's `=cmd` (the path of cmd).
cmd_name() { if [ "${#1}" -le 4096 ]; then NAME=${1##*/}; NAME=${NAME#=}; else NAME=$1; fi; }

SHELLS=" bash sh zsh dash ksh mksh ash yash posh fish tcsh csh pwsh "
READERS=" cat tac head tail less more most bat batcat sed gsed awk gawk mawk nawk grep egrep fgrep rg ag ack cut sort uniq nl od xxd hexdump base64 base32 strings cp mv ln scp rsync install tar zip gzip bzip2 xz 7z diff cmp comm paste join jq yq source . vi vim nvim view nano emacs code open dd iconv fold fmt pr rev expand unexpand openssl gpg curl wget http https look split csplit zcat gzcat bzcat xzcat zstdcat lz4cat zless zmore zgrep zegrep zfgrep unzip column shuf "
PATTERN_FIRST=" grep egrep fgrep rg ag ack sed gsed awk gawk mawk nawk jq yq "
COPIERS=" cp mv ln scp rsync install "
# Readers that read a folder whole, so a folder holding secrets counts as a secret.
RECURSIVE=" cp scp rsync tar zip 7z grep egrep fgrep rg ag ack zgrep "
INTERPRETERS=" python python3 php node ruby perl deno bun osascript "

# is_secret_path TOKEN: does this argument name a secret file?
is_secret_path() {
  local t=$1 base name
  [ "${#t}" -le 4096 ] || return 1 # not a path; keeps the pattern matching below linear
  t=${t##*=}
  t=${t#@}
  while [ "${t%/}" != "$t" ]; do t=${t%/}; done
  [ -n "$t" ] || return 1
  # Lower case: macOS file systems ignore case, so `.ENV` is `.env` there.
  t=$(lc "$t")
  base=${t##*/}
  case "$base" in *.example | *.example.* | *.pub) return 1 ;; esac
  case "$base" in
    .env | .env.* | .envrc | .forge-token | .credentials.json | .git-credentials | .netrc | .pgpass) return 0 ;;
  esac
  # Composer's auth.json (in the project root or Composer's home) and the home folder's .npmrc hold tokens;
  # a test fixture named auth.json or a project's .npmrc usually does not.
  case "$t" in auth.json | ./auth.json | */.config/composer/auth.json | */.composer/auth.json) return 0 ;; esac
  [ "$base" = .npmrc ] && home_rest "$t" && [ "$REST" = .npmrc ] && return 0
  case "/$t/" in
    */.ssh/* | */.config/gh/* | */.config/gh-* | */.config/mroom/secrets/* | */.aws/* | */.laravel-forge/* | */.config/forge/*) return 0 ;;
    */.docker/config.json/ | */.config/git/credentials/) return 0 ;;
    # A tool's secrets kept as an env file under ~/.config (an MCP server's keys, say).
    */.config/*.env/) return 0 ;;
  esac
  # A glob starting with a dot (`.env*`, `.*`) that would match a secret file.
  if [[ $base == .* && $base == *[\*\?\[]* ]]; then
    for name in .env .env.local .env.testing .env.production .envrc .forge-token .credentials.json; do
      # shellcheck disable=SC2053 # $base is a glob on purpose
      [[ $name == $base ]] && return 0
    done
  fi
  # A glob under the home folder (`~/.config/mroom/secret*`, `~/.c*/gh/*`) that would match a secret file.
  if [[ $t == *[\*\?\[]* ]] && home_rest "$t"; then
    for name in .ssh/id_rsa .ssh/id_ed25519 .config/gh/hosts.yml .config/mroom/secrets/forge-token \
      .config/tool/mcp.env .forge-token .claude/.credentials.json .aws/credentials; do
      # shellcheck disable=SC2053 # $REST is a glob on purpose
      [[ $name == $REST ]] && return 0
    done
  fi
  return 1
}

# home_rest PATH: when PATH is in a home folder (`~/x`, `$HOME/x`, `/home/u/x`, `/Users/u/x`, `/root/x`), REST
# is the part after it ("" for the folder itself).
home_rest() {
  local t
  t=$(lc "$1")
  # shellcheck disable=SC2088 # a literal ~, as the command has it
  case "$t" in
    "~" | "${DY}\$home" | "${DY}\${home}" | /root) REST="" ;;
    "~/"* | /root/*) REST=${t#*/} ;;
    "~"*/*) REST=${t#*/} ;; # ~user/...
    "~"*) REST="" ;;        # ~user
    "${DY}\$home/"* | "${DY}\${home}/"*) REST=${t#*/} ;;
    /home/*/* | /users/*/*) REST=${t#/*/*/} ;;
    /home/* | /users/*) REST="" ;;
    *) return 1 ;;
  esac
  while [ "${REST%/}" != "$REST" ]; do REST=${REST%/}; done
  return 0
}

# is_secret_parent PATH: a folder that holds secret files (the home folder, ~/.config, ~/.claude, ...), which
# a recursive copy, archive or search reads whole.
is_secret_parent() {
  [ "${#1}" -le 4096 ] && home_rest "$1" || return 1
  case "$REST" in
    "" | .config | .config/mroom | .claude | .claude-* | .local | .local/share) return 0 ;;
  esac
  return 1
}

# mentions_secret TEXT: does code (python -c, a heredoc into php, ...) name a secret file?
mentions_secret() {
  local t
  t=$(lc "$1" | sed 's/\.env\.example//g')
  [[ $t =~ (^|[^a-z0-9_.-])\.env([^a-z0-9_]|$) ]] && return 0
  case "$t" in
    *.ssh/* | *.forge-token* | *.credentials.json* | *.config/gh* | *.config/mroom/secrets* | *.aws/* | *.git-credentials* | *.netrc*) return 0 ;;
  esac
  return 1
}

# mentions_forbidden TEXT: does code in another language run a merge, approval, release, force-push or deploy?
mentions_forbidden() {
  local t
  # Quotes, commas and brackets become spaces, so a list of arguments (["gh","pr","merge"]) reads as words.
  t=$(lc "$1" | tr -cs 'a-z0-9/._+=:-' ' ')
  [[ $t =~ gh[[:space:]]+(pr[[:space:]]+merge|release[[:space:]]+delete|auth[[:space:]]+token|alias[[:space:]]+set) ]] && return 0
  [[ $t =~ gh[[:space:]]+pr[[:space:]]+review.*(--approve|[[:space:]]-a([[:space:]]|$)) ]] && return 0
  [[ $t =~ gh[[:space:]]+workflow[[:space:]]+run.*deploy- ]] && return 0
  [[ $t =~ git[[:space:]]+push.*([[:space:]](--fo|--mi|-[a-z]*f|\+)|--tags) ]] && return 0
  [[ $t =~ gh[[:space:]]+pr[[:space:]]+update-branch.*--rebase ]] && return 0
  [[ $t =~ (pulls/[^/[:space:]]+/merge|/merges|pending_deployments|actions/runs/[^/[:space:]]+/approve) ]] && return 0
  [[ $t =~ event.{0,6}approve ]] && return 0
  [[ $t =~ (mergepullrequest|enablepullrequestautomerge|enqueuepullrequest|mergebranch|approvedeployments|rejectdeployments|updateref|/git/refs) ]] && return 0
  return 1
}

check_code() {
  local what=$1 code=$2
  if mentions_secret "$code"; then
    block "$what names a secret file"
  elif mentions_forbidden "$code"; then
    block "$what runs a merge, approval, release, force-push or deploy"
  fi
}

# static_output RECORD: what a pipeline stage writes when that is knowable without running it
# (echo or printf arguments, cat of a heredoc or here-string). Fails when it is not.
static_output() {
  local -a f w=()
  local meta k a cmd out="" doc="" has_doc=0 from_file=0
  IFS=$US read -r -a f <<<"$1"
  meta=${f[0]}
  for ((k = 1; k < ${#f[@]}; k++)); do
    a=${f[$k]}
    case "$a" in
      "${MK}HD" | "${MK}HS") k=$((k + 1)); doc=${f[$k]}; has_doc=1 ;;
      "${MK}R<") k=$((k + 1)); from_file=1 ;;
      "${MK}R>") k=$((k + 1)) ;;
      *) w+=("$a") ;;
    esac
  done
  [ "${#w[@]}" -gt 0 ] || return 1
  cmd_name "${w[0]}"; cmd=$NAME
  case "$cmd" in
    # The builtins themselves, so escapes (`echo -e`, printf's \n and %b) come out as they would.
    echo)
      # shellcheck disable=SC2116 # the builtin's own output, escapes and all
      out=$(builtin echo "${w[@]:1}") || return 1
      ;;
    printf)
      [ "${#w[@]}" -gt 1 ] || return 1
      # shellcheck disable=SC2059 # the format is the command's own, on purpose
      out=$(builtin printf -- "${w[@]:1}" 2>/dev/null) || return 1
      ;;
    cat)
      [ "${#w[@]}" = 1 ] && [ "$has_doc" = 1 ] && [ "$from_file" = 0 ] && [ "${meta:0:1}" != p ] || return 1
      out=$doc
      ;;
    *) return 1 ;;
  esac
  case "$out" in *"$DY"*) return 1 ;; esac
  printf '%s' "$out"
}

check_secrets() {
  local cmd=$1
  shift
  local -a args=("$@")
  local i a prev="" n=${#args[@]} last_pos=-1 skip_pattern=0 seen_pos=0

  case "$READERS" in *" $cmd "*) ;; *) return ;; esac

  case "$PATTERN_FIRST" in
    *" $cmd "*)
      skip_pattern=1
      for a in "${args[@]}"; do
        case "$a" in -e | --regexp | --regexp=* | -f | --file | --file=* | --expression | --expression=*) skip_pattern=0 ;; esac
      done
      ;;
  esac

  case "$COPIERS" in
    *" $cmd "*)
      for ((i = 0; i < n; i++)); do
        case "${args[$i]}" in
          # -t DIR names the destination, so every other word is a source.
          -t | -t* | --target-directory*) last_pos=-2; break ;;
          -*) ;;
          *) last_pos=$i ;;
        esac
      done
      [ "$last_pos" = -2 ] && last_pos=-1
      ;;
  esac

  for ((i = 0; i < n; i++)); do
    a=${args[$i]}
    case "$prev" in
      -e | --regexp | --expression) prev=$a; continue ;; # a pattern, not a file
      --exclude | --exclude-from | --exclude-dir) prev=$a; continue ;; # a name left out, not read
      -x) [ "$cmd" = zip ] && { prev=$a; continue; } ;;
    esac
    prev=$a
    case "$a" in
      --exclude=* | --exclude-from=* | --exclude-dir=*) continue ;;
    esac
    # curl, wget and httpie read a file named in a form or data value: name=@path, name=<path, @path;type=...,
    # name@path (curl --data-urlencode, httpie's file items).
    case "$cmd" in
      curl | wget | http | https)
        local v=$a
        [ "${#v}" -le 4096 ] || v=""
        case "$v" in -*=*) v=${v#*=} ;; esac
        case "$v" in *=[@\<]*) v=${v#*=} ;; esac
        case "$v" in [@\<]*) v=${v:1} ;; *@*) v=${v#*@} ;; esac
        v=${v%%;*}
        if [ -n "$v" ] && [ "$v" != "$a" ] && is_secret_path "$v"; then
          block "$cmd would send a secret file ($v)"
          return
        fi
        ;;
    esac
    case "$a" in
      -*@*) # a flag glued to a file (`curl -d@.env`, `--data-binary@...`)
        if [ "${#a}" -le 4096 ] && is_secret_path "${a#*@}"; then
          block "$cmd would read a secret file (${a#*@})"
          return
        fi
        continue
        ;;
      -*) case "$a" in *=*) ;; *) continue ;; esac ;;
      *)
        if [ "$skip_pattern" = 1 ] && [ "$seen_pos" = 0 ]; then
          seen_pos=1
          continue
        fi
        seen_pos=1
        ;;
    esac
    [ "$i" = "$last_pos" ] && continue # the destination of cp/mv/ln
    if is_secret_path "$a"; then
      block "$cmd would read a secret file ($a)"
      return
    fi
    case "$RECURSIVE" in
      *" $cmd "*)
        if is_secret_parent "$a"; then
          block "$cmd would read a folder that holds secret files ($a)"
          return
        fi
        ;;
    esac
  done
}

check_graphql_text() {
  local t=$1
  if [[ $t =~ (mergepullrequest|enablepullrequestautomerge|enqueuepullrequest|mergebranch|createrelease|updaterelease|deleterelease|branchprotectionrule|repositoryruleset) ]]; then
    block "a GraphQL mutation merges, queues a merge, releases or changes branch protection"
  elif [[ $t =~ createcommitonbranch ]]; then
    block "a GraphQL mutation commits to a branch on GitHub, outside git push"
  elif [[ $t =~ (createref|updateref|deleteref) ]]; then
    block "a GraphQL mutation creates, moves or deletes a branch or tag (a force-push or a tag)"
  elif [[ $t =~ (approvedeployments|rejectdeployments) ]]; then
    block "a GraphQL mutation approves or rejects a deployment"
  elif [[ $t =~ (addpullrequestreview|submitpullrequestreview) && $t =~ approve ]]; then
    block "a GraphQL review approves a pull request"
  fi
}

# normalize_endpoint PATH: lower case, no host, no leading/trailing or doubled slashes, no query.
normalize_endpoint() {
  local ep
  [ "${#1}" -le 4096 ] || { printf '%s' "$1"; return; } # not an endpoint (see lc)
  ep=$(lc "$1")
  ep=${ep#https://api.github.com}
  ep=${ep#http://api.github.com}
  ep=${ep%%\?*}
  ep=${ep%%#*}
  while [[ $ep == *//* ]]; do ep=${ep//\/\//\/}; done
  ep=${ep#/}
  ep=${ep%/}
  printf '%s' "$ep"
}

check_gh_api() {
  local method="" endpoint="" fields=0 input="" approve=0 file_field=0 a v ep
  while [ $# -gt 0 ]; do
    a=$1
    shift
    v=""
    case "$a" in
      -X | --method) method=${1:-}; shift ;;
      --method=*) method=${a#*=} ;;
      -X*) method=${a#-X}; method=${method#=} ;;
      -f | -F | --field | --raw-field) fields=1; v=${1:-}; shift ;;
      --field=* | --raw-field=*) fields=1; v=${a#*=} ;;
      -f* | -F*) fields=1; v=${a:2} ;;
      --input) input=${1:-}; shift ;;
      --input=*) input=${a#*=} ;;
      -H | --header | -q | --jq | -t | --template | --hostname | --cache | -p | --preview) shift ;;
      -*) ;;
      *) [ -n "$endpoint" ] || endpoint=$a ;;
    esac
    if [ -n "$v" ]; then
      case "$(lc "$v")" in event=approve) approve=1 ;; esac
      case "$v" in *=@*) file_field=1 ;; esac
    fi
  done
  method=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
  if [ -z "$method" ]; then
    if [ "$fields" = 1 ] || [ -n "$input" ]; then method=POST; else method=GET; fi
  fi
  ep=$(normalize_endpoint "$endpoint")

  if [ "$ep" = "graphql" ]; then
    check_graphql_text "$RAW"
    if [ -z "$BLOCKED" ] && { [ "$file_field" = 1 ] || { [ -n "$input" ] && [ "$input" != "-" ]; }; }; then
      block "a GraphQL query read from a file cannot be checked; pass it inline"
    elif [ -z "$BLOCKED" ] && [ "$input" = "-" ]; then
      case "$SEG_STDIN_KIND" in
        static) check_graphql_text "$(lc "$SEG_STDIN")" ;;
        *) block "a GraphQL query on stdin that is not a heredoc, here-string or echo cannot be checked; pass it inline" ;;
      esac
    fi
    return
  fi

  case "$method" in GET | HEAD) return ;; esac
  if [[ $ep =~ ^repos/[^/]+/[^/]+/dispatches$ ]]; then
    block "gh api $method $endpoint sends a repository dispatch, which can start any workflow"
    return
  fi
  case "$ep" in
    *pulls/*/merge | merges | */merges) block "gh api $method $endpoint merges" ;;
    *pulls/*/reviews*)
      if [ "$approve" = 1 ]; then
        block "gh api $method $endpoint approves a pull request"
      elif [ "$file_field" = 1 ]; then
        block "a review field read from a file cannot be checked for event=APPROVE; pass it inline"
      elif [ "$input" = "-" ]; then
        case "$SEG_STDIN_KIND" in
          static) [[ $(lc "$SEG_STDIN") =~ \"event\"[[:space:]]*:[[:space:]]*\"approve\" ]] && block "gh api $method $endpoint approves a pull request" ;;
          # A file, a pipe, or stdin from outside this command (`bash -c '...' < x`): it cannot be read here.
          *) block "a review payload on stdin from a file or a pipe cannot be checked for event=APPROVE" ;;
        esac
      elif [ -n "$input" ]; then
        block "a review payload read from a file cannot be checked for event=APPROVE; pass it inline"
      fi
      ;;
    */git/refs | */git/refs/*) block "gh api $method $endpoint creates, moves or deletes a branch or tag (a force-push or a tag)" ;;
    */releases | */releases/*) block "gh api $method $endpoint changes a release (use gh release create/edit, which asks the developer)" ;;
    */actions/runs/*/pending_deployments* | */actions/runs/*/approve | */actions/runs/*/deployment_protection_rule*)
      block "gh api $method $endpoint approves a deployment or a workflow run"
      ;;
    */rulesets* | */branches/*/protection* | */environments*) block "gh api $method $endpoint changes the merge or deploy gate" ;;
    */contents/*) block "gh api $method $endpoint writes a file on GitHub without a push" ;;
    */actions/workflows/deploy*) block "gh api $method $endpoint runs a deploy workflow" ;;
    */actions/workflows/[0-9]*/dispatches) block "gh api $method $endpoint runs a workflow by numeric ID, which cannot be checked" ;;
  esac
}

check_gh() {
  local -a pos=()
  local a skip=0 i=0 api_at=-1 flag
  local -a all=("$@")
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; i=$((i + 1)); continue; fi
    case "$a" in
      -R | --repo | --hostname) skip=1 ;;
      -*) ;;
      *)
        pos+=("$a")
        if [ "${#pos[@]}" = 1 ] && [ "$a" = "api" ]; then api_at=$i; fi
        ;;
    esac
    i=$((i + 1))
  done
  local p0=${pos[0]:-} p1=${pos[1]:-}
  case "$p0 $p1" in
    "api "*) ;; # endpoints use {owner}/{repo}
    *[{}]*) block "brace expansion in a gh subcommand cannot be checked"; return ;;
  esac
  case "$p0 $p1" in
    "pr merge") block "gh pr merge merges a pull request" ;;
    "pr review")
      for flag in "$@"; do
        case "$flag" in
          --approve | --approve=*) block "gh pr review --approve approves a pull request" ;;
          --*) ;;
          -*) short_group_has_approve "$flag" && block "gh pr review -a approves a pull request" ;;
        esac
      done
      ;;
    "release delete" | "release delete-asset") block "gh release $p1 deletes a release" ;;
    "auth token") block "gh auth token prints the GitHub token" ;;
    "config get")
      for flag in "$@"; do
        case "$(lc "$flag")" in *token*) block "gh config get $flag prints a token" ;; esac
      done
      ;;
    "auth status")
      for flag in "$@"; do
        case "$flag" in
          --show-token*) block "gh auth status --show-token prints the GitHub token" ;;
          --*) ;;
          -*t*) block "gh auth status -t prints the GitHub token" ;;
        esac
      done
      ;;
    "auth git-credential") block "gh auth git-credential prints the GitHub token" ;;
    "alias set" | "alias import") block "gh alias $p1 could hide a merge, approve or release behind a new name" ;;
    "workflow run") check_gh_workflow_run "$@" ;;
    "repo sync")
      for flag in "$@"; do
        case "$flag" in --force | --force=*) block "gh repo sync --force overwrites a branch, like a force-push" ;; esac
      done
      ;;
    "pr update-branch")
      for flag in "$@"; do
        case "$flag" in --rebase | --rebase=*) block "gh pr update-branch --rebase rewrites the branch, like a force-push" ;; esac
      done
      ;;
  esac
  if [ "$p0" = "api" ] && [ "$api_at" -ge 0 ]; then
    check_gh_api "${all[@]:$((api_at + 1))}"
  fi
}

# short_group_has_approve -GROUP: pflag reads `-ab x` as -a -b x and `-ba` as -b a, so walk the
# group: an `a` before a value-taking flag (-b body, -F body-file, -R repo) is --approve.
short_group_has_approve() {
  local g=${1#-} c
  [ "${#g}" -le 64 ] || return 1
  while [ -n "$g" ]; do
    c=${g:0:1}
    g=${g:1}
    case "$c" in
      a) return 0 ;;
      b | F | R | =) return 1 ;;
    esac
  done
  return 1
}

# gh workflow run [flags] <workflow> [flags]: flags and their values can come before the workflow.
check_gh_workflow_run() {
  local a seen=0 workflow=""
  while [ $# -gt 0 ]; do
    a=$1
    shift
    case "$a" in
      -R | --repo | --hostname | -r | --ref | -f | -F | --field | --raw-field | --json) shift; continue ;;
      -*) continue ;;
    esac
    if [ "$seen" -lt 2 ]; then seen=$((seen + 1)); continue; fi # "workflow" "run"
    [ -n "$workflow" ] || workflow=$a
  done
  cmd_name "$workflow"
  NAME=$(lc "$NAME")
  case "$NAME" in
    deploy*) block "gh workflow run $workflow deploys" ;;
    *[!0-9]* | "") ;;
    *) block "gh workflow run by numeric ID cannot be checked; name the workflow file" ;;
  esac
}

# Any request to the GitHub API outside gh that is not plainly a read: use gh, which this hook can read.
# A method flag, a body or a form in any spelling (short groups such as -sX or -sd too) counts as a write,
# and so does httpie unless it names GET or HEAD, since it sends whatever is on its stdin as the body.
check_http() {
  local cmd=$1 a hit=0 write=0 verb=""
  shift
  for a in "$@"; do
    case "$(lc "$a")" in *api.github.com* | *uploads.github.com*) hit=1 ;; esac
  done
  [ "$hit" = 1 ] || return
  for a in "$@"; do
    case "$a" in
      --request* | --method* | --data* | --form* | --json* | --upload-file* | --post-* | --body* | --raw*) write=1 ;;
      --*) ;;
      -*[XdFTE]*) write=1 ;;
      -*) ;;
      *)
        case "$cmd" in
          http | https)
            case "$(lc "$a")" in
              get | head) [ -n "$verb" ] || verb="read" ;;
              *github.com*) ;;
              *:=* | *=* | *@*) write=1 ;; # a data item (x=y, x:=y, x@file)
              *:*) ;;                      # a header (Name:value)
              *) write=1 ;;                # another verb
            esac
            ;;
        esac
        ;;
    esac
  done
  case "$cmd" in http | https) [ "$verb" = read ] || write=1 ;; esac
  [ "$write" = 1 ] && block "$cmd writes to the GitHub API outside gh, or cannot be checked"
}

# find NAMES-A-SECRET -exec ... / -print0 / piped / inside $(...): it hands the secret on.
check_find() {
  local meta=$1 depth=$2
  shift 2
  local secret=0 hands_on=0 a v
  local -a ex
  [[ ${meta:1:1} == p || ${meta:2:1} == s ]] && hands_on=1
  while [ $# -gt 0 ]; do
    a=$1
    shift
    case "$a" in
      -name | -iname | -path | -ipath | -wholename | -iwholename | -regex | -iregex)
        v=${1:-}
        shift
        find_pattern_secret "$a" "$v" && secret=1
        ;;
      -exec | -execdir | -ok | -okdir)
        hands_on=1
        ex=()
        while [ $# -gt 0 ] && [ "$1" != ";" ] && [ "$1" != "+" ]; do ex+=("$1"); shift; done
        [ $# -gt 0 ] && shift
        [ "${#ex[@]}" -gt 0 ] && check_segment "$depth" "---" "" "${ex[@]}"
        ;;
      -print0 | -fprint | -fprint0 | -fprintf | -fls | -printf) hands_on=1 ;;
      -*) ;;
      *) is_secret_path "$a" && secret=1 ;;
    esac
  done
  if [ "$secret" = 1 ] && [ "$hands_on" = 1 ]; then
    block "find hands a secret file to another command"
  fi
}

find_pattern_secret() {
  local flag=$1 pat=$2 cand
  case "$pat" in *"$DY"*) return 0 ;; esac # a pattern from a variable: assume the worst
  case "$flag" in
    -regex | -iregex)
      for cand in ./backend/.env ./.env /home/u/.ssh/id_rsa /home/u/.forge-token /home/u/.claude/.credentials.json /home/u/.config/mroom/secrets/forge-token; do
        [[ $cand =~ $pat ]] && return 0
      done
      ;;
    -name | -iname)
      [ "$flag" = -iname ] && pat=$(lc "$pat")
      for cand in .env .env.local .env.testing .env.production .envrc .forge-token .credentials.json id_rsa id_ed25519 hosts.yml forge-token mcp.env; do
        # shellcheck disable=SC2053 # $pat is a glob on purpose
        [[ $cand == $pat ]] && return 0
      done
      ;;
    *)
      [[ $flag == -i* ]] && pat=$(lc "$pat")
      for cand in ./backend/.env ./.env /home/u/.ssh/id_rsa /home/u/.ssh/id_ed25519 /home/u/.config/gh/hosts.yml /home/u/.forge-token /home/u/.claude/.credentials.json /home/u/.config/mroom/secrets/forge-token /home/u/.config/tool/mcp.env; do
        # shellcheck disable=SC2053 # $pat is a glob on purpose
        [[ $cand == $pat ]] && return 0
      done
      ;;
  esac
  return 1
}

# git: shell aliases (`!cmd`), config keys that run a command, and working-tree secrets.
check_git() {
  local depth=$1
  shift
  local a v sub="" k aliases=""
  local -a rest=()
  while [ $# -gt 0 ]; do
    a=$1
    shift
    v=""
    case "$a" in
      -c) v=${1:-}; shift ;;
      -c*) v=${a#-c} ;;
      --config-env | --config-env=*) block "git --config-env sets configuration from the environment, which cannot be checked" ;;
      -C | --git-dir | --work-tree | --namespace) shift ;;
      -*) ;;
      *) sub=$a; rest=("$@"); break ;;
    esac
    if [ -n "$v" ]; then
      check_git_config_pair "$depth" "$v"
      # An alias defined here and used as this command's subcommand: remembered, to check what it runs.
      case "$(lc "${v%%=*}")" in alias.*) aliases+="$(lc "${v%%=*}")=${v#*=}$US" ;; esac
    fi
  done
  [ -n "$BLOCKED" ] && return
  if [ -n "$aliases" ] && [ -n "$sub" ]; then
    local -a defs
    local def
    IFS=$US read -r -a defs <<<"$aliases"
    for def in "${defs[@]}"; do
      if [ "${def%%=*}" = "alias.$(lc "$sub")" ]; then
        analyze "git ${def#*=} $(printf '%q ' ${rest[@]+"${rest[@]}"})" $((depth + 1))
        return
      fi
    done
  fi
  for a in ${rest[@]+"${rest[@]}"}; do
    case "$a" in
      --upload-pack* | --receive-pack*) block "git $sub $a runs a command of its choice"; return ;;
    esac
  done
  case "$sub" in
    rebase | difftool | mergetool | filter-branch)
      # rebase -x/--exec, difftool -x/--extcmd and filter-branch --*-filter run a command they are given.
      for ((k = 0; k < ${#rest[@]}; k++)); do
        case "${rest[$k]}" in
          -x | --exec | --extcmd | --*-filter) analyze "${rest[$((k + 1))]:-}" $((depth + 1)) ;;
          --exec=* | --extcmd=* | --*-filter=*) analyze "${rest[$k]#*=}" $((depth + 1)) ;;
          -x*) analyze "${rest[$k]#-x}" $((depth + 1)) ;;
        esac
      done
      ;;
    submodule | bisect)
      # submodule foreach COMMAND, bisect run COMMAND...
      for ((k = 0; k < ${#rest[@]}; k++)); do
        case "${rest[$k]}" in
          foreach | run)
            local -a run_words=("${rest[@]:$((k + 1))}")
            while [ "${#run_words[@]}" -gt 0 ] && [[ ${run_words[0]} == -* ]]; do run_words=("${run_words[@]:1}"); done
            # foreach hands its words to a shell, joined: check them the same way.
            [ "${#run_words[@]}" -gt 0 ] && analyze "${run_words[*]}" $((depth + 1))
            break
            ;;
        esac
      done
      ;;
  esac
  [ -n "$BLOCKED" ] && return
  case "$sub" in
    config) check_git_config_set "$depth" ${rest[@]+"${rest[@]}"} ;;
    push) check_git_push ${rest[@]+"${rest[@]}"} ;;
    credential | credential-*) block "git $sub reads or stores a credential" ;;
    send-pack) block "git send-pack pushes without git push, and can force"; return ;;
    diff | show | cat-file | grep | blame | add | hash-object | update-index | archive)
      for ((k = 0; k < ${#rest[@]}; k++)); do
        a=${rest[$k]}
        case "$a" in
          :*) ;;                 # :path (or :N:path) is the index, which holds what was added from the working tree
          -* | *:*) continue ;;  # REV:path is committed content
        esac
        a=${a##*:}
        if is_secret_path "$a"; then
          block "git $sub would read a secret file ($a)"
          return
        fi
      done
      ;;
  esac
}

# Git config keys whose value is a command git runs (or, for core.hooksPath, a directory of them).
is_git_command_key() {
  case "$1" in
    core.pager | core.editor | core.sshcommand | core.fsmonitor | core.hookspath | core.askpass | sequence.editor | diff.external | gpg.program | gpg.*.program | credential.helper | credential.*.helper | remote.*.receivepack | remote.*.uploadpack | *.command | *.cmd | *.textconv | filter.* | merge.*.driver | interactive.difffilter | uploadpack.packobjectshook) return 0 ;;
  esac
  return 1
}

# git -c KEY=VALUE for one command: a shell alias or a hooks directory is refused, a command value
# is checked as a command (so `-c core.editor=true` still works).
check_git_config_pair() {
  local depth=$1 pair=$2 key value
  [ "${#pair}" -le 4096 ] || { block "a git -c value too long to check"; return; }
  key=$(lc "${pair%%=*}")
  value=${pair#*=}
  case "$key" in
    alias.*)
      if [ "${value:0:1}" = "!" ]; then
        block "git -c $key defines a shell alias (!...), which can run anything"
      else
        check_git_alias "$depth" "$value"
      fi
      ;;
    core.hookspath) block "git -c core.hooksPath runs hooks from a directory this hook cannot read" ;;
    *)
      if is_git_push_key "$key" "$value"; then
        block "git -c $key changes what a push does, or loads configuration from elsewhere"
      elif is_git_command_key "$key"; then
        analyze "${value#!}" $((depth + 1))
      fi
      ;;
  esac
}

# git config ... KEY VALUE (any scope, the old and the `set` syntax): setting a key that runs a
# command, or a shell alias, is refused; reading, listing and unsetting pass.
check_git_config_set() {
  local depth=$1
  shift
  local -a ops=()
  local a key value read=0
  while [ $# -gt 0 ]; do
    a=$1
    shift
    # After a key, the next word is its value, even one that starts with a dash (`alias.p '--no-pager push'`).
    if [ "${#ops[@]}" -ge 1 ] && [[ ${ops[${#ops[@]} - 1]} == *.* ]] && [[ $a == -* ]]; then
      ops+=("$a")
      continue
    fi
    case "$a" in
      --get | --get-all | --get-regexp | --get-urlmatch | --list | -l | --unset | --unset-all | --remove-section | --rename-section | --edit | -e) read=1 ;;
      -f | --file | --blob | --type | --default | --comment | -t) shift ;;
      -*) ;;
      *) ops+=("$a") ;;
    esac
  done
  [ "$read" = 1 ] && return
  case "${ops[0]:-}" in
    get | list | unset | remove-section | rename-section | edit) return ;;
    set) key=${ops[1]:-}; value=${ops[2]:-}; [ "${#ops[@]}" -ge 3 ] || return ;;
    *) key=${ops[0]:-}; value=${ops[1]:-}; [ "${#ops[@]}" -ge 2 ] || return ;;
  esac
  key=$(lc "$key")
  case "$key" in
    alias.*)
      if [ "${value:0:1}" = "!" ]; then
        block "git config defines a shell alias (!...), which can run anything"
      else
        check_git_alias "$depth" "$value"
      fi
      ;;
    *)
      if is_git_command_key "$key"; then
        block "git config sets $key, which makes git run a command"
      elif is_git_push_key "$key" "$value"; then
        block "git config sets $key, which changes what a later push does, or loads configuration from elsewhere"
      fi
      ;;
  esac
}

# Git config keys that change what a plain `git push` does: a refspec (which can start with +), mirroring,
# and pushing tags.
is_git_push_key() {
  case "$1" in
    # Configuration loaded from another file can set any key above, out of sight.
    include.path | includeif.*.path) return 0 ;;
    remote.*.push | remote.*.mirror | push.followtags | push.pushoption) return 0 ;;
    # matching pushes every branch that exists on both sides, the default branch too; upstream (tracking)
    # pushes to whatever branch the current one tracks, which can be main.
    push.default) case "$(lc "$2")" in matching | upstream | tracking) return 0 ;; esac ;;
    branch.*.merge | branch.*.pushremote | remote.pushdefault) return 0 ;;
  esac
  return 1
}

# A git alias that is not a shell alias runs a git subcommand: check it as `git VALUE`, so `push -f` behind a
# new name is refused too.
check_git_alias() {
  [ "${#2}" -le 4096 ] || { block "a git alias too long to check"; return; }
  # An alias for push itself would take its options where this hook no longer sees them (`git p --force`),
  # even behind git's own options (`--no-pager push`, `-C . push`).
  case " $(lc "$2") " in
    *" push "* | *" send-pack "*) block "a git alias for push hides the options a later push passes it"; return ;;
  esac
  analyze "git $2" $(($1 + 1))
}

# Branch names a push must never update (the default branch, and the branch a deploy points at the release
# tag, design section 10), and tag names that look like releases (v1.2, v1.2.3, release-v1.2.3).
is_protected_ref() {
  local r
  r=$(lc "$1")
  r=${r#refs/}
  r=${r#heads/}
  case "$r" in
    main | master | release) return 0 ;;
    tags/* | v[0-9]*.[0-9]* | release-v*) return 0 ;;
  esac
  return 1
}

# git push [options] [remote [refspec...]]: any form of force (git takes a long option's unambiguous
# abbreviation, so `--forc` is `--force`), a mirror, tags, or a push to a protected branch.
check_git_push() {
  local a g c npos=0 src dst
  while [ $# -gt 0 ]; do
    a=$1
    shift
    case "$a" in
      --no-*) continue ;;
      --for* | --m*) block "git push $a force-pushes"; return ;;
      --ta* | --fol*) block "git push $a pushes tags, which can start a release"; return ;;
      --al* | --b*) block "git push $a pushes every branch, the default branch too"; return ;;
      --pr*) block "git push $a deletes remote branches"; return ;;
      --rec* | --ex*) block "git push $a runs a command of its choice to receive the push"; return ;;
      # With --repo, every positional word is a refspec.
      --repo=*) npos=1; continue ;;
      --repo) shift; npos=1; continue ;;
      --push-option) shift; continue ;;
      --*) continue ;;
      -*)
        g=${a#-}
        [ "${#g}" -le 64 ] || { block "a git push option too long to check"; return; }
        while [ -n "$g" ]; do
          c=${g:0:1}
          g=${g:1}
          case "$c" in
            f) block "git push $a force-pushes"; return ;;
            o) [ -n "$g" ] || shift; break ;; # -o takes a value, glued or next
          esac
        done
        continue
        ;;
    esac
    npos=$((npos + 1))
    [ "$npos" = 1 ] && continue # the remote
    case "$a" in
      +*) block "git push $a force-pushes (a + refspec)"; return ;;
      *[\*\?\[]*) block "git push $a pushes by a pattern, which can reach a protected branch"; return ;;
      *"$DY"*) block "git push with a refspec from a variable cannot be checked"; return ;;
    esac
    src=${a%%:*}
    dst=${a#*:}
    if is_protected_ref "$dst" || { [ "$src" = "$a" ] && is_protected_ref "$src"; }; then
      block "git push $a updates a protected branch or pushes a tag"
      return
    fi
  done
}

# NAME=value (or NAME+=value) before a command. Git's config-in-the-environment and SSH command
# variables are refused outright (they can set any key above, invisibly); command-valued ones
# (pagers, editors) are checked as commands; BASH_ENV/ENV naming a secret is a read.
check_assignment() {
  local depth=$1 word=$2 name value
  [ "${#word}" -le 4096 ] || return
  name=${word%%=*}
  name=${name%+}
  value=${word#*=}
  case "$name" in
    GIT_CONFIG_COUNT | GIT_CONFIG_KEY_* | GIT_CONFIG_VALUE_* | GIT_CONFIG_PARAMETERS | GIT_CONFIG | GIT_CONFIG_GLOBAL | GIT_CONFIG_SYSTEM | GIT_SSH_COMMAND | GIT_SSH)
      block "$name sets git configuration or its SSH command from the environment, which cannot be checked"
      ;;
    GIT_EXTERNAL_DIFF | GIT_PAGER | GIT_EDITOR | GIT_SEQUENCE_EDITOR | GIT_ASKPASS | SSH_ASKPASS | PAGER | EDITOR | VISUAL | PROMPT_COMMAND)
      analyze "$value" $((depth + 1))
      ;;
    BASH_ENV | ENV) is_secret_path "$value" && block "$name would source a secret file ($value)" ;;
    # Another home or config folder gives git (and gh) configuration this hook never sees.
    HOME | XDG_CONFIG_HOME) block "$name points git and gh at configuration this hook cannot read" ;;
  esac
}

# check_segment DEPTH META PREV_RECORD WORD...: one simple command, after taking out redirections
# and stripping wrappers. META comes from the tokeniser; PREV_RECORD is the command piping into it.
check_segment() {
  local depth=$1 meta=$2 prev=$3
  shift 3
  local -a words=()
  local a k base stdin="" stdin_kind="" stdin_file="" brace_list=0
  local -a raw=("$@")

  # Redirections can sit anywhere, even before the command word (`<<EOF bash`, `2>&1 gh ...`).
  for ((k = 0; k < ${#raw[@]}; k++)); do
    a=${raw[$k]}
    case "$a" in
      "${MK}HD" | "${MK}HS") k=$((k + 1)); stdin=${raw[$k]}; stdin_kind=static ;;
      "${MK}R<") k=$((k + 1)); stdin_file=${raw[$k]}; stdin_kind="file" ;;
      "${MK}R>")
        k=$((k + 1))
        # Writing git's own config or hooks changes what later git commands do, out of sight.
        case "/$(lc "${raw[$k]:-}")" in
          */.git/config | */.git/hooks/* | */.gitconfig | */.config/git/config)
            block "it writes git's configuration or hooks (${raw[$k]})"
            return
            ;;
        esac
        ;;
      "${MK}BL") brace_list=1 ;;
      "${MK}UE") block "a \$'...' escape (\\u, \\U or \\c) that cannot be decoded here"; return ;;
      *) words+=("$a") ;;
    esac
  done
  if [ -n "$stdin_file" ] && is_secret_path "$stdin_file"; then
    block "it reads a secret file ($stdin_file) through a redirection"
    return
  fi
  if [ -z "$stdin_kind" ] && [ "${meta:0:1}" = p ]; then
    if stdin=$(static_output "$prev"); then stdin_kind=static; else stdin_kind=pipe; fi
  fi
  # For the checks below that read stdin (gh api --input -).
  SEG_STDIN_KIND=$stdin_kind
  SEG_STDIN=$stdin

  set -- ${words[@]+"${words[@]}"}
  while [ $# -gt 0 ]; do
    [ -n "$BLOCKED" ] && return
    if [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*\+?= ]]; then
      check_assignment "$depth" "$1"
      shift
      continue
    fi
    cmd_name "$1"; base=$NAME
    case "$base" in
      sudo | doas)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -u | -g | -C | -h | -p | -U | -D | -r | -t | -T | -R | --user | --group | --chdir | --host | --prompt | --other-user | --role | --type | --command-timeout | --close-from | --chroot) shift ;; esac
          shift
        done
        ;;
      env)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* || $1 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
          case "$1" in
            -S | --split-string) analyze "${2:-}" $((depth + 1)); return ;;
            -S*) analyze "${1#-S}" $((depth + 1)); return ;;
            --split-string=*) analyze "${1#--split-string=}" $((depth + 1)); return ;;
            -*S*) block "env with -S in a group of options cannot be checked"; return ;;
            -u | -C | -P | --unset | --chdir) shift ;;
            -*) ;;
            *) check_assignment "$depth" "$1" ;;
          esac
          shift
        done
        ;;
      flock)
        # flock [options] FILE COMMAND... or flock [options] FILE -c 'COMMAND'.
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -w | --timeout | -E | --conflict-exit-code) shift ;; esac
          shift
        done
        [ $# -gt 0 ] && shift # the lock file
        case "${1:-}" in -c | --command) analyze "${2:-}" $((depth + 1)); return ;; esac
        ;;
      script | su | runuser | expect)
        # Each runs a -c string: a shell command, or for expect a Tcl script (checked as code). macOS
        # script takes its log file, then the command's words.
        shift
        local -a sargs=("$@")
        while [ $# -gt 0 ]; do
          case "$base:$1" in
            expect:-c) check_code "expect's script" "${2:-}"; return ;;
            *:-c | *:--command) analyze "${2:-}" $((depth + 1)); return ;;
          esac
          shift
        done
        [ "$base" = script ] || return
        set -- ${sargs[@]+"${sargs[@]}"}
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -t | -T | -F | -E | -I | -O) shift ;; esac
          shift
        done
        [ $# -gt 0 ] && shift # the log file
        [ $# -gt 0 ] || return
        ;;
      gdb)
        # gdb -ex 'shell CMD' (or '!CMD') runs a shell command.
        shift
        while [ $# -gt 0 ]; do
          case "$1" in
            -ex | -iex | --eval-command)
              case "${2:-}" in
                shell\ * | '!'*) a=${2#shell }; analyze "${a#!}" $((depth + 1)) ;;
              esac
              shift
              ;;
          esac
          shift
        done
        return
        ;;
      entr)
        # entr [-s 'CMD' | CMD...]: the command runs when files change.
        shift
        local entr_s=0
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -*s*) entr_s=1 ;; esac
          shift
        done
        if [ "$entr_s" = 1 ]; then analyze "${1:-}" $((depth + 1)); return; fi
        ;;
      screen | unshare | nsenter)
        # screen [-dmS NAME] COMMAND..., unshare [OPTIONS] COMMAND...
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in
            -S | -c | -L | -Logfile | -t | -T | -X | -p | --setgroups | --propagation | --target) shift ;;
            -*S) shift ;; # screen -dmS NAME
          esac
          shift
        done
        ;;
      parallel)
        # parallel COMMAND ::: ARGS: the command, with its arguments after ::: left out.
        shift
        local -a pcmd=()
        while [ $# -gt 0 ] && [ "$1" != ":::" ] && [ "$1" != "::::" ]; do pcmd+=("$1"); shift; done
        [ "${#pcmd[@]}" -gt 0 ] && analyze "${pcmd[*]}" $((depth + 1))
        return
        ;;
      xargs)
        # xargs runs a command with words from its stdin: when that is known, they are its arguments.
        shift
        while [ $# -gt 0 ] && [[ $1 == -* || $1 == '{}' ]]; do
          case "$1" in
            -a | --arg-file) is_secret_path "${2:-}" && { block "xargs -a reads a secret file (${2:-})"; return; } ;;
            -a* | --arg-file=*) is_secret_path "${1#*[a=]}" && { block "xargs -a reads a secret file"; return; } ;;
          esac
          case "$1" in -I | -n | -P | -L | -d | -E | -s | -a | --arg-file | --max-args | --max-procs | --max-lines | --delimiter | --eof | --max-chars | --replace) shift ;; esac
          shift
        done
        if [ "$stdin_kind" = static ] && [ "${#stdin}" -le 4096 ]; then
          local -a more
          read -r -d '' -a more <<<"$stdin" || true
          set -- "$@" ${more[@]+"${more[@]}"}
        fi
        ;;
      export | declare | typeset | readonly | local)
        # Each NAME=value is an assignment for every later command; there is no command to check.
        shift
        for a in "$@"; do
          [[ $a =~ ^[A-Za-z_][A-Za-z0-9_]*\+?= ]] && check_assignment "$depth" "$a"
        done
        return
        ;;
      trap)
        # trap 'COMMAND' SIGNAL...: the command runs later, in this shell.
        shift
        [ "${1:-}" = "--" ] && shift
        case "${1:-}" in -* | "") ;; *) analyze "$1" $((depth + 1)) ;; esac
        return
        ;;
      direnv | mise | rtx | asdf | op)
        # direnv exec DIR CMD, mise exec [TOOLS] -- CMD, asdf exec CMD, op run [OPTIONS] -- CMD.
        shift
        case "$base:${1:-}" in
          direnv:exec) shift; [ $# -gt 0 ] && shift ;;
          asdf:exec) shift ;;
          op:read | op:item | op:inject | op:document) block "op $1 reads a secret from the vault"; return ;;
          mise:exec | mise:x | rtx:exec | rtx:x | op:run)
            shift
            local -a after=()
            local seen_dd=0
            while [ $# -gt 0 ]; do
              if [ "$seen_dd" = 1 ]; then after+=("$1"); elif [ "$1" = "--" ]; then seen_dd=1; fi
              shift
            done
            [ "${#after[@]}" -gt 0 ] && set -- "${after[@]}"
            ;;
          *) return ;;
        esac
        ;;
      uv)
        # uv run [OPTIONS] CMD
        shift
        [ "${1:-}" = run ] || return
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in --with | --python | -p | --project | --directory | --package | --env-file | --extra | --group) shift ;; esac
          shift
        done
        ;;
      strace | ltrace)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -o | -p | -e | -s | -u | -E | -a | -b | -I | -O | -P | -S | -X) shift ;; esac
          shift
        done
        ;;
      chrt | taskset)
        # chrt [OPTIONS] PRIORITY CMD, taskset [OPTIONS] MASK CMD.
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do shift; done
        [ $# -gt 0 ] && shift
        ;;
      systemd-run)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -p | --property | -E | --setenv | -u | --unit | --uid | --gid | -M | --machine | --description | --slice | -H | --host) shift ;; esac
          shift
        done
        ;;
      tmux)
        # tmux new-session/new-window/split-window/respawn-pane/send-keys ... 'COMMAND': each word a command.
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in
            -c) analyze "${2:-}" $((depth + 1)); return ;; # tmux -c COMMAND runs it in a shell
            -L | -S | -f) shift ;;
          esac
          shift
        done
        case "${1:-}" in
          new | new-session | neww | new-window | splitw | split-window | respawn-pane | respawnp | respawn-window | respawnw | send-keys | send | run-shell | run)
            # The words after the options are one shell command, joined.
            shift
            local -a twords=()
            while [ $# -gt 0 ]; do
              case "$1" in
                -s | -n | -t | -c | -x | -y | -F | -e | -l | -w | -h | -T) shift ;;
                -*) ;;
                *) twords+=("$1") ;;
              esac
              shift
            done
            [ "${#twords[@]}" -gt 0 ] && analyze "${twords[*]}" $((depth + 1))
            ;;
        esac
        return
        ;;
      at | batch)
        # at reads its commands from stdin (or -f FILE) and runs them later.
        case "$stdin_kind" in
          static) analyze "$stdin" $((depth + 1)) ;;
          *) block "$base reading commands from a file or a pipe cannot be checked" ;;
        esac
        return
        ;;
      function | coproc)
        # function NAME { ...; } and coproc [NAME] COMMAND: the body is the command.
        shift
        [ "$base" = function ] && [ $# -gt 0 ] && shift
        ;;
      command | builtin | exec | nohup | time | nice | ionice | stdbuf | caffeinate | unbuffer | timeout | gtimeout | setsid | chronic | busybox | then | do | else | elif | if | while | until | '!' | '{' | '}' | '[[' | npx | bunx | arch | noglob | nocorrect)
        # Each wrapper's own options, and which of them take a value: anything else after them is the command.
        local takes=""
        case "$base" in
          exec) takes=" -a " ;;
          time) takes=" -f -o --format --output " ;;
          nice) takes=" -n --adjustment " ;;
          ionice) takes=" -c -n --class --classdata " ;;
          stdbuf) takes=" -i -o -e --input --output --error " ;;
          caffeinate) takes=" -t -w " ;;
          timeout | gtimeout) takes=" -s -k --signal --kill-after " ;;
          npx | bunx) takes=" -p --package " ;;
          arch) takes=" -arch " ;;
        esac
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$base:$1" in
            npx:-c | npx:--call | bunx:-c) analyze "${2:-}" $((depth + 1)); return ;;
            npx:--call=*) analyze "${1#--call=}" $((depth + 1)); return ;;
          esac
          case "$takes" in *" $1 "*) shift ;; esac
          shift
        done
        case "$base" in
          timeout | gtimeout) [ $# -gt 0 ] && shift ;; # the duration
        esac
        ;;
      pnpm | yarn | npm | bun)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -C | --dir | --filter | -F | -w | --workspace | -p | --package) shift ;; esac
          shift
        done
        case "${1:-}" in exec | dlx | x | run) shift ;; esac
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in
            -c | --call | --shell-mode) analyze "${2:-}" $((depth + 1)); return ;;
            --call=*) analyze "${1#--call=}" $((depth + 1)); return ;;
            -p | --package) shift ;;
          esac
          shift
        done
        ;;
      watch)
        shift
        while [ $# -gt 0 ] && [[ $1 == -* ]]; do
          case "$1" in -n | --interval | -d) shift ;; esac
          shift
        done
        analyze "$*" $((depth + 1))
        return
        ;;
      eval)
        shift
        analyze "$*" $((depth + 1))
        return
        ;;
      *)
        case "$SHELLS" in
          *" $base "*) shift; SHELL_NAME=$base; check_shell "$depth" "$stdin_kind" "$stdin" "$@"; return ;;
        esac
        break
        ;;
    esac
  done
  [ $# -gt 0 ] || return
  local cmd
  cmd_name "$1"; cmd=$NAME
  shift
  case "$cmd" in
    *"$DY"*) check_gh "$@" ;; # a command from a variable: at least catch `$GH pr merge`
  esac
  if [ "${#cmd}" -le 4096 ]; then
    case "$cmd" in *[{}]*,*) block "brace expansion in a command name cannot be checked"; return ;; esac
  fi
  [ -n "$BLOCKED" ] && return
  # A brace list in an argument (`cat {.env,}`, `.env{,}`) expands to names this hook never sees.
  if [ "$brace_list" = 1 ]; then
    case "$READERS$INTERPRETERS gh git find " in
      *" $cmd "*) block "brace expansion in a $cmd argument cannot be checked"; return ;;
    esac
  fi
  case "$cmd" in
    git-credential-*) block "$cmd reads or stores a credential"; return ;;
    security)
      case "${1:-}" in
        find-generic-password | find-internet-password | find-key | find-certificate | dump-keychain | export | export-keychain)
          block "security $1 reads the keychain"
          return
          ;;
      esac
      ;;
  esac

  case "$INTERPRETERS" in
    *" $cmd "* | *" ${cmd%%[0-9.]*} "*) check_interpreter "$cmd" "$stdin_kind" "$stdin" "$@"; return ;; # python3.12, php8.3
  esac
  case "$cmd" in
    gh) check_gh "$@" ;;
    git) check_git "$depth" "$@" ;;
    curl | wget | http | https) check_http "$cmd" "$@" ;;
    printenv)
      for a in "$@"; do
        case "$(lc "$a")" in *token* | *secret* | *password* | *_key | *apikey*) block "printenv $a prints a secret"; return ;; esac
      done
      ;;
    find) check_find "$meta" "$depth" "$@" ;;
    cd | pushd)
      # Into a secret folder, a file there is read by its bare name (`cd ~/.ssh && cat id_rsa`).
      for a in "$@"; do
        case "$a" in -*) continue ;; esac
        is_secret_path "$a/x" && { block "$cmd into a folder of secret files ($a)"; return; }
        break
      done
      ;;
    source | .)
      for a in "$@"; do
        [ "$a" = "${MK}PS" ] && block "$cmd of a process substitution cannot be checked"
      done
      if is_stdin_path "${1:-}"; then
        case "$stdin_kind" in
          static) analyze "$stdin" $((depth + 1)) ;;
          *) block "$cmd of stdin it cannot read cannot be checked" ;;
        esac
      fi
      ;;
    awk | gawk | mawk | nawk)
      # awk runs commands through system() and pipes: such a program is checked as code. (Its files are
      # checked as reads below; sed's rarely used e command is not checked.)
      local skipv=0
      for a in "$@"; do
        if [ "$skipv" = 1 ]; then skipv=0; continue; fi
        case "$a" in
          -v | -F | -f | --assign | --field-separator | --file) skipv=1; continue ;;
          -*) continue ;;
        esac
        case "$a" in
          *system* | *'|'*) check_code "$cmd's program" "$a" ;;
          # getline < "file" reads a file the program names.
          *) mentions_secret "$a" && block "$cmd's program names a secret file" ;;
        esac
        break
      done
      ;;
  esac
  [ -n "$BLOCKED" ] && return
  check_secrets "$cmd" "$@"
}

# is_stdin_path PATH: a name for standard input, which a shell or `source` reads as its script.
is_stdin_path() {
  case "$1" in /dev/stdin | /dev/fd/0 | /proc/self/fd/0 | /dev/fd/0/) return 0 ;; esac
  return 1
}

# check_shell DEPTH STDIN_KIND STDIN ARG...: bash/sh/zsh with -c, a script file, or stdin.
check_shell() {
  local depth=$1 stdin_kind=$2 stdin=$3
  shift 3
  local a script="" has_c=0 from_stdin=0 file="" skip=0 opts=1
  # Options first: short groups (-ec, +x), and -o/+o/-O/+O whose next word is an option name, not
  # a script. The first other word is the -c string or the script file.
  local init_next=0
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    if [ "$init_next" = 1 ]; then init_next=0; analyze "$a" $((depth + 1)); continue; fi
    if [ "$opts" = 1 ] && [ "$SHELL_NAME" = pwsh ]; then
      # PowerShell's options, matched without case: -Command (and its abbreviations, -c) is the command,
      # -File the script, an encoded command cannot be read, and a few take a value.
      case "$(lc "$a")" in
        -configurationname | -configurationfile | -cnf | -workingdirectory | -wd | -executionpolicy | -ep | \
          -outputformat | -of | -inputformat | -if | -settingsfile | -custompipename) skip=1; continue ;;
        -c | -co*) has_c=1; continue ;;
        -e | -ec | -en*) block "pwsh's encoded command cannot be checked"; return ;;
        -f | -file) opts=0; continue ;;
        -*) continue ;;
      esac
    fi
    if [ "$opts" = 1 ]; then
      case "$a" in
        --) opts=0; continue ;;
        --rcfile | --init-file) skip=1; continue ;;
        # fish: --command, and -C/--init-command, which runs before anything else.
        --command=* | --init-command=*) analyze "${a#*=}" $((depth + 1)); [ "${a%%=*}" = --command ] && return; continue ;;
        --command) has_c=1; continue ;;
        --init-command) init_next=1; continue ;;
        -C) [ "$SHELL_NAME" = fish ] && init_next=1; continue ;;
        --*) continue ;;
        - ) from_stdin=1; opts=0; continue ;;
        [-+]*)
          case "$a" in *[oO]*) skip=1 ;; esac
          case "$a" in -*c*) has_c=1 ;; esac
          case "$a" in -*s*) from_stdin=1 ;; esac
          continue
          ;;
      esac
      opts=0
    fi
    if [ "$has_c" = 1 ]; then
      [ -n "$script" ] || script=$a
    else
      [ -n "$file" ] || file=$a
    fi
  done
  if [ "$has_c" = 1 ]; then
    [ -n "$script" ] && analyze "$script" $((depth + 1))
    return
  fi
  if [ "$file" = "${MK}PS" ]; then
    block "a shell running a process substitution cannot be checked"
    return
  fi
  is_stdin_path "$file" && { file=""; from_stdin=1; }
  if [ -n "$file" ] && is_secret_path "$file"; then
    block "a shell would run (and with -x or -v print) a secret file ($file)"
    return
  fi
  [ -n "$file" ] && [ "$from_stdin" = 0 ] && return # a script file: not read here
  case "$stdin_kind" in
    static) analyze "$stdin" $((depth + 1)) ;;
    file) block "a shell reading commands from a file through < cannot be checked" ;;
    pipe) block "a shell reading commands from a pipe it cannot read (only echo, printf and cat of a heredoc can be checked)" ;;
  esac
}

# check_interpreter CMD STDIN_KIND STDIN ARG...: python -c / php -r / node -e code, or code on stdin.
check_interpreter() {
  local cmd=$1 stdin_kind=$2 stdin=$3
  shift 3
  local a inline=0
  for a in "$@"; do
    case "$a" in
      -c | -e | -E | -r | -p | --eval | --print | --eval=* | --print=* | -m | -f | eval | run) inline=1 ;;
      -*) ;;
    esac
    check_code "inline $cmd code" "$a"
    [ -n "$BLOCKED" ] && return
  done
  # Code on stdin is checked whether or not a script is named too (`php artisan tinker <<EOF`).
  if [ "$inline" = 0 ] && [ "$stdin_kind" = static ]; then
    check_code "$cmd code on stdin" "$stdin"
  fi
}

# analyze STRING DEPTH: tokenise STRING and check each simple command.
analyze() {
  local s=$1 depth=$2 out rec prev="" status=0
  [ "$depth" -le 8 ] || { block "the command nests shells too deeply to check"; return; }
  out=$(printf '%s' "$s" | "$AWK" -f "$TOKENIZER") || status=$?
  if [ "$status" != 0 ]; then
    block "the command could not be parsed to check it"
    return
  fi
  [ -n "$out" ] || return
  local -a f
  while IFS= read -r rec; do
    [ -n "$BLOCKED" ] && return
    COMMANDS=$((COMMANDS + 1))
    if [ "$COMMANDS" -gt "$MAX_COMMANDS" ]; then
      block "the command has more than $MAX_COMMANDS simple commands, too many to check in time"
      return
    fi
    IFS=$US read -r -a f <<<"$rec"
    check_segment "$depth" "${f[0]}" "$prev" "${f[@]:1}"
    prev=$rec
  done <<<"$out"
}

if [ ! -r "$TOKENIZER" ]; then
  block "its tokeniser ($TOKENIZER) is missing"
elif [ "${#command}" -gt "$MAX_BYTES" ]; then
  block "the command is over $MAX_BYTES bytes, too long to check in time"
else
  analyze "$command" 0
fi

if [ -n "$BLOCKED" ]; then
  {
    echo "Refused by mroom guard: $BLOCKED."
    echo "Agents never merge, approve, release, force-push or read secrets; a person does that."
    echo "Stop and ask a person to run it themselves if it is really needed."
  } >&2
  exit 2
fi
[ "$mode" = check ] && echo allowed
exit 0
