#!/usr/bin/env bash
# gate — the one way CI reaches the box (design 8.2). sshd runs `mroom gate <role>` instead of whatever
# the client asked for, through a line in the box user's ~/.ssh/authorized_keys:
#
#   restrict,command="/home/forge/.local/bin/mroom gate provision" ssh-ed25519 AAAA… mroom-qa-up
#
# The request comes from SSH_ORIGINAL_COMMAND: one line of plain words, split without any expansion,
# checked word by word and never passed to a shell. No CI key gets a shell. A role runs only its own
# operations:
#
#   provision   db-create <N>          a database and a role of its own for QA environment N (D18); prints
#                                      DB_DATABASE, DB_USERNAME and a new DB_PASSWORD for its .env
#               db-drop <N>            the environment's database and its role
#               redis-user-add <N>     a Redis user of its own, limited to its prefix (D15); prints
#                                      REDIS_USERNAME, a new REDIS_PASSWORD, REDIS_PREFIX, HORIZON_PREFIX
#               redis-user-remove <N>  the environment's Redis user, and its connections
#               redis-clear <N>        every key under the environment's prefix, in every database
#               code-put <N> <commit>  the PR's tree, GitHub's tarball of that commit on stdin, into the
#                                      environment's API site (D17); the gate records the commit
#               dist-put <N>           the frontend's built files, a tarball on stdin, into its web site
#               env-put <N>            the API site's .env, on stdin, written as the site user, so a link
#                                      the PR's code left there is replaced, never followed; prints env=<SHA>
#               env-sha <N>            env=<the SHA-256 of the API site's .env, or missing> and
#                                      commit=<the commit code-put recorded, or none>
#               signin-code <N> <email>  a sign-in code from the app, for a persona address only
#               user-clean <N>         stops the site user's processes (PHP-FPM's pool workers end with the
#                                      site) and deletes its files in /tmp, /var/tmp, /dev/shm, /var/crash,
#                                      /run/lock and /dev/mqueue, its IPC objects and its crontab
#               mail-user-add <N>      an SMTP login of its own on the box's Mailpit (D19), while mroom's mail
#                                      relay holds the SMTP port; prints MAIL_MAILER, MAIL_HOST, MAIL_PORT,
#                                      MAIL_USERNAME and a new MAIL_PASSWORD
#               mail-user-remove <N>   the environment's SMTP login
#               mail-read <N> <email>  the newest five mails its login sent to persona addresses alone, as JSON
#               mail-clear <N>         every mail its login sent
#               bucket-create <N> <disk> [public]
#                                      a bucket on the box's Garage (D14) for one of the app's file disks,
#                                      and a new key that reaches that bucket alone; public turns on its
#                                      website access. Prints BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY,
#                                      REGION, ENDPOINT, PATH_STYLE, and URL for a public one
#               bucket-drop <N>        every bucket the environment has, whatever its disks: their keys
#                                      deleted, and each bucket emptied and deleted
#               reverb-app-add <N>     an app of its own on mroom's Reverb host (D16), which reads its apps
#                                      from a file on every lookup, so nothing restarts; prints
#                                      REVERB_APP_ID, REVERB_APP_KEY, a new REVERB_APP_SECRET, REVERB_HOST,
#                                      REVERB_PORT and REVERB_SCHEME
#               reverb-app-remove <N>  the environment's app; its sockets already open stay until they close
#
# The client sends only the environment's number. The gate builds every name from box.env, which a person
# sets: the database, role and Redis user are <MROOM_APP_NAME>_qa_<N>, the database is cloned from
# MROOM_QA_TEMPLATE, and the Redis prefix is <MROOM_APP_NAME>:qa<N>:, so no argument can reach another
# environment. Its buckets are <MROOM_APP_NAME>-qa-<N>-<disk>, each _ of the name a -, for the disk name
# bucket-create also takes: [a-z][a-z0-9]{0,15}, with no - in it, so no disk's bucket is another
# environment's or another disk's. Its Reverb app's id and key are both <MROOM_APP_NAME>-qa-<N>: public, so
# the frontend builds without a secret, and the PR's alone, so no other PR is ever given an id whose sockets
# may still be open. Its sites, api-<N>.<MROOM_QA_ZONE> and go-<N>.<MROOM_QA_ZONE>, live in the home of a Forge
# isolated user of its own, also <MROOM_APP_NAME>_qa_<N>. The gate works in them only through site-op, run
# as that user with sudo from a root-owned copy of this release's lib/site-op, so it never unpacks a
# tarball, follows a PR's link or runs its code as the box user. It connects to Postgres 16 or later as its own role, through the libpq service mroom-gate
# in ~/.config/mroom/secrets/pg_service.conf, and to Redis 7 or later as its own user, from
# ~/.config/mroom/secrets/redis-gate.env (both mode 600). Each request and refusal is logged, never a
# secret, to ~/.local/state/mroom/gate.log and to syslog. It runs from the installed release, never from an
# app checkout, so a pull request cannot change it.
#
# Exit codes: 0 done, 1 failed or refused, 2 not run as a forced command with a role.
set -euo pipefail
umask 077
# sshd passes the client's LANG and LC_* on (AcceptEnv): in some locales a range such as [0-9] matches
# more than ASCII, so every check below runs in the C locale.
export LC_ALL=C
# A test seam only; it must never fix the salt of a real password.
unset MROOM_SCRAM_SALT

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=lib/core/util.sh
. "$MROOM_ROOT/lib/core/util.sh"

MAX_LINE=4096
LOG_MAX_BYTES=1048576
role="${1:-}"

# printable <text>: the text with anything but printable ASCII removed, so nothing the server or a client
# says can forge a line of the log.
printable() { printf '%s' "$1" | tr -cd '[:print:]'; }

gate_log() {
  local state log
  state="$(mroom_state_dir 2>/dev/null)" || return 0
  log="$state/gate.log"
  if [ -f "$log" ] && [ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt "$LOG_MAX_BYTES" ]; then
    mv -f "$log" "$log.1" 2>/dev/null || true
  fi
  printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${role:-none}" "$(printable "$*")" >>"$log" 2>/dev/null || true
  if command -v logger >/dev/null 2>&1; then logger -t mroom-gate -- "${role:-none} $(printable "$*")" 2>/dev/null || true; fi
}
refuse() { gate_log "refused: $*"; echo "mroom gate: refused: $*" >&2; exit 1; }
fail() { gate_log "failed: $*"; echo "mroom gate: $*" >&2; exit 1; }

case "$role" in
  provision) ;;
  -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; exit 0 ;;
  *) echo "mroom gate: run it as an SSH forced command: mroom gate provision" >&2; exit 2 ;;
esac

line="${SSH_ORIGINAL_COMMAND-}"
[ -n "$line" ] || refuse "empty command"
((${#line} <= MAX_LINE)) || refuse "command longer than $MAX_LINE characters"
# One line of plain words: no ; | & $ ( ) ` ' " \ < > * ? spaces in a row, tabs or newlines.
[[ "$line" =~ ^[A-Za-z0-9_.@+=/:-]+(\ [A-Za-z0-9_.@+=/:-]+)*$ ]] || refuse "characters outside the allowed set"
# Safe to split: those characters hold nothing to glob, quote or expand, and read -a expands nothing.
read -r -a words <<<"$line"
op="${words[0]}"

case "$role:$op" in
  provision:db-create | provision:db-drop) ;;
  provision:redis-user-add | provision:redis-user-remove | provision:redis-clear) ;;
  provision:code-put | provision:dist-put | provision:env-put | provision:env-sha) ;;
  provision:signin-code | provision:user-clean) ;;
  provision:mail-user-add | provision:mail-user-remove | provision:mail-read | provision:mail-clear) ;;
  provision:bucket-create | provision:bucket-drop) ;;
  provision:reverb-app-add | provision:reverb-app-remove) ;;
  *) refuse "$role may not run '${op:0:24}'" ;;
esac

# env_number <word>: the environment's number, 1 to 999999999 with no leading zero.
env_number() { [[ "$1" =~ ^[1-9][0-9]{0,8}$ ]] || refuse "$op: its first argument is not an environment number"; }
words_are() { [ "${#words[@]}" = "$1" ] || refuse "$op takes $(($1 - 1)) argument(s), got $((${#words[@]} - 1))"; }

load_box || fail "box.env could not be read"
app="${BOX[MROOM_APP_NAME]:-}"
[ -n "$app" ] || fail "MROOM_APP_NAME is not set in box.env"

GATE_TMP=""
# gate_cleanup: what a request leaves behind however it ends: a drop's key of its own, a login file half
# written, the scratch folder.
gate_cleanup() {
  if [ -n "${DROP_KEY:-}" ]; then garage_api POST "/v2/DeleteKey?id=$DROP_KEY" >/dev/null 2>&1 || true; fi
  if [ -n "${LOGIN_TMP:-}" ]; then rm -f -- "$LOGIN_TMP"; fi
  rm -rf -- "$GATE_TMP"
}
# gate_tmp: a private folder for this request's scratch files, removed however the gate ends.
gate_tmp() {
  [ -z "$GATE_TMP" ] || return 0
  GATE_TMP="$(mktemp -d "$(mroom_state_dir)/gate-tmp.XXXXXX")" || fail "cannot make a scratch folder"
  trap gate_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

PG_SERVICES="$HOME/.config/mroom/secrets/pg_service.conf"
PG_ERR=""

# pg <database>: runs the SQL on stdin as the gate's role, printing rows unaligned. The SQL never travels
# on a command line. stderr goes to its own file, so a server NOTICE or WARNING can never be read as a
# value; pg_error gives its first line. VERBOSITY=verbose puts the SQLSTATE code in that line.
pg() {
  PGSERVICEFILE="$PG_SERVICES" PGSERVICE=mroom-gate \
    psql -X -q -A -t -v ON_ERROR_STOP=1 -v VERBOSITY=verbose -d "$1" 2>"$PG_ERR"
}
pg_error() { printable "$(grep -m1 -E '^(ERROR|FATAL|PANIC|psql):' "$PG_ERR" 2>/dev/null || head -n1 "$PG_ERR" 2>/dev/null)"; }

pg_ready() {
  [ -r "$PG_SERVICES" ] || fail "$(home_short "$PG_SERVICES") is missing; it holds the [mroom-gate] service"
  secret_file_ok "$PG_SERVICES" || fail "$(home_short "$PG_SERVICES") must be yours and mode 600"
  need psql python3 flock
  gate_tmp
  PG_ERR="$GATE_TMP/psql.err"
  local ok
  ok="$(pg postgres <<<"SELECT current_setting('server_version_num')::int >= 160000;")" \
    || fail "cannot reach Postgres as the gate's role: $(pg_error)"
  # Before 16 a role that may create roles may also grant itself any role, the administrator ones too.
  [ "$ok" = t ] || fail "Postgres must be 16 or later (D18)"
}

# env_lock <name>: one request at a time per environment; a second one waits, then gives up.
env_lock() {
  exec 9>"$(mroom_state_dir)/gate-$1.lock"
  flock -w "${MROOM_GATE_LOCK_WAIT:-900}" 9 || fail "another request for $1 is still running"
}

# new_password: 48 hex characters from the kernel's random source.
new_password() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }

cmd_db_create() {
  words_are 2
  env_number "${words[1]}"
  local template="${BOX[MROOM_QA_TEMPLATE]:-}" db="${app}_qa_${words[1]}" objects="${app}_qa_objects"
  local group="${app}_qa_envs" password verifier owned role_exists db_exists attempt
  [ -n "$template" ] || fail "MROOM_QA_TEMPLATE is not set in box.env"
  pg_ready
  env_lock "$db"

  # REASSIGN OWNED also moves databases and tablespaces: one owned by the objects role would go to the
  # environment, so its PR's code could drop it. Refuse before anything is made.
  owned="$(pg postgres <<SQL
SELECT count(*) FROM (
  SELECT 1 FROM pg_database WHERE datdba = '$objects'::regrole
  UNION ALL SELECT 1 FROM pg_tablespace WHERE spcowner = '$objects'::regrole) owned;
SQL
)" || fail "db-create ${words[1]}: $(pg_error)"
  [ "$owned" = 0 ] || fail "$objects owns a database or tablespace, which REASSIGN OWNED would hand to the environment; give it to the gate's role (D18)"

  password="$(new_password)"
  [ "${#password}" = 48 ] || fail "could not read random bytes for the password"
  verifier="$(printf '%s' "$password" | python3 "$MROOM_ROOT/lib/core/scram.py")" || fail "could not make the password verifier"

  # The role, with a new password each time (the client writes it into the environment's .env), always
  # in the group pg_hba.conf matches and with its limits, even when it was made or changed elsewhere. The
  # gate becomes a member, so it may give the role the database it creates.
  role_exists="$(pg postgres <<<"SELECT count(*) FROM pg_roles WHERE rolname = '$db';")" \
    || fail "db-create ${words[1]}: $(pg_error)"
  if [ "$role_exists" = 1 ]; then
    pg postgres >/dev/null <<SQL || fail "db-create ${words[1]}: the role: $(pg_error)"
ALTER ROLE "$db" LOGIN NOINHERIT CONNECTION LIMIT 30 PASSWORD '$verifier';
GRANT "$group" TO "$db";
GRANT "$db" TO CURRENT_USER;
SQL
  else
    pg postgres >/dev/null <<SQL || fail "db-create ${words[1]}: the role: $(pg_error)"
CREATE ROLE "$db" LOGIN NOINHERIT CONNECTION LIMIT 30 IN ROLE "$group" PASSWORD '$verifier';
GRANT "$db" TO CURRENT_USER;
SQL
  fi

  db_exists="$(pg postgres <<<"SELECT count(*) FROM pg_database WHERE datname = '$db';")" \
    || fail "db-create ${words[1]}: $(pg_error)"
  if [ "$db_exists" = 1 ]; then
    # The PR's code owns this database and may have changed its settings, so the gate never connects to
    # it again: database privileges live in the cluster's catalog and are revoked from postgres.
    pg postgres >/dev/null <<<"REVOKE CONNECT, TEMPORARY ON DATABASE \"$db\" FROM PUBLIC;" \
      || fail "db-create ${words[1]}: $(pg_error)"
    echo "database $db: exists"
  else
    # CREATE DATABASE … TEMPLATE fails (SQLSTATE 55006) while a session is connected to the template:
    # wait and try again.
    for attempt in 1 2 3 4 5 6; do
      if pg postgres >/dev/null <<<"CREATE DATABASE \"$db\" TEMPLATE \"$template\" OWNER \"$db\";"; then
        break
      fi
      grep -q -E '^ERROR: +55006:' "$PG_ERR" || fail "db-create ${words[1]}: $(pg_error)"
      [ "$attempt" = 6 ] && fail "db-create ${words[1]}: $template stayed in use; try again later"
      echo "template $template is in use, trying again ($attempt)" >&2
      sleep "${MROOM_GATE_RETRY_SLEEP:-20}"
    done
    # A new database gives PUBLIC CONNECT again: take it back first. Then hand over the template's
    # objects, whose owner owns nothing else. The database is new, so no PR code has touched it yet; if
    # the hand-over fails, the database goes again, so a later request starts clean.
    pg postgres >/dev/null <<<"REVOKE CONNECT, TEMPORARY ON DATABASE \"$db\" FROM PUBLIC;" \
      || fail "db-create ${words[1]}: $(pg_error)"
    if ! pg "$db" >/dev/null <<<"REASSIGN OWNED BY \"$objects\" TO \"$db\";"; then
      local why
      why="$(pg_error)"
      pg postgres >/dev/null <<<"DROP DATABASE IF EXISTS \"$db\" WITH (FORCE);" || true
      fail "db-create ${words[1]}: handing the template's objects over failed, so the database is gone again: $why"
    fi
    echo "database $db: created"
  fi

  gate_log "db-create ${words[1]}: $db ready"
  printf 'DB_DATABASE=%s\nDB_USERNAME=%s\nDB_PASSWORD=%s\n' "$db" "$db" "$password"
}

cmd_db_drop() {
  words_are 2
  env_number "${words[1]}"
  local db="${app}_qa_${words[1]}" db_exists
  pg_ready
  env_lock "$db"
  db_exists="$(pg postgres <<<"SELECT count(*) FROM pg_database WHERE datname = '$db';")" \
    || fail "db-drop ${words[1]}: $(pg_error)"
  if [ "$db_exists" = 1 ]; then
    # The owner, the PR's own role, may have marked it a template, which DROP DATABASE refuses.
    pg postgres >/dev/null <<SQL || fail "db-drop ${words[1]}: $(pg_error)"
ALTER DATABASE "$db" IS_TEMPLATE false;
DROP DATABASE "$db" WITH (FORCE);
SQL
  fi
  # A grant the role was given in another environment's database stops DROP ROLE. Then it can at least
  # never sign in again.
  if ! pg postgres >/dev/null <<<"DROP ROLE IF EXISTS \"$db\";"; then
    local why
    why="$(pg_error)"
    pg postgres >/dev/null <<<"ALTER ROLE \"$db\" NOLOGIN PASSWORD NULL;" \
      || fail "db-drop ${words[1]}: the role could neither be dropped nor locked: $why"
    gate_log "db-drop ${words[1]}: $db dropped; its role is locked, not dropped: $why"
    echo "database $db: dropped; role $db locked, since it could not be dropped: $why"
    return 0
  fi
  gate_log "db-drop ${words[1]}: $db dropped"
  echo "database $db: dropped"
}

REDIS_SECRETS="$HOME/.config/mroom/secrets/redis-gate.env"
REDIS_USER="" REDIS_PASS="" REDIS_HOST="" REDIS_PORT="" REDIS_ERR=""

# redis_secret <KEY>: one value from redis-gate.env; the one reader of that file.
redis_secret() { sed -n "s/^$1=//p" "$REDIS_SECRETS" | head -n1 | tr -d '\r'; }

# rcli <args...>: redis-cli as the gate's own user. The password travels in REDISCLI_AUTH, never on a
# command line, and -e makes an error reply fail the call. stderr goes to its own file, as psql's does, so
# only the reply is ever read as a value.
rcli() {
  REDISCLI_AUTH="$REDIS_PASS" redis-cli --no-auth-warning -e -h "$REDIS_HOST" -p "$REDIS_PORT" \
    --user "$REDIS_USER" "$@" 2>"$REDIS_ERR"
}
# redis_error [<reply>]: what went wrong, on one line: redis-cli's stderr, or the error reply an older
# redis-cli prints where the reply would be.
redis_error() {
  local e
  e="$(grep -m1 . "$REDIS_ERR" 2>/dev/null)" || e="$(grep -m1 . <<<"${1-}")" || e="an unexpected reply"
  printable "$e"
}
# config_get <name>: one Redis setting. CONFIG GET replies with the name, then the value.
config_get() {
  local reply
  reply="$(rcli CONFIG GET "$1")" || return 1
  reply="$(tr -d '\r' <<<"$reply")"
  [ "$(sed -n 1p <<<"$reply")" = "$1" ] || return 1
  sed -n 2p <<<"$reply"
}

redis_ready() {
  [ -r "$REDIS_SECRETS" ] || fail "$(home_short "$REDIS_SECRETS") is missing; it holds REDIS_GATE_USER and REDIS_GATE_PASSWORD"
  secret_file_ok "$REDIS_SECRETS" || fail "$(home_short "$REDIS_SECRETS") must be yours and mode 600"
  need redis-cli flock sha256sum
  gate_tmp
  REDIS_ERR="$GATE_TMP/redis.err"
  REDIS_USER="$(redis_secret REDIS_GATE_USER)"
  REDIS_PASS="$(redis_secret REDIS_GATE_PASSWORD)"
  REDIS_HOST="$(redis_secret REDIS_GATE_HOST)"
  REDIS_PORT="$(redis_secret REDIS_GATE_PORT)"
  REDIS_HOST="${REDIS_HOST:-127.0.0.1}" REDIS_PORT="${REDIS_PORT:-6379}"
  if [ -z "$REDIS_USER" ] || [ -z "$REDIS_PASS" ]; then
    fail "$(home_short "$REDIS_SECRETS") must set REDIS_GATE_USER and REDIS_GATE_PASSWORD"
  fi
  [[ "$REDIS_USER" =~ ^[A-Za-z0-9_.-]+$ ]] || fail "REDIS_GATE_USER is not a plain user name"
  # redis-user-add would reset such a user to one environment's prefix, locking the gate out.
  if [[ "$REDIS_USER" =~ ^${app}_qa_[0-9]+$ ]]; then fail "REDIS_GATE_USER is named like an environment's user"; fi
  [[ "$REDIS_HOST" =~ ^[A-Za-z0-9.:-]+$ ]] || fail "REDIS_GATE_HOST is not a plain host"
  [[ "$REDIS_PORT" =~ ^[0-9]{1,5}$ ]] || fail "REDIS_GATE_PORT is not a port"
  local info major aclfile users
  info="$(rcli INFO server)" || fail "cannot reach Redis as the gate's user: $(redis_error "$info")"
  major="$(tr -d '\r' <<<"$info" | sed -n 's/^redis_version:\([0-9][0-9]*\).*/\1/p')"
  if ! [[ "$major" =~ ^[0-9]+$ ]] || ((major < 7)); then fail "Redis must be 7 or later (D15)"; fi
  aclfile="$(config_get aclfile)" || fail "cannot read Redis's aclfile setting: $(redis_error)"
  [ -n "$aclfile" ] || fail "Redis has no aclfile, so the users it is given would vanish on a restart (D15)"
  # While the default user is on, any process on the box signs in as it and reaches every key, so an
  # environment's own user would keep nothing apart.
  users="$(rcli ACL LIST)" || fail "cannot list Redis's users: $(redis_error "$users")"
  if tr -d '\r' <<<"$users" | grep -q -E '^user default on( |$)'; then
    fail "Redis's default user is on, so every process on the box reaches every key; turn it off first (D15)"
  fi
}

# What an environment's user is given: Redis's own data types and the functions an app needs, never @all.
# A module's commands carry only its own categories (and @read, @write and the like), so none is in these,
# and a module command cannot be trusted to name its keys: JSON.MGET declares only its first key and reads
# the rest, FT.SEARCH and TS.MRANGE take none. A server command added later stays out unless it joins one.
GRANTED=(keyspace string hash list set sortedset stream bitmap hyperloglog geo pubsub scripting transaction connection)
# Taken back from those: the commands that flush, watch, list, count or debug the whole server, or reset its
# scripts (design 8.9). @dangerous holds KEYS, FLUSHALL, SORT, CLIENT LIST, MONITOR and the like.
WITHHELD=(-@dangerous -scan -randomkey -dbsize '-client|tracking' '-pubsub|channels' '-pubsub|shardchannels'
  '-pubsub|numsub' '-pubsub|shardnumsub' '-pubsub|numpat' -function '-script|flush' '-script|kill' '-script|debug')

# granted_module_commands: the commands of loaded modules that GRANTED would give an environment, one per
# line. There must be none.
granted_module_commands() {
  local modules m c reply mods="" granted=""
  modules="$(rcli MODULE LIST)" || return 1
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    reply="$(rcli COMMAND LIST FILTERBY MODULE "$m")" || return 1
    mods+="$(tr -d '\r' <<<"$reply")"$'\n'
  done < <(tr -d '\r' <<<"$modules" | awk 'prev == "name" { print } { prev = $0 }')
  [ -n "${mods//[[:space:]]/}" ] || return 0
  for c in "${GRANTED[@]}"; do
    reply="$(rcli COMMAND LIST FILTERBY ACLCAT "$c")" || return 1
    granted+="$(tr -d '\r' <<<"$reply")"$'\n'
  done
  grep -x -F -f <(grep . <<<"$mods") <<<"$granted" | sort -u || true
}

cmd_redis_user_add() {
  words_are 2
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" prefix="${app}:qa${words[1]}:" password hash leaks out
  redis_ready
  env_lock "redis-$user"
  leaks="$(granted_module_commands)" \
    || fail "redis-user-add ${words[1]}: cannot list Redis's modules and their commands: $(redis_error)"
  if [ -n "$leaks" ]; then
    fail "redis-user-add ${words[1]}: a module puts commands in a category environments are given, so its key checks would decide what they reach: $(tr '\n' ' ' <<<"$leaks" | cut -c1-160)"
  fi
  # Save first, so a Redis that cannot save its users is refused before a password changes.
  out="$(rcli ACL SAVE)" \
    || fail "redis-user-add ${words[1]}: Redis cannot save its users, so nothing was changed: $(redis_error "$out")"
  password="$(new_password)"
  [ "${#password}" = 48 ] || fail "could not read random bytes for the password"
  # Redis stores and compares only this hash, so only the hash leaves the gate.
  hash="$(printf '%s' "$password" | sha256sum | cut -d' ' -f1)"
  # reset first: ACL SETUSER only adds to a user, so running it again would keep the old password.
  out="$(rcli ACL SETUSER "$user" reset on "#$hash" "~$prefix*" "&$prefix*" "${GRANTED[@]/#/+@}" "${WITHHELD[@]}")" \
    || fail "redis-user-add ${words[1]}: $(redis_error "$out")"
  # A connection signed in with the old password stays signed in: close them, so the app reconnects.
  rcli CLIENT KILL USER "$user" >/dev/null || true
  out="$(rcli ACL SAVE)" \
    || fail "redis-user-add ${words[1]}: the user changed but was not saved; run redis-user-add again once Redis can save: $(redis_error "$out")"
  gate_log "redis-user-add ${words[1]}: $user ready"
  printf 'REDIS_USERNAME=%s\nREDIS_PASSWORD=%s\nREDIS_PREFIX=%s\nHORIZON_PREFIX=%shorizon:\n' \
    "$user" "$password" "$prefix" "$prefix"
}

cmd_redis_user_remove() {
  words_are 2
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" out
  redis_ready
  env_lock "redis-$user"
  out="$(rcli ACL SAVE)" \
    || fail "redis-user-remove ${words[1]}: Redis cannot save its users, so nothing was changed: $(redis_error "$out")"
  # ACL DELUSER also closes the connections signed in as the user.
  out="$(rcli ACL DELUSER "$user")" || fail "redis-user-remove ${words[1]}: $(redis_error "$out")"
  out="$(rcli ACL SAVE)" \
    || fail "redis-user-remove ${words[1]}: the user is gone but was not saved; run redis-user-remove again once Redis can save: $(redis_error "$out")"
  gate_log "redis-user-remove ${words[1]}: $user removed"
  echo "redis user $user: removed"
}

# One step of redis-clear, run inside Redis: SCAN from the cursor in ARGV[1] for keys matching ARGV[2], then
# UNLINK what it found, 500 at a time. Key names never leave Redis: a name may hold a newline, and read back
# line by line it would become two names, one of them outside the prefix. Replies with the next cursor and
# how many keys UNLINK removed (SCAN may return a key twice).
CLEAR_STEP="local r = redis.call('SCAN', ARGV[1], 'MATCH', ARGV[2], 'COUNT', 1000)
local keys, n = r[2], 0
for i = 1, #keys, 500 do n = n + redis.call('UNLINK', unpack(keys, i, math.min(i + 499, #keys))) end
return {r[1], n}"

cmd_redis_clear() {
  words_are 2
  env_number "${words[1]}"
  local prefix="${app}:qa${words[1]}:" dbs db cursor reply n total=0
  redis_ready
  env_lock "redis-${app}_qa_${words[1]}"
  dbs="$(config_get databases)" || fail "redis-clear ${words[1]}: cannot read Redis's databases setting: $(redis_error)"
  [[ "$dbs" =~ ^[1-9][0-9]{0,5}$ ]] || fail "redis-clear ${words[1]}: Redis reports '${dbs:0:24}' databases"
  # Every database: Laravel keeps its cache in a different one from its queues and sessions. Each step
  # scans a slice of the keyspace, so Redis never stalls the way KEYS would stall it.
  for ((db = 0; db < dbs; db++)); do
    cursor=0
    while :; do
      reply="$(rcli -n "$db" EVAL "$CLEAR_STEP" 0 "$cursor" "$prefix*")" \
        || fail "redis-clear ${words[1]}: database $db: $(redis_error "$reply")"
      reply="$(tr -d '\r' <<<"$reply")"
      cursor="$(sed -n 1p <<<"$reply")"
      n="$(sed -n 2p <<<"$reply")"
      [[ "$cursor" =~ ^[0-9]+$ && "$n" =~ ^[0-9]+$ ]] || fail "redis-clear ${words[1]}: database $db: an unexpected reply"
      total=$((total + 10#$n))
      if [ "$cursor" = 0 ]; then break; fi
    done
  done
  gate_log "redis-clear ${words[1]}: $total keys under $prefix"
  echo "redis $prefix: $total keys deleted"
}

SITE_OP="${MROOM_GATE_SITE_OP:-/usr/local/libexec/mroom/site-op}"
SITE_USER="" API_DOMAIN="" WEB_DOMAIN="" BACKEND="" SITE_ERR=""

# site_ready: the environment's site user and its sites' domains, from box.env. Refuses unless the installed
# site-op belongs to root, cannot be changed by the box user, and is this release's own.
site_ready() {
  local zone n="${words[1]}"
  zone="${BOX[MROOM_QA_ZONE]:-}"
  [ -n "$zone" ] || fail "MROOM_QA_ZONE is not set in box.env"
  BACKEND="${BOX[MROOM_QA_BACKEND_DIR]:-.}"
  SITE_USER="${app}_qa_${n}" API_DOMAIN="api-${n}.${zone}" WEB_DOMAIN="go-${n}.${zone}"
  ((${#SITE_USER} <= 32)) || fail "$SITE_USER is longer than a user name may be (32); shorten MROOM_APP_NAME"
  need sudo cmp
  if [ ! -f "$SITE_OP" ] || [ -L "$SITE_OP" ]; then fail "$SITE_OP is not installed, or is a link (README, QA gate)"; fi
  local path
  for path in "$SITE_OP" "$(dirname "$SITE_OP")"; do
    if [ "$(stat -c %u "$path")" != "${MROOM_GATE_SITE_OP_OWNER:-0}" ] || [ -w "$path" ]; then
      fail "$path must belong to root, and $(id -un) must not be able to change it"
    fi
  done
  cmp -s "$SITE_OP" "$MROOM_ROOT/lib/site-op" || fail "$SITE_OP is not this release's site-op; install it again (README, QA gate)"
  gate_tmp
  SITE_ERR="$GATE_TMP/site.err"
}

# site_user_exists: whether the site user exists; a user outside Forge's isolated group is refused.
site_user_exists() {
  id -u "$SITE_USER" >/dev/null 2>&1 || return 1
  [[ " $(id -nG "$SITE_USER") " == *" isolated "* ]] || fail "$SITE_USER is not one of Forge's isolated users"
}

# site_op <args...>: site-op as the site user. stdin passes through, which carries a put's tarball.
site_op() { sudo -n -u "$SITE_USER" -- "$SITE_OP" "$@" 2>"$SITE_ERR"; }
site_error() { printable "$(grep -m1 . "$SITE_ERR" 2>/dev/null || echo "no message")"; }

# The commit code-put unpacked, kept as the box user outside the site, where the PR's code cannot write.
commit_file() { echo "$(mroom_state_dir)/qa/$SITE_USER.commit"; }
recorded_commit() {
  local commit
  commit="$(head -c 41 "$(commit_file)" 2>/dev/null | head -n1)" || true
  if [[ "$commit" =~ ^[0-9a-f]{40}$ ]]; then echo "$commit"; else echo none; fi
}

cmd_code_put() {
  words_are 3
  env_number "${words[1]}"
  [[ "${words[2]}" =~ ^[0-9a-f]{40}$ ]] || refuse "code-put: its second argument is not a full commit SHA"
  site_ready
  site_user_exists || fail "there is no user $SITE_USER; qa-up creates the site first"
  env_lock "site-$SITE_USER"
  local out
  # Cleared first, so env-sha never reports a commit for a tree a failed put may have changed.
  rm -f "$(commit_file)"
  out="$(site_op unpack code "$API_DOMAIN" "$BACKEND" "${words[2]}")" || fail "code-put ${words[1]}: $(site_error)"
  mkdir -p "$(dirname "$(commit_file)")"
  printf '%s\n' "${words[2]}" >"$(commit_file).tmp"
  mv -f "$(commit_file).tmp" "$(commit_file)"
  gate_log "code-put ${words[1]}: ${words[2]} into $API_DOMAIN"
  printable "$out"
  echo
}

cmd_dist_put() {
  words_are 2
  env_number "${words[1]}"
  site_ready
  site_user_exists || fail "there is no user $SITE_USER; qa-up creates the site first"
  env_lock "site-$SITE_USER"
  local out
  out="$(site_op unpack dist "$WEB_DOMAIN")" || fail "dist-put ${words[1]}: $(site_error)"
  gate_log "dist-put ${words[1]}: into $WEB_DOMAIN"
  printable "$out"
  echo
}

cmd_env_put() {
  words_are 2
  env_number "${words[1]}"
  site_ready
  site_user_exists || fail "there is no user $SITE_USER; qa-up creates the site first"
  env_lock "site-$SITE_USER"
  local env
  env="$(site_op env-put "$API_DOMAIN" "$BACKEND")" || fail "env-put ${words[1]}: $(site_error)"
  [[ "$env" =~ ^[0-9a-f]{64}$ ]] || fail "env-put ${words[1]}: site-op gave no hash"
  gate_log "env-put ${words[1]}: .env written into $API_DOMAIN"
  printf 'env=%s\n' "$env"
}

cmd_env_sha() {
  words_are 2
  env_number "${words[1]}"
  site_ready
  site_user_exists || fail "there is no user $SITE_USER"
  env_lock "site-$SITE_USER"
  local env
  env="$(site_op env-sha "$API_DOMAIN" "$BACKEND")" || fail "env-sha ${words[1]}: $(site_error)"
  [[ "$env" =~ ^([0-9a-f]{64}|missing)$ ]] || fail "env-sha ${words[1]}: site-op gave no hash"
  printf 'env=%s\ncommit=%s\n' "$env" "$(recorded_commit)"
}

# persona <op> <address>: refuses anything but a made-up persona address (MROOM_QA_PERSONA_DOMAIN), so no real
# person's sign-in code or mail is ever read, and a refused address is never logged.
persona() {
  local domain="${BOX[MROOM_QA_PERSONA_DOMAIN]:-.test}"
  if ! [[ "$2" =~ ^[a-z0-9._+-]+@[a-z0-9-]+(\.[a-z0-9-]+)+$ ]] || [[ "$2" != *"$domain" ]]; then
    refuse "$1: not a persona address ending in $domain"
  fi
}

cmd_signin_code() {
  words_are 3
  env_number "${words[1]}"
  local email="${words[2]}" code
  persona signin-code "$email"
  site_ready
  site_user_exists || fail "there is no user $SITE_USER"
  env_lock "site-$SITE_USER"
  code="$(site_op signin-code "$API_DOMAIN" "$BACKEND" "${BOX[MROOM_QA_PHP]:-php}" "$email")" \
    || fail "signin-code ${words[1]}: $(site_error)"
  [[ "$code" =~ ^[A-Za-z0-9-]{4,64}$ ]] || fail "signin-code ${words[1]}: the app gave no code"
  gate_log "signin-code ${words[1]}: a code for $email"
  printf '%s\n' "$code"
}

cmd_user_clean() {
  words_are 2
  env_number "${words[1]}"
  site_ready
  env_lock "site-$SITE_USER"
  local out="no user $SITE_USER, so nothing to clean"
  if site_user_exists; then
    out="$(site_op clean)" || fail "user-clean ${words[1]}: $(site_error)"
  fi
  rm -f "$(commit_file)"
  gate_log "user-clean ${words[1]}: $out"
  printable "$out"
  echo
}

MAILPIT_SECRETS="$HOME/.config/mroom/secrets/mailpit.env"
MAILPIT_LOGINS="$HOME/.config/mroom/secrets/mailpit-smtp.passwd"
MAILPIT_HOME="$HOME/.local/share/mroom-services/mailpit"
# Mailpit listens only on Unix sockets in a folder only the box user can open; apps reach its SMTP side
# through mroom's mail relay, which holds the TCP port (lib/mail-relay).
MAILPIT_HTTP="$MAILPIT_HOME/run/http.sock"
MAILPIT_SMTP="$MAILPIT_HOME/run/smtp.sock"
MAIL_RELAY="$HOME/.local/share/mroom-services/mail-relay/mail-relay"
MAILPIT_AUTH="" SMTP_PORT="" MAIL_ERR="" LOGIN_TMP=""

# mail_secret <KEY>: one value from mailpit.env, which mroom baseline mailpit writes; the one reader of it.
mail_secret() { sed -n "s/^$1=//p" "$MAILPIT_SECRETS" | head -n1 | tr -d '\r'; }

mail_ready() {
  local file user pass
  for file in "$MAILPIT_SECRETS" "$MAILPIT_LOGINS"; do
    [ -r "$file" ] || fail "$(home_short "$file") is missing; run mroom baseline mailpit"
    secret_file_ok "$file" || fail "$(home_short "$file") must be yours and mode 600"
  done
  need curl jq openssl flock base64 python3
  user="$(mail_secret MAILPIT_API_USER)" pass="$(mail_secret MAILPIT_API_PASSWORD)"
  if [ -z "$user" ] || [ -z "$pass" ]; then fail "$(home_short "$MAILPIT_SECRETS") must set MAILPIT_API_USER and MAILPIT_API_PASSWORD"; fi
  [[ "$user" =~ ^[A-Za-z0-9_.-]+$ ]] || fail "MAILPIT_API_USER is not a plain user name"
  MAILPIT_AUTH="$(printf '%s:%s' "$user" "$pass" | base64 -w0)"
  SMTP_PORT="${BOX[MROOM_QA_SMTP_PORT]:-1025}"
  gate_tmp
  MAIL_ERR="$GATE_TMP/mail.err"
}

# mailpit_api <method> <path> [<json>]: one call to Mailpit's API, on its Unix socket, as the gate's login,
# printing the body. The login reaches curl on stdin, never a command line.
mailpit_api() {
  local args=(-q --silent --show-error --fail --max-time 30 --unix-socket "$MAILPIT_HTTP" --request "$1" --header @-)
  if [ -n "${3-}" ]; then args+=(--header "Content-Type: application/json" --data-binary "$3"); fi
  printf 'Authorization: Basic %s\n' "$MAILPIT_AUTH" | curl "${args[@]}" "http://localhost$2" 2>"$MAIL_ERR"
}
mail_error() { printable "$(grep -m1 . "$MAIL_ERR" 2>/dev/null || echo "no message")"; }

# mailpit_pids: the Mailpit processes this user runs from any installed build, so one that runs an older build
# than current is found too, and its restart starts the current one.
mailpit_pids() {
  local home proc exe
  home="$(readlink -f "$MAILPIT_HOME" 2>/dev/null)" || return 0
  for proc in /proc/[0-9]*; do
    [ -O "$proc" ] || continue
    exe="$(readlink "$proc/exe" 2>/dev/null)" || continue
    exe="${exe% (deleted)}"
    if [[ "$exe" == "$home"/*/mailpit && "${exe#"$home"/}" != */*/* ]]; then echo "${proc#/proc/}"; fi
  done
}

# socket_open <path>: whether something takes connections on the Unix socket.
socket_open() {
  python3 -I -c 'import socket, sys; s = socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect(sys.argv[1])' "$1" 2>/dev/null
}
# mailpit_live: whether Mailpit answers on HTTP and takes SMTP connections. It starts its web server first,
# so the first can be true a moment before the second.
mailpit_live() {
  [ "$(curl -q --silent --max-time 2 --unix-socket "$MAILPIT_HTTP" --output /dev/null --write-out '%{http_code}' \
    http://localhost/livez 2>/dev/null)" = 200 ] && socket_open "$MAILPIT_SMTP"
}

# proc_age <pid>: how long the process has run, in hundredths of a second.
proc_age() {
  local stat fields uptime
  stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  read -r -a fields <<<"${stat##*) }"
  uptime="$(cut -d' ' -f1 /proc/uptime)"
  echo $(( ${uptime%.*} * 100 + 10#${uptime#*.} - fields[19] * 100 / $(getconf CLK_TCK) ))
}

# under_systemd <pid>: whether the process is systemd's mroom-mailpit.service, which starts Mailpit again
# however often it stops (StartLimitIntervalSec=0).
under_systemd() { grep -q '/mroom-mailpit\.service$' "/proc/$1/cgroup" 2>/dev/null; }

# mailpit_restart: Mailpit reads its logins only when it starts (D19), so the gate stops it and systemd starts
# it again; it waits until a new Mailpit answers.
mailpit_restart() {
  local old new pid age min deadline wait="${MROOM_GATE_RESTART_WAIT:-30}"
  [[ "$wait" =~ ^[0-9]{1,3}$ ]] || wait=30
  old="$(mailpit_pids)"
  [ -n "$old" ] || fail "Mailpit is not running; check mroom-mailpit.service (mroom baseline mailpit writes it)"
  # A Mailpit runs a second before the next request stops it, so a caller in a loop cannot keep every
  # environment's mail down. Run by a supervisor such as Forge's daemons instead of systemd, it runs 3: a
  # supervisor counts a stop within Start Seconds (1) as a failed start, and gives up after three.
  for pid in $old; do
    min=300
    if under_systemd "$pid"; then min=100; fi
    while age="$(proc_age "$pid")" && [ "$age" -lt "$min" ]; do sleep 0.2; done
  done
  for pid in $old; do kill -TERM "$pid" 2>/dev/null || true; done
  deadline=$((SECONDS + wait))
  while [ "$SECONDS" -lt "$deadline" ]; do
    sleep 0.25
    new="$(mailpit_pids)"
    # A new Mailpit: no process left from before, and one that answers.
    if [ -n "$new" ] && ! grep -qxF -f <(printf '%s\n' "$old") <<<"$new" && mailpit_live; then return 0; fi
  done
  fail "Mailpit did not come back within $wait seconds of a restart; check mroom-mailpit.service"
}

# socket_unit_holds_port: whether systemd's mroom-mail-relay.socket is active and listening on the SMTP port.
# Its configuration alone says nothing: a socket that could not bind lists the same address.
socket_unit_holds_port() {
  local show
  show="$(systemctl show --property=ActiveState,SubState,Listen mroom-mail-relay.socket 2>/dev/null)" || return 1
  [[ "$show" =~ (^|$'\n')ActiveState=active($'\n'|$) ]] || return 1
  [[ "$show" =~ (^|$'\n')SubState=(listening|running)($'\n'|$) ]] || return 1
  [[ "$show" == *"127.0.0.1:$SMTP_PORT (Stream)"* ]]
}

# relay_holds_port: whether what listens on 127.0.0.1 at the SMTP port, where apps send their logins, is
# systemd's socket for mroom's mail relay or the relay itself. Anyone on the box may take a free port;
# systemd holds this one from boot, as root, also while the relay restarts. While something holds
# 127.0.0.1:<port>, nothing else can listen where apps' mail arrives: not at every address, nor at a
# dual-stack ::, nor at ::ffff:127.0.0.1. A listener at 127.0.0.2 or a v6only :: never sees that mail.
relay_holds_port() {
  local port listener uid inode proc arg held=""
  port="$(printf '%04X' "$SMTP_PORT")"
  listener="$(awk -v at="0100007F:$port" -v any="00000000:$port" '$4 == "0A" && ($2 == at || $2 == any) {
      print $8, $10, ($2 == any ? "any" : "loopback"); exit }' /proc/net/tcp 2>/dev/null)" || true
  [ -n "$listener" ] || fail "nothing listens on 127.0.0.1:$SMTP_PORT; check mroom-mail-relay.socket (mroom baseline mailpit prints how to set it up)"
  read -r uid inode arg <<<"$listener"
  [ "$arg" = loopback ] || fail "something listens on every address at port $SMTP_PORT, so apps would send it their mail logins: stop it, check mroom-mail-relay.socket, then give each QA environment new logins"
  if [ "$uid" = 0 ]; then
    socket_unit_holds_port || fail "a root process other than mroom-mail-relay.socket listens on port $SMTP_PORT, so apps would send it their mail logins: stop it, check mroom-mail-relay.socket, then give each QA environment new logins"
    return 0
  fi
  for proc in /proc/[0-9]*; do
    [ -O "$proc" ] || continue
    # A process can end at any moment, and set -e would take that for the gate's own failure.
    while IFS= read -r -d '' arg; do
      if [ "$arg" = "$MAIL_RELAY" ]; then
        for arg in "$proc"/fd/*; do
          if [ "$(readlink "$arg" 2>/dev/null)" = "socket:[$inode]" ]; then held=1; break 3; fi
        done
        break
      fi
    done 2>/dev/null <"$proc/cmdline" || true
  done
  [ -n "$held" ] || fail "something other than mroom's mail relay listens on port $SMTP_PORT, so apps would send it their mail logins: stop it, check mroom-mail-relay.socket, then give each QA environment new logins"
}

# set_login <user> [<hash>]: rewrites the SMTP login file without the user's line, then with the new one if
# a hash is given. Returns 0 when it changed the file, 1 when nothing changed, and 2 when it could not write
# it, which leaves the file as it was. Every step is checked here: bash runs a function that is called from
# `if` or `||` without set -e.
set_login() {
  local want
  want="$(awk -F: -v user="$1" '$1 != user' "$MAILPIT_LOGINS")" || return 2
  if [ -n "${2-}" ]; then want+=$'\n'"$1:$2"; fi
  want="${want#$'\n'}"
  # The login no one knows keeps the file from being empty, which Mailpit takes as "no login needed".
  [[ "$want" == "mroom-none:"* || "$want" == *$'\n'"mroom-none:"* ]] || return 2
  [ "$want" != "$(cat "$MAILPIT_LOGINS")" ] || return 1
  LOGIN_TMP="$(mktemp "$(dirname "$MAILPIT_LOGINS")/.mailpit-smtp.XXXXXX")" || return 2
  if ! printf '%s\n' "$want" >"$LOGIN_TMP" || [ "$(cat "$LOGIN_TMP")" != "$want" ] \
    || ! mv -f "$LOGIN_TMP" "$MAILPIT_LOGINS"; then
    return 2
  fi
  LOGIN_TMP=""
}
login_unwritten() {
  if grep -q '^mroom-none:' "$MAILPIT_LOGINS"; then
    fail "could not write $(home_short "$MAILPIT_LOGINS"), which is unchanged; is the disk full?"
  fi
  fail "$(home_short "$MAILPIT_LOGINS") has lost its mroom-none line; run mroom baseline mailpit"
}

# mail_ids <user> [<address> [<max>]]: the IDs of the mail the user's login sent, newest first; with an
# address, only mail to it (To, Cc or Bcc) whose every recipient is a persona, and at most <max> of them. The
# tag only narrows the search: a mail counts only when its Username field, which only a login sets, is the
# user (D19).
mail_ids() {
  local query start=0 page ids found=0 domain="${BOX[MROOM_QA_PERSONA_DOMAIN]:-.test}"
  query="$(jq -rn --arg q "tag:\"$1\"" '$q | @uri')"
  while :; do
    page="$(mailpit_api GET "/api/v1/search?query=$query&start=$start&limit=500")" || return 1
    ids="$(jq -r --arg u "$1" --arg a "${2-}" --arg d "$domain" '.messages[] | select(.Username == $u)
      | select($a == "" or ([.To[]?, .Cc[]?, .Bcc[]? | (.Address // "") | ascii_downcase]
          | index($a) and all(test("\\A[a-z0-9._+-]+@[a-z0-9-]+(\\.[a-z0-9-]+)+\\z") and endswith($d))))
      | .ID | select(test("\\A[A-Za-z0-9_-]{1,64}\\z"))' <<<"$page")" || return 1
    if [ -n "$ids" ]; then
      printf '%s\n' "$ids"
      found=$((found + $(wc -l <<<"$ids")))
      if [ -n "${3-}" ] && [ "$found" -ge "$3" ]; then return 0; fi
    fi
    [ "$(jq '.messages | length' <<<"$page")" = 500 ] || return 0
    start=$((start + 500))
  done
}

cmd_mail_user_add() {
  words_are 2
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" password hash rc=0
  mail_ready
  env_lock mailpit  # one login file and one Mailpit for every environment
  password="$(new_password)"
  [ "${#password}" = 48 ] || fail "could not read random bytes for the password"
  hash="$(printf '%s' "$password" | openssl passwd -6 -stdin)" || fail "openssl could not hash the password"
  [[ "$hash" =~ ^\$6\$[A-Za-z0-9./]+\$[A-Za-z0-9./]+$ ]] || fail "openssl gave no SHA-512 crypt hash"
  [ -n "$(mailpit_pids)" ] || fail "Mailpit is not running; check mroom-mailpit.service (mroom baseline mailpit writes it)"
  relay_holds_port
  set_login "$user" "$hash" || rc=$?
  [ "$rc" != 2 ] || login_unwritten
  mailpit_restart
  gate_log "mail-user-add ${words[1]}: $user ready"
  printf 'MAIL_MAILER=smtp\nMAIL_HOST=127.0.0.1\nMAIL_PORT=%s\nMAIL_USERNAME=%s\nMAIL_PASSWORD=%s\n' \
    "$SMTP_PORT" "$user" "$password"
}

cmd_mail_user_remove() {
  words_are 2
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" rc=0
  mail_ready
  env_lock mailpit
  [ -n "$(mailpit_pids)" ] || fail "Mailpit is not running; check mroom-mailpit.service (mroom baseline mailpit writes it)"
  set_login "$user" || rc=$?
  [ "$rc" != 2 ] || login_unwritten
  if [ "$rc" = 0 ]; then mailpit_restart; fi
  gate_log "mail-user-remove ${words[1]}: $user removed"
  echo "mail user $user: removed"
}

cmd_mail_read() {
  words_are 3
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" address="${words[2]}" ids id found=() mail
  persona mail-read "$address"
  mail_ready
  env_lock mailpit  # not while a restart is under way
  ids="$(mail_ids "$user" "$address" 5)" || fail "mail-read ${words[1]}: $(mail_error)"
  for id in $ids; do
    mail="$(mailpit_api GET "/api/v1/message/$id")" || fail "mail-read ${words[1]}: $(mail_error)"
    found+=("$mail")
    [ "${#found[@]}" -lt 5 ] || break
  done
  gate_log "mail-read ${words[1]}: ${#found[@]} mails for $address"
  if [ "${#found[@]}" = 0 ]; then echo '[]'; return 0; fi
  printf '%s\n' "${found[@]}" | jq -s '[.[] | {id: .ID, date: .Date, from: .From.Address, to: [.To[]?.Address],
    subject: .Subject, text: ((.Text // "") | .[0:32768])}]'
}

cmd_mail_clear() {
  words_are 2
  env_number "${words[1]}"
  local user="${app}_qa_${words[1]}" text ids=() batch count
  mail_ready
  env_lock mailpit
  text="$(mail_ids "$user")" || fail "mail-clear ${words[1]}: $(mail_error)"
  [ -z "$text" ] || mapfile -t ids <<<"$text"
  count="${#ids[@]}"
  while [ "${#ids[@]}" -gt 0 ]; do
    batch="$(jq -nc '{IDs: $ARGS.positional}' --args "${ids[@]:0:500}")"
    # Mailpit deletes every mail, of every environment, when the list of IDs is empty or does not parse.
    [[ "$batch" =~ ^\{\"IDs\":\[\"[A-Za-z0-9_-]+\"(,\"[A-Za-z0-9_-]+\")*\]\}$ ]] \
      || fail "mail-clear ${words[1]}: refusing to send Mailpit a list of IDs that is not plain"
    mailpit_api DELETE /api/v1/messages "$batch" >/dev/null || fail "mail-clear ${words[1]}: $(mail_error)"
    ids=("${ids[@]:500}")
  done
  gate_log "mail-clear ${words[1]}: $count mails of $user deleted"
  echo "mail of $user: $count deleted"
}

GARAGE_HOME="$HOME/.local/share/mroom-services/garage"
# Garage listens only on Unix sockets in a folder only the box user can open (mroom baseline garage).
GARAGE_ADMIN="$GARAGE_HOME/run/admin.sock"
GARAGE_S3="$GARAGE_HOME/run/s3.sock"
GARAGE_TOKEN="$HOME/.config/mroom/secrets/garage-admin-token"
GARAGE_ERR="" DROP_KEY=""

garage_ready() {
  [ -r "$GARAGE_TOKEN" ] || fail "$(home_short "$GARAGE_TOKEN") is missing; run mroom baseline garage"
  secret_file_ok "$GARAGE_TOKEN" || fail "$(home_short "$GARAGE_TOKEN") must be yours and mode 600"
  need curl jq python3 flock
  [ -n "${BOX[MROOM_QA_ZONE]:-}" ] || fail "MROOM_QA_ZONE is not set in box.env"
  gate_tmp
  GARAGE_ERR="$GATE_TMP/garage.err"
}

# garage_api <method> <path> [<json>]: one call to Garage's admin API, as its admin token, which reaches curl
# on stdin, never a command line. Prints the body and returns 0 for a 2xx answer; for any other, writes
# "HTTP <code>" and Garage's message to $GARAGE_ERR and returns 1.
garage_api() {
  local args=(-q --silent --show-error --max-time 60 --unix-socket "$GARAGE_ADMIN" --request "$1" --header @-
    --output "$GATE_TMP/garage.body" --write-out '%{http_code}') code
  if [ -n "${3-}" ]; then args+=(--header "Content-Type: application/json" --data-binary "$3"); fi
  code="$(printf 'Authorization: Bearer %s\n' "$(tr -d '\r\n' <"$GARAGE_TOKEN")" | curl "${args[@]}" "http://localhost$2" 2>"$GARAGE_ERR")" || code=000
  if [[ "$code" == 2?? ]]; then cat "$GATE_TMP/garage.body"; return 0; fi
  printf 'HTTP %s %s\n' "$code" "$(jq -r '.message // empty' "$GATE_TMP/garage.body" 2>/dev/null | head -c 200)" >>"$GARAGE_ERR"
  return 1
}
garage_error() { printable "$(grep -m1 -E 'HTTP|curl' "$GARAGE_ERR" 2>/dev/null || echo "no message")"; }

# disk_name <word>: a file disk's name, as mroom.toml names it.
disk_name() { [[ "$1" =~ ^[a-z][a-z0-9]{0,15}$ ]] || refuse "$op: the disk's name is not [a-z][a-z0-9]{0,15}"; }
# bucket_of <N> <disk>: the environment's bucket for the disk, which is also its keys' name; with no disk,
# what every one of the environment's buckets starts with.
bucket_of() { printf '%s-qa-%s-%s\n' "${app//_/-}" "$1" "$2"; }
# A jq function: whether a name is <prefix><disk>, which, a disk's name having no -, is that prefix's alone.
# shellcheck disable=SC2016 # jq's own $p
GARAGE_OURS='def ours($p): startswith($p) and (.[($p | length):] | test("\\A[a-z][a-z0-9]{0,15}\\z"));'

# bucket_id <name>: the bucket's id, or nothing when there is no such bucket.
bucket_id() {
  local info
  if info="$(garage_api GET "/v2/GetBucketInfo?globalAlias=$1")"; then
    jq -r '.id' <<<"$info" | grep -E '^[0-9a-f]{64}$' || fail "Garage gave no id for the bucket $1"
  elif grep -q '^HTTP 404' "$GARAGE_ERR"; then
    return 0
  else
    fail "$op ${words[1]}: $(garage_error)"
  fi
}

# drop_keys <name>: deletes every key named <name>, and says how many.
drop_keys() {
  local keys id count=0
  keys="$(garage_api GET /v2/ListKeys)" || fail "$op ${words[1]}: $(garage_error)"
  for id in $(jq -r --arg n "$1" '.[] | select(.name == $n) | .id | select(test("\\AGK[0-9a-f]{24}\\z"))' <<<"$keys"); do
    garage_api POST "/v2/DeleteKey?id=$id" >/dev/null || fail "$op ${words[1]}: $(garage_error)"
    count=$((count + 1))
  done
  echo "$count"
}

# new_key <name> <bucket id> <read> <write>: a new key named <name>, allowed only on that bucket; prints its
# id and its secret, one per line.
new_key() {
  local made id secret
  made="$(garage_api POST /v2/CreateKey "$(jq -nc --arg n "$1" '{name: $n, neverExpires: true}')")" \
    || fail "$op ${words[1]}: $(garage_error)"
  id="$(jq -r '.accessKeyId' <<<"$made")" secret="$(jq -r '.secretAccessKey' <<<"$made")"
  [[ "$id" =~ ^GK[0-9a-f]{24}$ && "$secret" =~ ^[0-9a-f]{64}$ ]] || fail "Garage made no key for $1"
  garage_api POST /v2/AllowBucketKey "$(jq -nc --arg b "$2" --arg k "$id" --argjson r "$3" --argjson w "$4" \
    '{bucketId: $b, accessKeyId: $k, permissions: {read: $r, write: $w, owner: false}}')" >/dev/null \
    || { garage_api POST "/v2/DeleteKey?id=$id" >/dev/null 2>&1 || true; fail "$op ${words[1]}: $(garage_error)"; }
  printf '%s\n%s\n' "$id" "$secret"
}

cmd_bucket_create() {
  [ "${#words[@]}" = 3 ] || [ "${#words[@]}" = 4 ] || refuse "bucket-create takes 2 or 3 arguments, got $((${#words[@]} - 1))"
  env_number "${words[1]}"
  disk_name "${words[2]}"
  local public=false bucket id old key zone="${BOX[MROOM_QA_ZONE]:-}"
  if [ "${#words[@]}" = 4 ]; then
    [ "${words[3]}" = public ] || refuse "bucket-create: its third argument can only be public"
    public=true
  fi
  bucket="$(bucket_of "${words[1]}" "${words[2]}")"
  garage_ready
  env_lock garage
  id="$(bucket_id "$bucket")"
  if [ -z "$id" ]; then
    id="$(garage_api POST /v2/CreateBucket "$(jq -nc --arg a "$bucket" '{globalAlias: $a}')" | jq -r '.id')" \
      || fail "bucket-create ${words[1]}: $(garage_error)"
    [[ "$id" =~ ^[0-9a-f]{64}$ ]] || fail "Garage gave no id for the new bucket $bucket"
  fi
  # A new key every time: the old ones stop working, so a key left in an old .env reaches nothing.
  old="$(drop_keys "$bucket")"
  key="$(new_key "$bucket" "$id" true true)"
  garage_api POST "/v2/UpdateBucket?id=$id" "$(jq -nc --argjson on "$public" \
    '{websiteAccess: ({enabled: $on} + (if $on then {indexDocument: "index.html"} else {} end))}')" >/dev/null \
    || fail "bucket-create ${words[1]}: $(garage_error)"
  gate_log "bucket-create ${words[1]}: $bucket ready (website access $public, $old old keys deleted)"
  printf 'BUCKET=%s\nACCESS_KEY_ID=%s\nSECRET_ACCESS_KEY=%s\nREGION=garage\nENDPOINT=https://s3.%s\nPATH_STYLE=true\n' \
    "$bucket" "$(sed -n 1p <<<"$key")" "$(sed -n 2p <<<"$key")" "$zone"
  if [ "$public" = true ]; then printf 'URL=https://files.%s/%s\n' "$zone" "$bucket"; fi
}

cmd_bucket_drop() {
  words_are 2
  env_number "${words[1]}"
  local prefix buckets keys id bucket key count old=0 dropped=0
  prefix="$(bucket_of "${words[1]}" "")"
  garage_ready
  env_lock garage
  # Every bucket and key of the environment, found by name, whatever disks it has had: a disk the app no
  # longer has leaves nothing behind.
  buckets="$(garage_api GET /v2/ListBuckets)" || fail "bucket-drop ${words[1]}: $(garage_error)"
  keys="$(garage_api GET /v2/ListKeys)" || fail "bucket-drop ${words[1]}: $(garage_error)"
  # Its keys go first, so nothing writes while its buckets empty, and with them any key a killed drop left.
  for id in $(jq -r --arg p "$prefix" "$GARAGE_OURS"' .[] | select((.name // "") | ours($p) or ours("mroom-drop-" + $p))
      | .id | select(test("\\AGK[0-9a-f]{24}\\z"))' <<<"$keys"); do
    garage_api POST "/v2/DeleteKey?id=$id" >/dev/null || fail "bucket-drop ${words[1]}: $(garage_error)"
    old=$((old + 1))
  done
  while read -r id bucket <&3; do
    # Garage deletes only an empty bucket, and empties none itself: a key of the gate's own, for this
    # bucket alone, deletes its objects through the S3 API, and goes when the drop ends, whether it worked
    # or not (gate_cleanup); the next drop deletes one a killed gate left.
    key="$(new_key "mroom-drop-$bucket" "$id" true true)"
    DROP_KEY="$(sed -n 1p <<<"$key")"
    count="$(printf '%s\n' "$key" | python3 -I "$MROOM_ROOT/lib/s3-empty" "$GARAGE_S3" "$bucket" 2>"$GARAGE_ERR")" \
      || fail "bucket-drop ${words[1]}: $(printable "$(grep -m1 . "$GARAGE_ERR")")"
    garage_api POST /v2/CleanupIncompleteUploads "$(jq -nc --arg b "$id" '{bucketId: $b, olderThanSecs: 0}')" >/dev/null \
      || fail "bucket-drop ${words[1]}: $(garage_error)"
    garage_api POST "/v2/DeleteBucket?id=$id" >/dev/null || fail "bucket-drop ${words[1]}: $(garage_error)"
    garage_api POST "/v2/DeleteKey?id=$DROP_KEY" >/dev/null || fail "bucket-drop ${words[1]}: $(garage_error)"
    DROP_KEY=""
    gate_log "bucket-drop ${words[1]}: $bucket dropped ($count objects)"
    echo "bucket $bucket: dropped, $count objects deleted"
    dropped=$((dropped + 1))
  done 3< <(jq -r --arg p "$prefix" "$GARAGE_OURS"' .[] | select(.id | test("\\A[0-9a-f]{64}\\z"))
      | (.globalAliases | map(select(ours($p))) | first) as $a | select($a) | "\(.id) \($a)"' <<<"$buckets")
  gate_log "bucket-drop ${words[1]}: $dropped buckets dropped, $old keys deleted"
  if [ "$dropped" = 0 ]; then echo "environment ${words[1]} has no buckets, so nothing to drop"; fi
}

REVERB_BASE="$HOME/.local/share/mroom-services/reverb"
REVERB_APPS="$REVERB_BASE/apps/apps.json"

reverb_ready() {
  [ -f "$REVERB_APPS" ] || fail "$(home_short "$REVERB_APPS") is missing; run mroom baseline reverb"
  secret_file_ok "$REVERB_APPS" || fail "$(home_short "$REVERB_APPS") must be yours and mode 600"
  need jq curl flock
}

# reverb_put <jq argument...>: the apps file, changed by the jq filter and put in place whole, by renaming, so
# the Reverb host reads the old apps or the new ones, never half of either. Its folder, not the file, is what
# the host's unit binds, so the host sees the new file.
reverb_put() {
  local new="$REVERB_BASE/apps/.apps.json.new"
  if ! jq "$@" "$REVERB_APPS" >"$new" 2>/dev/null; then
    rm -f -- "$new"
    fail "$(home_short "$REVERB_APPS") could not be changed: it is not {\"apps\": [...]} in JSON"
  fi
  chmod 600 "$new"
  mv -f -- "$new" "$REVERB_APPS"
}

cmd_reverb_app_add() {
  words_are 2
  env_number "${words[1]}"
  local n="${words[1]}" id="${app}-qa-${words[1]}" zone secret
  reverb_ready
  zone="${BOX[MROOM_QA_ZONE]:-}"
  [ -n "$zone" ] || fail "MROOM_QA_ZONE is not set in box.env"
  env_lock reverb  # one apps file for every environment
  [ "$(curl -q -s --max-time 5 --unix-socket "$REVERB_BASE/run/reverb.sock" -o /dev/null -w '%{http_code}' \
    http://localhost/up 2>/dev/null)" = 200 ] \
    || fail "the Reverb host does not answer; check mroom-reverb.service (mroom baseline reverb sets it up)"
  secret="$(new_password)"
  [ "${#secret}" = 48 ] || fail "could not read random bytes for the secret"
  # Only the environment's two sites may open its sockets from a browser, at most 100 at once.
  # shellcheck disable=SC2016 # jq's own $id, $secret, $n and $zone
  reverb_put --arg id "$id" --arg secret "$secret" --arg n "$n" --arg zone "$zone" '
    .apps |= ((. // []) | map(select(.app_id != $id)) + [{
      app_id: $id, key: $id, secret: $secret,
      allowed_origins: ["api-\($n).\($zone)", "go-\($n).\($zone)"],
      ping_interval: 60, activity_timeout: 30, max_message_size: 10000, max_connections: 100,
      accept_client_events_from: "members"
    }])'
  gate_log "reverb-app-add $n: $id ready"
  printf 'REVERB_APP_ID=%s\nREVERB_APP_KEY=%s\nREVERB_APP_SECRET=%s\nREVERB_HOST=ws.%s\nREVERB_PORT=443\nREVERB_SCHEME=https\n' \
    "$id" "$id" "$secret" "$zone"
}

cmd_reverb_app_remove() {
  words_are 2
  env_number "${words[1]}"
  local id="${app}-qa-${words[1]}" had
  reverb_ready
  env_lock reverb
  had="$(jq --arg id "$id" '[.apps // [] | .[] | select(.app_id == $id)] | length' "$REVERB_APPS" 2>/dev/null)" \
    || fail "$(home_short "$REVERB_APPS") is not {\"apps\": [...]} in JSON"
  if [ "$had" = 0 ]; then
    gate_log "reverb-app-remove ${words[1]}: no app"
    echo "environment ${words[1]} has no Reverb app, so nothing to remove"
    return 0
  fi
  # shellcheck disable=SC2016 # jq's own $id
  reverb_put --arg id "$id" '.apps |= ((. // []) | map(select(.app_id != $id)))'
  gate_log "reverb-app-remove ${words[1]}: $id removed"
  echo "Reverb app $id: removed; its sockets already open stay until they close"
}

# The operation and its environment only: each operation logs what it did, and an argument it refuses, such
# as an address that is no persona's, never reaches the log.
first="${words[1]:-}"
[[ "$first" =~ ^[0-9]{1,12}$ ]] || first="(not a number)"
gate_log "request: $op $first"
case "$op" in
  db-create) cmd_db_create ;;
  db-drop) cmd_db_drop ;;
  redis-user-add) cmd_redis_user_add ;;
  redis-user-remove) cmd_redis_user_remove ;;
  redis-clear) cmd_redis_clear ;;
  code-put) cmd_code_put ;;
  dist-put) cmd_dist_put ;;
  env-put) cmd_env_put ;;
  env-sha) cmd_env_sha ;;
  signin-code) cmd_signin_code ;;
  user-clean) cmd_user_clean ;;
  mail-user-add) cmd_mail_user_add ;;
  mail-user-remove) cmd_mail_user_remove ;;
  mail-read) cmd_mail_read ;;
  mail-clear) cmd_mail_clear ;;
  bucket-create) cmd_bucket_create ;;
  bucket-drop) cmd_bucket_drop ;;
  reverb-app-add) cmd_reverb_app_add ;;
  reverb-app-remove) cmd_reverb_app_remove ;;
esac
