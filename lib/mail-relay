#!/usr/bin/env python3
"""mail-relay: pipes QA apps' mail to Mailpit, on a port no one else can take (design D19).

    mail-relay <host> <port> <socket>

Apps send mail to <host>:<port>, and the relay pipes each connection to Mailpit's SMTP Unix socket.
Mailpit listens only on Unix sockets in a folder only the box user can open, and the gate restarts it
whenever it adds or removes a login. Any user on the box may take a free TCP port, and with it the logins
apps send, so systemd holds this one: mroom-mail-relay.socket listens on it from boot, as root, and hands
it to the relay, which runs as the box user. The port stays held while the relay restarts. Started without
a socket from systemd, as in tests, the relay listens itself, and stops if the port is taken.

A connection ends when Mailpit's side does, after QUIT or when Mailpit drops an idle client, or when the
client's side fails, and lasts at most MAIL_RELAY_MAX_SECONDS (1800). At most MAIL_RELAY_MAX_CONNECTIONS
(256) run at once, and at most MAIL_RELAY_MAX_PER_USER (32) from one Linux user, the owner of the client's
socket, so one QA site cannot take every place; the next is closed at once.

mroom baseline mailpit copies this file beside the services and writes the systemd units that run it.
"""

import asyncio
import os
import socket
import sys

CHUNK = 65536
CONNECT_SECONDS = 5


def setting(name: str, default: int) -> int:
    value = os.environ.get(name, "")
    return int(value) if value.isascii() and value.isdigit() and int(value) > 0 else default


MAX_CONNECTIONS = setting("MAIL_RELAY_MAX_CONNECTIONS", 256)
MAX_PER_USER = setting("MAIL_RELAY_MAX_PER_USER", 32)
MAX_SECONDS = setting("MAIL_RELAY_MAX_SECONDS", 1800)


async def pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> bool:
    """Copies one direction until its end, then ends that direction on the other side too. False when the
    direction failed instead of ending."""
    try:
        while data := await reader.read(CHUNK):
            writer.write(data)
            await writer.drain()
        if writer.can_write_eof():
            writer.write_eof()
        return True
    except OSError:
        return False


async def session(socket_path: str, client_reader: asyncio.StreamReader,
                  client_writer: asyncio.StreamWriter) -> None:
    mailpit_reader, mailpit_writer = await asyncio.wait_for(
        asyncio.open_unix_connection(socket_path), CONNECT_SECONDS)
    to_mailpit = asyncio.ensure_future(pipe(client_reader, mailpit_writer))
    to_client = asyncio.ensure_future(pipe(mailpit_reader, client_writer))
    try:
        # The session is over when Mailpit's side ends, whatever the client still holds open, or when the
        # client's side fails (a reset), which Mailpit would otherwise wait minutes to notice.
        done, _ = await asyncio.wait({to_mailpit, to_client}, return_when=asyncio.FIRST_COMPLETED)
        if to_client not in done and to_mailpit.result():
            await to_client
    finally:
        to_mailpit.cancel()
        to_client.cancel()
        mailpit_writer.close()


def tcp_hex(address: tuple) -> str:
    """An IPv4 address and port as /proc/net/tcp writes them."""
    packed = int.from_bytes(socket.inet_aton(address[0]), sys.byteorder)
    return f"{packed:08X}:{address[1]:04X}"


def peer_user(writer: asyncio.StreamWriter):
    """The owner of the client's socket, from /proc/net/tcp: the user its app runs as. None when unknown."""
    peer, local = writer.get_extra_info("peername"), writer.get_extra_info("sockname")
    try:
        want = (tcp_hex(peer), tcp_hex(local))
        with open("/proc/net/tcp", encoding="ascii") as table:
            next(table)
            for line in table:
                fields = line.split()
                if (fields[1], fields[2]) == want:
                    return int(fields[7])
    except (OSError, ValueError, TypeError, IndexError, StopIteration):
        pass
    return None


class Relay:
    def __init__(self, socket_path: str) -> None:
        self.socket_path = socket_path
        self.open = 0
        self.by_user: dict = {}

    async def handle(self, client_reader: asyncio.StreamReader, client_writer: asyncio.StreamWriter) -> None:
        user = peer_user(client_writer)
        if self.open >= MAX_CONNECTIONS or self.by_user.get(user, 0) >= MAX_PER_USER:
            client_writer.close()
            return
        self.open += 1
        self.by_user[user] = self.by_user.get(user, 0) + 1
        try:
            await asyncio.wait_for(session(self.socket_path, client_reader, client_writer), MAX_SECONDS)
        except (OSError, asyncio.TimeoutError):
            pass
        finally:
            self.open -= 1
            self.by_user[user] -= 1
            if not self.by_user[user]:
                del self.by_user[user]
            client_writer.close()


def listening_socket(host: str, port: int) -> socket.socket:
    """The socket systemd passed (sd_listen_fds: one socket, as fd 3), or one of the relay's own."""
    if os.environ.get("LISTEN_PID") == str(os.getpid()) and os.environ.get("LISTEN_FDS") == "1":
        sock = socket.socket(fileno=3)
        listening = sock.type == socket.SOCK_STREAM and sock.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN)
        if not listening or sock.getsockname()[:2] != (host, port):
            raise SystemExit(f"mail-relay: systemd passed a socket that is not listening on {host}:{port}")
        return sock
    try:
        return socket.create_server((host, port))
    except OSError as error:
        raise SystemExit(f"mail-relay: cannot listen on {host}:{port}: {error.strerror}") from None


async def serve(host: str, port: int, socket_path: str) -> None:
    relay = Relay(socket_path)
    server = await asyncio.start_server(relay.handle, sock=listening_socket(host, port))
    async with server:
        await server.serve_forever()


def main(argv: list[str]) -> int:
    if len(argv) != 3 or not (argv[1].isascii() and argv[1].isdigit()):
        print("usage: mail-relay <host> <port> <socket>", file=sys.stderr)
        return 2
    asyncio.run(serve(argv[0], int(argv[1]), argv[2]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
