#!/usr/bin/python3 -I
"""site-op: the gate's work inside a QA site, run as the site's own user (design 8.2, D17).

`mroom gate` runs it with `sudo -n -u <app>_qa_<N>`. A person installs a root-owned copy at
/usr/local/libexec/mroom/site-op, and one sudoers line lets the box user run it as any isolated user:

  forge ALL=(%isolated) NOPASSWD: /usr/local/libexec/mroom/site-op

  site-op unpack code <domain> <backend_dir> <commit>        the PR's tree: GitHub's tarball, on stdin
  site-op unpack dist <domain>                               the frontend's built files: a tarball, on stdin
  site-op env-sha <domain> <backend_dir>                     the SHA-256 of the site's .env, or "missing"
  site-op signin-code <domain> <backend_dir> <php> <email>   a sign-in code from the app, for a persona
  site-op clean                                              stops this user's processes, deletes its files
                                                             in /tmp, /var/tmp and /dev/shm

It works only in the home of the user it runs as, which can reach nothing the PR's own code cannot, so the
gate never unpacks a tarball, follows a PR's links or runs its code as the box user. A tarball is unpacked
with tarfile's data filter: no absolute path, no `..`, no link leading out of the tree, no device file, no
setuid bit. A code tree replaces the site's whole tree except the backend's .env and storage/; any .env in
the tarball is skipped, and a link at .env, storage or bootstrap/cache refuses the whole tarball.
Messages go to stderr; the gate shows the first line.
"""

from __future__ import annotations

import grp
import hashlib
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import tempfile
import time

# Through sudo, the passwd file gives the home and no setting comes from the environment. Run directly
# (the tests), $HOME is the home and MROOM_SITE_OP_* may lower the limits.
UNDER_SUDO = "SUDO_UID" in os.environ


def limit(name: str, default: int) -> int:
    value = "" if UNDER_SUDO else os.environ.get(f"MROOM_SITE_OP_{name}", "")
    return int(value) if value.isdigit() else default


MAX_TARBALL = limit("MAX_TARBALL", 1 << 30)       # bytes as sent
MAX_UNPACKED = limit("MAX_UNPACKED", 8 << 30)     # bytes of all files unpacked
MAX_MEMBERS = limit("MAX_MEMBERS", 500_000)
SIGNIN_TIMEOUT = limit("SIGNIN_TIMEOUT", 120)     # seconds

DOMAIN = re.compile(r"(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+")
REPO_DIR = re.compile(r"\.|(?=.{1,200}$)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*")
COMMIT = re.compile(r"[0-9a-f]{40}")
SHORT_COMMIT = re.compile(r"[0-9a-f]{7,40}")
PHP = re.compile(r"php(?:[0-9]+(?:\.[0-9]+)?)?")
EMAIL = re.compile(r"[a-z0-9._+-]+@[a-z0-9-]+(?:\.[a-z0-9-]+)+")
CODE = re.compile(r"[A-Za-z0-9-]{4,64}")
QA_USER = re.compile(r"[a-z][a-z0-9_]*_qa_[1-9][0-9]{0,8}")
SAFE_PATH = "/usr/local/bin:/usr/bin:/bin"


class Refused(Exception):
    pass


def home() -> str:
    return pwd.getpwuid(os.getuid()).pw_dir if UNDER_SUDO else os.environ["HOME"]


def site_root(domain: str) -> str:
    """The site's folder in this user's home, which must be a real folder of this user's own."""
    if not DOMAIN.fullmatch(domain):
        raise Refused(f"'{domain[:60]}' is not a site's domain")
    root = os.path.join(home(), domain)
    try:
        st = os.lstat(root)
    except FileNotFoundError:
        raise Refused(f"there is no site folder {domain}; create the site first") from None
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise Refused(f"{domain} is not a folder of this user's own")
    return root


def backend_dir(value: str) -> str:
    if not REPO_DIR.fullmatch(value):
        raise Refused(f"'{value[:60]}' is not a folder inside the repository")
    return value


def tree_path(backend: str, *parts: str) -> str:
    """A path inside the tree, under the backend folder ('.' is the root)."""
    return os.path.normpath(os.path.join(backend, *parts))


def prefixes(path: str) -> list[str]:
    """The path and each folder above it: a/b/c gives a, a/b and a/b/c."""
    parts = path.split("/")
    return ["/".join(parts[:i]) for i in range(1, len(parts) + 1)]


def through_link(root: str, path: str) -> bool:
    """Whether the path, or a folder on the way to it, is a link."""
    return any(os.path.islink(os.path.join(root, p)) for p in prefixes(path))


def make_removable(path: str) -> None:
    """Gives this user rwx on every folder below path, so a tarball's read-only folder can still go."""
    os.chmod(path, stat.S_IMODE(os.lstat(path).st_mode) | 0o700)
    for top, dirs, _files in os.walk(path):
        for name in dirs:
            sub = os.path.join(top, name)
            st = os.lstat(sub)
            if stat.S_ISDIR(st.st_mode):  # os.walk lists a link to a folder here too
                os.chmod(sub, stat.S_IMODE(st.st_mode) | 0o700)


def remove(path: str) -> None:
    """Removes a file, a link or a whole folder, never following a link."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return
    if stat.S_ISDIR(st.st_mode):
        make_removable(path)
        shutil.rmtree(path)
    else:
        os.unlink(path)


def kept(backend: str) -> list[str]:
    """What a code put carries from the live tree into the new one."""
    return [tree_path(backend, ".env"), tree_path(backend, "storage")]


def recover(root: str, backend: str | None) -> None:
    """Undoes what an interrupted put left: puts back the kept items its new tree holds, then removes its
    scratch folders and upload."""
    for name in sorted(os.listdir(root)):
        if not name.startswith(".mroom-"):
            continue
        path = os.path.join(root, name)
        if name.startswith(".mroom-new-") and backend is not None and os.path.isdir(path):
            for keep in kept(backend):
                src, dst = os.path.join(path, keep), os.path.join(root, keep)
                if os.path.lexists(src) and not through_link(path, keep) and not os.path.lexists(dst):
                    if not through_link(root, os.path.dirname(keep) or "."):
                        os.makedirs(os.path.dirname(dst), exist_ok=True)
                        os.rename(src, dst)
        remove(path)


def read_upload(root: str) -> str:
    """stdin, at most MAX_TARBALL bytes, into a file of this user's own inside the site."""
    fd, path = tempfile.mkstemp(dir=root, prefix=".mroom-upload-")
    size = 0
    with os.fdopen(fd, "wb") as out:
        while chunk := sys.stdin.buffer.read(1 << 20):
            size += len(chunk)
            if size > MAX_TARBALL:
                raise Refused(f"the tarball is larger than {MAX_TARBALL} bytes")
            out.write(chunk)
    if size == 0:
        raise Refused("no tarball came on stdin")
    return path


def plan(tf: tarfile.TarFile, kind: str, commit: str | None, backend: str | None) -> tuple[dict, int]:
    """The members to unpack, each with its name inside the tree, and how many .env files are skipped. Any
    member that could reach outside the tree, or put a link where the site keeps something, refuses the
    whole tarball before anything is written."""
    top = None
    protected = set()
    if kind == "code":
        for path in (".env", "storage", "bootstrap/cache"):
            protected.update(prefixes(tree_path(backend, path)))

    def inside(name: str) -> str:
        if kind == "code":
            return name[len(top) + 1:] if top and name.startswith(top + "/") else ""
        return "" if name == "." else name.removeprefix("./")

    renamed, skipped, unpacked, seen_backend = {}, 0, 0, backend in (None, ".")
    # Headers one at a time, so a huge entry is refused before its data is decompressed.
    for count, m in enumerate(tf, 1):
        if count > MAX_MEMBERS:
            raise Refused(f"the tarball holds more than {MAX_MEMBERS} entries")
        if kind == "code":
            first = m.name.split("/", 1)[0]
            if top is None:
                top, short = first, first.rsplit("-", 1)[-1]
                if not (SHORT_COMMIT.fullmatch(short) and commit.startswith(short)):
                    raise Refused(f"the tarball's folder {top[:80]} is not of commit {commit[:12]}")
            elif first != top:
                raise Refused("the tarball must hold one folder, as GitHub's does")
        name = inside(m.name)
        if not name:
            continue
        parts = name.split("/")
        if name.startswith("/") or "" in parts or "." in parts or ".." in parts:
            raise Refused(f"the entry {name[:80]!r} is not a plain path inside the tree")
        if parts[0].startswith(".mroom-"):
            raise Refused(f"{name[:80]}: names starting with .mroom- are the gate's own")
        if parts[-1] == ".env":
            skipped += 1
            continue
        if not (m.isfile() or m.isdir() or m.issym() or m.islnk()):
            raise Refused(f"{name[:80]} is not a file, folder or link")
        if (m.issym() or m.islnk()) and name in protected:
            raise Refused(f"{name[:80]} may not be a link")
        if m.isfile():
            unpacked += m.size
            if unpacked > MAX_UNPACKED:
                raise Refused(f"the tarball unpacks to more than {MAX_UNPACKED} bytes")
        seen_backend = seen_backend or name == backend or name.startswith(f"{backend}/")
        changes = {"name": name}
        if m.islnk():  # a hard link names another entry of the tarball
            changes["linkname"] = inside(m.linkname)
            if not changes["linkname"]:
                raise Refused(f"{name[:80]} links to something outside the tree")
        renamed[id(m)] = (m, changes)
    if not renamed:
        raise Refused("the tarball holds nothing to unpack")
    if not seen_backend:
        raise Refused(f"the tarball has no {backend}/ folder; check MROOM_QA_BACKEND_DIR")
    return renamed, skipped


def unpack(kind: str, domain: str, backend: str | None, commit: str | None) -> None:
    root = site_root(domain)
    if kind == "code":
        backend = backend_dir(backend)
        if not COMMIT.fullmatch(commit):
            raise Refused(f"'{commit[:40]}' is not a commit")
    recover(root, backend)
    upload = read_upload(root)
    staging = tempfile.mkdtemp(dir=root, prefix=".mroom-new-")
    started, note = False, ""
    try:
        with tarfile.open(upload, "r:*") as tf:
            renamed, skipped = plan(tf, kind, commit, backend)

            def data(member: tarfile.TarInfo, dest: str) -> tarfile.TarInfo:
                original, changes = renamed[id(member)]
                return tarfile.data_filter(original.replace(**changes, deep=False), dest)

            try:
                tf.extractall(staging, members=[m for m, _ in renamed.values()], filter=data)
            except tarfile.FilterError as e:
                raise Refused(f"refused: {e}") from None
        make_removable(staging)
        dropped = []
        if kind == "code":
            version = os.path.join(staging, tree_path(backend, "version.json"))
            remove(version)
            with open(version, "x") as out:
                out.write(json.dumps({"release": None, "commit": commit}) + "\n")
            for keep in kept(backend):
                remove(os.path.join(staging, keep))
        # From here the new tree takes the live .env and storage: if anything fails, it stays for the
        # next put's recover() rather than being removed with them.
        started = True
        if kind == "code":
            for keep in kept(backend):
                if not os.path.lexists(os.path.join(root, keep)):
                    continue
                if through_link(root, keep):
                    dropped.append(keep)
                    continue
                os.makedirs(os.path.dirname(os.path.join(staging, keep)), exist_ok=True)
                os.rename(os.path.join(root, keep), os.path.join(staging, keep))
        note = swap(root, staging)
        remove(staging)
    finally:
        if not started:
            remove(staging)
        remove(upload)
    files = sum(1 for m, _ in renamed.values() if not m.isdir())
    print(f"{domain}: {files} entries unpacked, {skipped} .env skipped"
          + (f", a link at {' and '.join(dropped)} not kept" if dropped else "") + note)


def swap(root: str, staging: str) -> str:
    """Moves the live tree aside and the new one in, inside the site's own folder, which keeps its own
    permissions, then removes the old tree. Returns a note when that last removal failed: the next put
    removes it."""
    old = tempfile.mkdtemp(dir=root, prefix=".mroom-old-")
    for name in os.listdir(root):
        if not name.startswith(".mroom-"):
            os.rename(os.path.join(root, name), os.path.join(old, name))
    for name in os.listdir(staging):
        os.rename(os.path.join(staging, name), os.path.join(root, name))
    try:
        remove(old)
    except OSError as e:
        return f" (the old tree stays until the next put: {e.strerror})"
    return ""


def env_sha(domain: str, backend: str) -> None:
    """The SHA-256 of the backend's .env without its trailing newlines, or "missing" when it is not a
    plain file reached through no link. Never its content."""
    root, env = site_root(domain), tree_path(backend_dir(backend), ".env")
    path = os.path.join(root, env)
    if through_link(root, env) or not os.path.isfile(path):
        print("missing")
        return
    with open(path, "rb") as f:
        print(hashlib.sha256(f.read().rstrip(b"\n")).hexdigest())


def signin_code(domain: str, backend: str, php: str, email: str) -> None:
    """A persona's sign-in code from the app: the qa-signin hook if the tree has one, else
    `php artisan mroom:signin-code <email>` (design 6, 9)."""
    root, backend = site_root(domain), backend_dir(backend)
    if not PHP.fullmatch(php):
        raise Refused(f"'{php[:40]}' is not a PHP binary's name")
    if not EMAIL.fullmatch(email):
        raise Refused("not an email address")
    hook = os.path.join(root, ".mroom", "hooks", "qa-signin")
    if not through_link(root, ".mroom/hooks/qa-signin") and os.path.isfile(hook) and os.access(hook, os.X_OK):
        argv, cwd = [hook], root
    elif not through_link(root, tree_path(backend, "artisan")) and os.path.isfile(os.path.join(root, backend, "artisan")):
        argv, cwd = [php, "artisan", "mroom:signin-code", email], os.path.join(root, backend)
    else:
        raise Refused("the tree has neither .mroom/hooks/qa-signin nor artisan")
    env = {"PATH": SAFE_PATH, "HOME": home(), "LANG": "C.UTF-8", "MROOM_QA_EMAIL": email}
    try:
        done = subprocess.run(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=SIGNIN_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise Refused(f"the app gave no code within {SIGNIN_TIMEOUT} seconds") from None
    lines = [line.strip() for line in done.stdout[-65536:].decode("utf-8", "replace").splitlines() if line.strip()]
    if done.returncode != 0 or not lines or not CODE.fullmatch(lines[-1]):
        raise Refused(f"the app gave no code (exit {done.returncode})")
    print(lines[-1])


def own_processes() -> list[int]:
    """This user's other live processes."""
    me, uid, pids = os.getpid(), os.getuid(), []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == me:
            continue
        try:
            with open(f"/proc/{entry}/status") as f:
                fields = dict(line.split(":", 1) for line in f if ":" in line)
        except OSError:
            continue
        uids = fields.get("Uid", "").split()
        if len(uids) >= 2 and uid in (int(uids[0]), int(uids[1])) and not fields.get("State", "").strip().startswith("Z"):
            pids.append(int(entry))
    return pids


def clean() -> None:
    """Before qa-down deletes a site: stops its user's processes and deletes the user's files in the
    folders anyone may write, since the next site user can be given the same UID (design 8.9). A user may
    kill its own processes and delete its own files, so this needs no root."""
    user = pwd.getpwuid(os.getuid())
    groups = set()
    for gid in os.getgrouplist(user.pw_name, user.pw_gid):
        try:
            groups.add(grp.getgrgid(gid).gr_name)
        except KeyError:
            pass
    if not QA_USER.fullmatch(user.pw_name) or user.pw_uid < 1000 or "isolated" not in groups:
        raise Refused(f"{user.pw_name} is not a QA site's isolated user")
    stopped = len(own_processes())
    for _ in range(20):
        if not own_processes():
            break
        try:
            os.kill(-1, signal.SIGKILL)  # every process of this user but this one
        except ProcessLookupError:
            pass
        time.sleep(0.25)
    if own_processes():
        raise Refused(f"{len(own_processes())} processes of {user.pw_name} kept running")
    removed = 0
    for base in ("/tmp", "/var/tmp", "/dev/shm"):
        try:
            device = os.lstat(base).st_dev
        except OSError:
            continue
        for top, dirs, _files in os.walk(base):  # first open up this user's own folders
            for name in dirs:
                path = os.path.join(top, name)
                try:
                    st = os.lstat(path)
                    if st.st_uid == user.pw_uid and stat.S_ISDIR(st.st_mode):
                        os.chmod(path, stat.S_IMODE(st.st_mode) | 0o700)
                except OSError:
                    pass
        for top, dirs, files in os.walk(base, topdown=False):
            for name in files + dirs:
                path = os.path.join(top, name)
                try:
                    st = os.lstat(path)
                    if st.st_uid != user.pw_uid or st.st_dev != device:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        os.rmdir(path)
                    else:
                        os.unlink(path)
                    removed += 1
                except OSError:
                    pass
    try:
        crontab = subprocess.run(["crontab", "-r"], env={"PATH": SAFE_PATH}, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        crontab = False
    print(f"{user.pw_name}: {stopped} processes stopped, {removed} files removed outside its home"
          + (", its crontab removed" if crontab else ""))


USAGE = ("usage: site-op unpack code <domain> <backend_dir> <commit> | unpack dist <domain> | "
         "env-sha <domain> <backend_dir> | signin-code <domain> <backend_dir> <php> <email> | clean")


def main(argv: list[str]) -> int:
    os.umask(0o022)
    try:
        if len(argv) == 5 and argv[:2] == ["unpack", "code"]:
            unpack("code", argv[2], argv[3], argv[4])
        elif len(argv) == 3 and argv[:2] == ["unpack", "dist"]:
            unpack("dist", argv[2], None, None)
        elif len(argv) == 3 and argv[0] == "env-sha":
            env_sha(argv[1], argv[2])
        elif len(argv) == 5 and argv[0] == "signin-code":
            signin_code(argv[1], argv[2], argv[3], argv[4])
        elif argv == ["clean"]:
            clean()
        else:
            raise Refused(USAGE)
    except Refused as e:
        print(f"site-op: {e}", file=sys.stderr)
        return 1
    except (OSError, tarfile.TarError, EOFError) as e:
        print(f"site-op: {type(e).__name__}: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
