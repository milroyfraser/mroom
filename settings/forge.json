{
  "permissions": {
    "allow": [
      "Bash(forge-api GET:*)"
    ],
    "ask": [
      "Bash(forge-api --secret:*)"
    ],
    "deny": [
      "Bash(forge:*)",
      "Bash(cat ~/.forge-token)",
      "Read(~/.forge-token)",
      "Read(~/.laravel-forge/**)",
      "Read(~/.config/forge/**)"
    ]
  }
}
