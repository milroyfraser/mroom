#!/usr/bin/env bash
# forge-api — the Laravel Forge v2 API of this box, for agents and people (design section 7).
#
#   forge-api GET sites
#   forge-api GET sites/123/nginx
#   forge-api PUT sites/123/nginx --write --data '{"config":"..."}'
#   jq -n '{...}' | forge-api POST sites/123/domains --write --data -
#   forge-api --secret GET sites/123/environment
#
# Every call goes to this box's server (MROOM_FORGE_ORG and MROOM_FORGE_SERVER), and a path is relative to
# it: plain words joined by /, starting with a resource name such as sites, with no empty, "." or ".."
# part and no percent-encoding, plus an optional query of plain values. Anything else is refused before
# Forge is called. POST, PUT, PATCH and DELETE need --write. A path that returns secrets (a site's env, a
# package registry's credentials, a deploy hook, webhook or heartbeat URL, a command's output) needs
# --secret. The two flags mark a call so that a permission rule allowing plain reads never matches it and
# the call asks first. The token comes from ~/.config/mroom/secrets/forge-token (mode 600) and is never
# printed. --data - reads the body from stdin: use it for a body with secrets in it, since an inline --data
# shows in the process list.
#
# Exit codes: 0 done, 1 Forge or the client failed, 2 refused before calling Forge.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
MROOM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
export MROOM_ROOT
# shellcheck source=lib/core/util.sh
. "$MROOM_ROOT/lib/core/util.sh"
# shellcheck source=lib/core/forge.sh
. "$MROOM_ROOT/lib/core/forge.sh"
FORGE_NAME=forge-api

refuse() { echo "forge-api: $*" >&2; exit 2; }
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; }

case "${1:-}" in -h | --help) usage; exit 0 ;; esac
secret=0
if [ "${1:-}" = --secret ]; then secret=1; shift; fi
[ "$#" -ge 2 ] || refuse "usage: forge-api [--secret] <GET|POST|PUT|PATCH|DELETE> <path> [--write] [--data JSON|-]"
method="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
path="$2"
shift 2

write=0 data="" has_data=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --write) write=1; shift ;;
    --data)
      [ "$#" -ge 2 ] || refuse "--data needs JSON, or - to read it from stdin"
      if [ "$2" = - ]; then data="$(cat)"; else data="$2"; fi
      has_data=1
      shift 2
      ;;
    *) refuse "unknown argument: $1" ;;
  esac
done

case "$method" in
  GET) [ "$has_data" = 0 ] || refuse "a GET takes no --data" ;;
  POST | PUT | PATCH | DELETE) [ "$write" = 1 ] || refuse "$method changes Forge and needs --write (an agent asks the user first)" ;;
  *) refuse "unsupported method $method" ;;
esac

# The path stays under the pinned server. Laravel decodes percent-encoding before it routes, so
# %65nvironment would be "environment": no % in the path part at all. curl drops "." parts, so "." or ""
# would reach the server itself (DELETE . would ask Forge to delete it): a resource name comes first.
path="${path#/}"
part="${path%%\?*}" query=""
case "$path" in *\?*) query="${path#*\?}" ;; esac
[[ "$part" =~ ^[a-z][a-z0-9-]*(/[A-Za-z0-9_.~,-]+)*$ ]] || refuse "the path must stay under this box's server, for example sites/123"
case "/$part/" in
  */./* | */../* | /orgs/* | /servers/*) refuse "the path must stay under this box's server, for example sites/123" ;;
esac
# Inside a bracket expression a backslash is literal, so "]" goes first and "-" last instead of escaping.
plain_query='^[]A-Za-z0-9._~,=&%[-]*$'
[[ "$query" =~ $plain_query ]] || refuse "the query has characters a Forge query never needs: $query"

lower="$(printf '%s' "$part" | tr '[:upper:]' '[:lower:]')"
case "$lower" in
  env | */env | env/* | */env/* | *environment* | *credentials* | *deploy-hook* | *webhooks* | *heartbeats* \
    | */output | */output/*)
    [ "$secret" = 1 ] || refuse "$path returns secrets; run it as: forge-api --secret $method $path" ;;
esac

need curl jq
if [ "$has_data" = 1 ] && ! jq -e . >/dev/null 2>&1 <<<"$data"; then refuse "--data is not valid JSON"; fi

# forge runs in this shell, not in $(...), so these traps see its folder and remove it however the call
# ends: an interrupted call must not leave a body or an answer on disk.
trap forge_cleanup EXIT
trap 'forge_cleanup; exit 129' HUP
trap 'forge_cleanup; exit 130' INT
trap 'forge_cleanup; exit 143' TERM
forge "$method" "/$path" "$data" || exit 1
echo
