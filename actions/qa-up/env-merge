#!/usr/bin/env python3
"""env-merge <mroom's values> — the environment's .env, on stdout (actions/qa-up/up.sh): the shared template on
stdin, less every entry whose key mroom sets, then mroom's own KEY=value lines from the file.

It reads the template entry by entry, as Laravel's dotenv does, not line by line: a value in double or single
quotes may run over several lines, and a line inside it that looks like KEY=value is part of that value, never an
entry of its own. Comments and blank lines stay where they are. An entry is KEY=value, or export KEY=value.
"""

from __future__ import annotations

import re
import sys

ENTRY = re.compile(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=\s*(.*)\Z", re.S)


def closes(text: str, quote: str) -> bool:
    """Whether the quoted value that text continues ends in it: an unescaped quote, for double quotes."""
    i = 0
    while i < len(text):
        if quote == '"' and text[i] == "\\":
            i += 2
            continue
        if text[i] == quote:
            return True
        i += 1
    return False


def entries(template: str) -> list[tuple[str | None, str]]:
    """Each entry of the template as (its key, its text), and each other line as (None, the line)."""
    lines = template.split("\n")
    out: list[tuple[str | None, str]] = []
    i = 0
    while i < len(lines):
        match = ENTRY.match(lines[i])
        if not match:
            out.append((None, lines[i]))
            i += 1
            continue
        key, rest, text = match.group(1), match.group(2), [lines[i]]
        if rest[:1] in ('"', "'"):
            body = rest[1:]
            while not closes(body, rest[0]) and i + 1 < len(lines):
                i += 1
                text.append(lines[i])
                body += "\n" + lines[i]
        out.append((key, "\n".join(text)))
        i += 1
    return out


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: env-merge <mroom's values> < template", file=sys.stderr)
        return 2
    with open(argv[0]) as f:
        values = f.read()
    ours = {line.split("=", 1)[0] for line in values.splitlines() if "=" in line}
    kept = [text for key, text in entries(sys.stdin.read()) if key not in ours]
    while kept and kept[-1] == "":
        kept.pop()
    sys.stdout.write("".join(text + "\n" for text in kept) + values)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
